---
/**
 * ConfusionMatrix component for visualizing binary classification results
 *
 * @param matrix - ConfusionMatrix object with TP, TN, FP, FN counts
 * @param showLabels - Whether to show axis labels (default: true)
 */
import type { ConfusionMatrix as ConfusionMatrixType } from '@src-types/training';

export interface Props {
  matrix: ConfusionMatrixType;
  showLabels?: boolean;
}

const { matrix, showLabels = true } = Astro.props;

// Calculate total and percentages
const total =
  matrix.true_positives + matrix.true_negatives + matrix.false_positives + matrix.false_negatives;

/**
 * Calculates percentage of a value relative to the total count.
 * @param value - Individual count value
 * @returns Formatted percentage string
 */
function getPercentage(value: number): string {
  if (total === 0) return '0.0';
  return ((value / total) * 100).toFixed(1);
}

/**
 * Determines cell color intensity based on its contribution to the total.
 * @param value - Cell count value
 * @param isCorrect - Whether this cell represents a correct prediction
 * @returns DaisyUI background and text color classes
 */
function getCellColor(value: number, isCorrect: boolean): string {
  if (total === 0) return 'bg-base-300';

  const percentage = (value / total) * 100;

  if (isCorrect) {
    // Green shades for correct predictions (TP, TN)
    if (percentage >= 40) return 'bg-success text-success-content';
    if (percentage >= 20) return 'bg-success/70 text-success-content';
    if (percentage >= 10) return 'bg-success/50';
    return 'bg-success/30';
  } else {
    // Red shades for incorrect predictions (FP, FN)
    if (percentage >= 40) return 'bg-error text-error-content';
    if (percentage >= 20) return 'bg-error/70 text-error-content';
    if (percentage >= 10) return 'bg-error/50';
    return 'bg-error/30';
  }
}
---

<div class="card bg-base-200 shadow-md">
  <div class="card-body">
    <h3 class="card-title text-lg mb-4">Confusion Matrix</h3>

    <div class="overflow-x-auto">
      <div class="inline-block min-w-full">
        <!-- Matrix Grid -->
        <div class="grid grid-cols-[auto_1fr_1fr] gap-2">
          <!-- Top left corner (empty) -->
          <div></div>

          <!-- Column headers: Predicted -->
          {
            showLabels && (
              <>
                <div class="text-center font-semibold text-sm pb-2 border-b-2 border-base-content/20">
                  <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
                    Predicted
                  </div>
                  <div>Agree</div>
                </div>
                <div class="text-center font-semibold text-sm pb-2 border-b-2 border-base-content/20">
                  <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
                    Predicted
                  </div>
                  <div>Disagree</div>
                </div>
              </>
            )
          }

          <!-- Row 1: Actual Agree -->
          {
            showLabels && (
              <div class="flex items-center justify-end pr-4 font-semibold text-sm border-r-2 border-base-content/20">
                <div class="text-right">
                  <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
                    Actual
                  </div>
                  <div>Agree</div>
                </div>
              </div>
            )
          }

          <!-- True Positive (TP) -->
          <div class={`p-4 rounded-lg ${getCellColor(matrix.true_positives, true)}`}>
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wide mb-1 opacity-80">
                True Positive
              </div>
              <div class="text-3xl font-bold font-mono">{matrix.true_positives}</div>
              <div class="text-xs mt-1 opacity-70">
                {getPercentage(matrix.true_positives)}%
              </div>
            </div>
          </div>

          <!-- False Negative (FN) -->
          <div class={`p-4 rounded-lg ${getCellColor(matrix.false_negatives, false)}`}>
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wide mb-1 opacity-80">
                False Negative
              </div>
              <div class="text-3xl font-bold font-mono">{matrix.false_negatives}</div>
              <div class="text-xs mt-1 opacity-70">
                {getPercentage(matrix.false_negatives)}%
              </div>
            </div>
          </div>

          <!-- Row 2: Actual Disagree -->
          {
            showLabels && (
              <div class="flex items-center justify-end pr-4 font-semibold text-sm border-r-2 border-base-content/20">
                <div class="text-right">
                  <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
                    Actual
                  </div>
                  <div>Disagree</div>
                </div>
              </div>
            )
          }

          <!-- False Positive (FP) -->
          <div class={`p-4 rounded-lg ${getCellColor(matrix.false_positives, false)}`}>
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wide mb-1 opacity-80">
                False Positive
              </div>
              <div class="text-3xl font-bold font-mono">{matrix.false_positives}</div>
              <div class="text-xs mt-1 opacity-70">
                {getPercentage(matrix.false_positives)}%
              </div>
            </div>
          </div>

          <!-- True Negative (TN) -->
          <div class={`p-4 rounded-lg ${getCellColor(matrix.true_negatives, true)}`}>
            <div class="text-center">
              <div class="text-xs font-semibold uppercase tracking-wide mb-1 opacity-80">
                True Negative
              </div>
              <div class="text-3xl font-bold font-mono">{matrix.true_negatives}</div>
              <div class="text-xs mt-1 opacity-70">
                {getPercentage(matrix.true_negatives)}%
              </div>
            </div>
          </div>
        </div>

        <!-- Legend -->
        <div class="mt-6 pt-4 border-t border-base-content/10">
          <div class="text-xs text-base-content/60 uppercase tracking-wide mb-2">
            Understanding the Matrix
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm">
            <div class="flex items-start gap-2">
              <div class="w-4 h-4 rounded bg-success mt-0.5"></div>
              <div>
                <span class="font-semibold">True Positive (TP):</span> Judge agreed, Human agreed
              </div>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-4 h-4 rounded bg-success mt-0.5"></div>
              <div>
                <span class="font-semibold">True Negative (TN):</span> Judge disagreed, Human disagreed
              </div>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-4 h-4 rounded bg-error mt-0.5"></div>
              <div>
                <span class="font-semibold">False Positive (FP):</span> Judge agreed, Human disagreed
              </div>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-4 h-4 rounded bg-error mt-0.5"></div>
              <div>
                <span class="font-semibold">False Negative (FN):</span> Judge disagreed, Human agreed
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
