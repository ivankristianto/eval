---
/**
 * JudgeDecisionReview component - Compact human review interface for AI training
 *
 * @param decision - Decision object with training pair, judge output, and review status
 * @param personaId - Persona ID for API calls
 * @param iterationNumber - Iteration number for API calls
 */
import Badge from './ui/Badge.astro';
import type { JudgeDecisionType, HumanDecisionType } from '@src-types/training';

export interface DecisionData {
  decision_id: string;
  training_pair: {
    id: string;
    input: string;
    expected_output: string;
  };
  judge: {
    generated_output: string;
    decision: JudgeDecisionType;
    reasoning: string | null;
    created_at: string;
  };
  human_review: {
    id: string;
    decision: HumanDecisionType;
    notes: string | null;
    created_at: string;
  } | null;
}

export interface Props {
  decision: DecisionData;
  personaId: string;
  iterationNumber: number;
}

const { decision, personaId, iterationNumber } = Astro.props;

/**
 * Maps judge decisions to DaisyUI badge variants.
 */
function getDecisionVariant(judgeDecision: JudgeDecisionType): 'success' | 'error' {
  return judgeDecision === 'agree' ? 'success' : 'error';
}

const hasReview = decision.human_review !== null;
const humanDecision = decision.human_review?.decision;
const humanNotes = decision.human_review?.notes;

// Truncate long content for compact display (expandable via JS)
const TRUNCATE_LENGTH = 600;
const shouldTruncate = (text: string) => text.length > TRUNCATE_LENGTH;
---

<div
  class="card bg-base-200 shadow-md border border-base-content/10 overflow-hidden"
  data-decision-id={decision.decision_id}
>
  <div class="card-body p-4 gap-4">
    <!-- Compact Comparison Grid: 2 columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      <!-- Input Column (wider) -->
      <div class="flex flex-col">
        <div class="flex items-center justify-between px-2 py-1 bg-base-300 rounded-t-md">
          <span class="text-xs font-semibold uppercase text-base-content/60">Input</span>
          <span class="badge badge-sm badge-ghost">Prompt</span>
        </div>
        <div
          class="p-2 bg-base-100 rounded-b-md border border-base-content/10 h-full text-sm truncate-content"
        >
          <p class="whitespace-pre-wrap">{decision.training_pair.input}</p>
          {
            shouldTruncate(decision.training_pair.input) && (
              <button
                class="text-primary text-xs mt-1 hover:underline expand-btn"
                data-field="input"
              >
                Show more
              </button>
            )
          }
        </div>
      </div>

      <!-- Output Column (2 rows) -->
      <div class="flex flex-col gap-2">
        <!-- Expected Output -->
        <div class="flex flex-col flex-1">
          <div class="flex items-center justify-between px-2 py-1 bg-base-300 rounded-t-md">
            <span class="text-xs font-semibold uppercase text-base-content/60">Expected</span>
            <span class="badge badge-sm badge-success">Ground Truth</span>
          </div>
          <div
            class="p-2 bg-base-100 rounded-b-md border border-base-content/10 min-h-20 text-sm truncate-content"
          >
            <p class="whitespace-pre-wrap">{decision.training_pair.expected_output}</p>
            {
              shouldTruncate(decision.training_pair.expected_output) && (
                <button
                  class="text-primary text-xs mt-1 hover:underline expand-btn"
                  data-field="expected"
                >
                  Show more
                </button>
              )
            }
          </div>
        </div>

        <!-- Generated Output -->
        <div class="flex flex-col flex-1">
          <div class="flex items-center justify-between px-2 py-1 bg-base-300 rounded-t-md">
            <span class="text-xs font-semibold uppercase text-base-content/60">Generated</span>
            <span class="badge badge-sm badge-ghost">Task Model</span>
          </div>
          <div
            class="p-2 bg-base-100 rounded-b-md border border-base-content/10 min-h-20 text-sm truncate-content"
          >
            <p class="whitespace-pre-wrap">{decision.judge.generated_output}</p>
            {
              shouldTruncate(decision.judge.generated_output) && (
                <button
                  class="text-primary text-xs mt-1 hover:underline expand-btn"
                  data-field="generated"
                >
                  Show more
                </button>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Judge Assessment (Always Show Reasoning) -->
    <div class="space-y-2">
      <div class="flex items-center justify-between py-2 px-3 bg-base-300/50 rounded-lg">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold uppercase text-base-content/60">Judge Decision</span>
          <Badge variant={getDecisionVariant(decision.judge.decision)} size="sm">
            {decision.judge.decision === 'agree' ? '✓ Matches' : '✗ Mismatch'}
          </Badge>
        </div>
      </div>
      {
        decision.judge.reasoning && (
          <div class="p-3 bg-base-300/30 rounded text-sm border-l-2 border-info">
            <p class="whitespace-pre-wrap text-base-content/80">{decision.judge.reasoning}</p>
          </div>
        )
      }
    </div>

    <!-- Human Review Section -->
    {
      !hasReview ? (
        <div class="border-t border-base-content/10 pt-4">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold">Your Review</span>
            <span class="badge badge-sm badge-error">Required</span>
          </div>

          {/* Instructions */}
          <div class="text-xs text-base-content/70 mb-3">
            Review if the Judge's assessment is correct.
            <span class="text-success font-medium">✓ Agree</span> = Judge is right &nbsp;|&nbsp;
            <span class="text-error font-medium">✗ Disagree</span> = Judge is wrong
          </div>

          <form class="space-y-3 human-review-form">
            {/* Decision Buttons */}
            <div class="grid grid-cols-2 gap-2">
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name={`decision-${decision.decision_id}`}
                  value="agree"
                  class="peer radio radio-success radio-sm hidden"
                  required
                />
                <div class="p-3 rounded-lg border-2 border-base-content/20 text-center transition-all peer-checked:border-success peer-checked:bg-success/10 hover:border-base-content/30">
                  <div class="text-success text-lg mb-1">✓</div>
                  <div class="text-sm font-medium">Agree with Judge</div>
                  <div class="text-xs text-base-content/60 mt-1">The judge got it right</div>
                </div>
              </label>

              <label class="cursor-pointer">
                <input
                  type="radio"
                  name={`decision-${decision.decision_id}`}
                  value="disagree"
                  class="peer radio radio-error radio-sm hidden"
                  required
                />
                <div class="p-3 rounded-lg border-2 border-base-content/20 text-center transition-all peer-checked:border-error peer-checked:bg-error/10 hover:border-base-content/30">
                  <div class="text-error text-lg mb-1">✗</div>
                  <div class="text-sm font-medium">Disagree with Judge</div>
                  <div class="text-xs text-base-content/60 mt-1">The judge got it wrong</div>
                </div>
              </label>
            </div>

            {/* Optional Notes */}
            <div>
              <textarea
                class="textarea textarea-bordered textarea-sm w-full"
                rows="2"
                placeholder="Optional: Explain why you disagree..."
                name="notes"
              />
            </div>

            {/* Submit Button */}
            <button
              type="submit"
              class="btn btn-primary btn-sm w-full"
              data-persona-id={personaId}
              data-iteration-number={iterationNumber}
              data-decision-id={decision.decision_id}
            >
              Submit Review
            </button>
          </form>
        </div>
      ) : (
        <div class="border-t border-base-content/10 pt-4">
          <div class="flex items-center justify-between mb-2">
            <span class="text-sm font-semibold">Your Review</span>
            <Badge variant={humanDecision === 'agree' ? 'success' : 'error'} size="sm">
              {humanDecision === 'agree' ? '✓ Agreed' : '✗ Disagreed'}
            </Badge>
          </div>
          <div class="text-xs text-base-content/60 mb-2">
            Reviewed on {new Date(decision.human_review!.created_at).toLocaleDateString()}
          </div>
          {humanNotes && (
            <div class="p-2 bg-base-300/50 rounded text-sm border-l-2 border-primary">
              <p class="whitespace-pre-wrap">{humanNotes}</p>
            </div>
          )}
        </div>
      )
    }
  </div>
</div>

<!-- Custom styles for truncation -->
<style>
  .truncate-content p {
    display: -webkit-box;
    -webkit-line-clamp: 10;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .truncate-content.expanded p {
    -webkit-line-clamp: unset;
  }
</style>

<script>
  // Expand/collapse toggle
  document.querySelectorAll('.expand-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const content = (e.currentTarget as HTMLElement).closest('.truncate-content');
      if (content) {
        const isExpanded = content.classList.contains('expanded');
        content.classList.toggle('expanded');
        (e.currentTarget as HTMLElement).textContent = isExpanded ? 'Show more' : 'Show less';
      }
    });
  });

  // Form submission
  document.querySelectorAll('.human-review-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const personaId = submitBtn.dataset.personaId;
      const iterationNumber = submitBtn.dataset.iterationNumber;
      const decisionId = submitBtn.dataset.decisionId;

      const formData = new FormData(form as HTMLFormElement);
      const humanDecision = formData.get(`decision-${decisionId}`) as string;
      const notes = formData.get('notes') as string;

      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      submitBtn.textContent = 'Submitting...';

      try {
        const response = await fetch(
          `/api/personas/${personaId}/iterations/${iterationNumber}/feedback`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              decision_id: decisionId,
              human_decision: humanDecision,
              notes: notes || null,
            }),
          }
        );

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || 'Failed to submit review');
        }

        window.location.reload();
      } catch (error) {
        console.error('Failed to submit review:', error);
        alert(
          `Failed to submit review: ${error instanceof Error ? error.message : 'Unknown error'}`
        );
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
        submitBtn.textContent = 'Submit Review';
      }
    });
  });
</script>
