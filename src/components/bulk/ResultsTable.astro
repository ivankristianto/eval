---
/**
 * ResultsTable Component
 *
 * Paginated table displaying CSV data with evaluation results side-by-side for each model.
 * Features row selection, sticky columns with zebra striping, status badges, per-row actions,
 * bulk actions, and horizontal scroll for many columns.
 *
 * ## Z-Index Layering Strategy
 *
 * Sticky columns require careful z-index management to ensure proper visual layering during
 * horizontal and vertical scrolling. The layering strategy follows this hierarchy:
 *
 * | Layer | Z-Index | Element | Purpose |
 * |-------|---------|---------|---------|
 * | 1 | 5 | Body sticky columns | Base layer for sticky data columns in tbody |
 * | 2 | 10 | Header sticky columns | Header cells for data columns (scrolls under row controls) |
 * | 3 | 14 | Row number column | Row numbering needs to overlay data columns |
 * | 4 | 15 | Checkbox column | Selection controls need highest priority in table body |
 * | 5 | 20 | Table header (thead) | Sticky header overlays all scrolling content |
 * | 6 | 30 | Header checkbox/row-number | Header cells for control columns overlay regular header |
 * | 7 | 50 | Dropdown menus | Dropdowns must overlay all table elements |
 *
 * **Why this strategy matters:**
 *
 * 1. **Horizontal scrolling**: As users scroll right, sticky columns must overlay passing content
 * 2. **Vertical scrolling**: The header must remain visible and overlay body rows
 * 3. **Zebra striping**: Sticky columns need alternating backgrounds that match row striping
 * 4. **Hover states**: Sticky column cells must highlight with their parent row
 * 5. **Column stacking order**: When multiple sticky columns exist, leftmost columns overlay rightmost
 *
 * **Adding new sticky columns:**
 *
 * To add a new sticky column, determine its position in the visual hierarchy:
 *
 * - If it's a data column between existing sticky columns: Use `z-10` (thead) / `z-5` (tbody)
 * - If it needs to overlay data columns (like row actions): Use `z-14` or higher
 * - If it's a control column that must be most visible: Use `z-15`
 * - Update the left offset calculation to account for the new column width
 * - Add zebra striping rules for the new column (see `<style>` section)
 *
 * **CSS Implementation Notes:**
 *
 * - Z-index is applied via CSS classes in the `<style>` block, not inline
 * - The `.sticky-col` class handles data column layering
 * - `:nth-child()` selectors handle checkbox and row-number column layering
 * - Background colors are applied separately to support zebra striping
 *
 * For full documentation, see: docs/components/tables.md
 *
 * ## Custom Events
 *
 * The component dispatches custom events that parent components can listen to:
 *
 * ### `bulk-row-view-details`
 * Dispatched when user clicks "View Details" in a row's action menu.
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   rowIndex: number;  // Zero-based index of the row in the CSV data
 * }
 * ```
 *
 * **Usage Example:**
 * ```javascript
 * document.addEventListener('bulk-row-view-details', (event) => {
 *   const { rowIndex } = event.detail;
 *   // Fetch row details and show drawer
 * });
 * ```
 *
 * ### `bulk-row-regenerate`
 * Dispatched when user clicks "Regenerate All" for a specific row.
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   rowIndex: number;  // Zero-based index of the row to regenerate
 * }
 * ```
 *
 * ### `bulk-regenerate-selected`
 * Dispatched when user clicks "Regenerate Selected" bulk action.
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   rowIndices: number[];  // Array of selected row indices
 * }
 * ```
 *
 * ### `bulk-delete-selected`
 * Dispatched when user clicks "Delete Selected" bulk action.
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   rowIndices: number[];  // Array of selected row indices to delete
 * }
 * ```
 *
 * ### `bulk-cell-regenerate`
 * Dispatched when user clicks "Regenerate" on a specific cell (row + model).
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   rowIndex: number;  // Zero-based row index
 *   modelId: string;   // Model ID to regenerate
 * }
 * ```
 *
 * ### `page-change`
 * Dispatched when user changes the current page.
 *
 * **Event Detail:**
 * ```typescript
 * {
 *   page: number;  // The new page number (1-indexed)
 * }
 * ```
 *
 * ## Integration Pattern
 *
 * This component uses an event-based architecture for decoupling from parent components.
 * Parent components should:
 * 1. Render the ResultsTable component
 * 2. Listen for custom events on `document`
 * 3. Handle events by fetching data and updating UI (e.g., showing DetailDrawer)
 *
 * **Example Integration:**
 * ```astro
 * <ResultsTable dataset={dataset} run={run} results={results} />
 *
 * <script>
 *   document.addEventListener('bulk-row-view-details', (e) => {
 *     const { rowIndex } = e.detail;
 *     // Fetch row details and show drawer
 *     fetchRowResult(rowIndex).then(result => {
 *       window.showBulkRowDetails(result, rowData);
 *     });
 *   });
 * </script>
 * ```
 *
 * @example
 * <ResultsTable dataset={dataset} run={run} results={results} />
 *
 * @param dataset - Bulk dataset containing CSV data
 * @param run - Evaluation run with configuration
 * @param results - Array of row results for each model
 */

import type { BulkDataset, EvaluationRun, RowResult } from '@lib/db';
import Icon from '@components/ui/Icon.astro';
import StatusBadge from '@components/bulk/StatusBadge.astro';

interface Props {
  dataset: BulkDataset;
  run: EvaluationRun;
  results: RowResult[];
}

const { dataset, run, results } = Astro.props;

// Parse CSV data from dataset
const csvData = JSON.parse(dataset.csv_data) as Record<string, unknown>[];
const headers = csvData.length > 0 ? Object.keys(csvData[0]) : [];

// Parse selected models from run
const selectedModels = JSON.parse(run.selected_models) as Array<{
  id: string;
  name: string;
  provider: string;
}>;

// Group results by row index and model for easy lookup
const resultsMap = new Map<string, RowResult>();
for (const result of results) {
  const key = `${result.original_row_index}-${result.model_id}`;
  resultsMap.set(key, result);
}

// Default page size
const pageSize = 20;
const totalPages = Math.max(1, Math.ceil(csvData.length / pageSize));

// Calculate sticky offset for Actions column
// Base: checkbox (3rem) + row number (3rem) + headers (12rem each) + actions column (5rem)
const getActionsLeftOffset = (headerCount: number) => `calc(6rem + ${headerCount * 12}rem + 5rem)`;
---

<div
  class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl h-full flex flex-col overflow-hidden"
>
  <div class="card-body p-3 flex flex-col min-h-0">
    <!-- Table Header with Bulk Actions -->
    <div
      class="flex items-center justify-between px-1 py-2 border-b border-base-300/80 flex-shrink-0"
    >
      <div class="flex items-center gap-3">
        <label
          class="flex items-center gap-2 cursor-pointer hover:bg-base-200/50 px-2 py-1 rounded-lg transition-colors"
        >
          <input
            type="checkbox"
            class="checkbox checkbox-sm checkbox-luxe"
            id="select-all-rows"
            aria-label="Select all rows on current page"
          />
          <span class="text-sm font-medium">Select All</span>
        </label>
        <span class="text-sm text-base-content/60 font-medium">{csvData.length} rows</span>

        <!-- Bulk Action Buttons -->
        <div
          class="flex items-center gap-2 ml-2"
          id="bulk-actions"
          role="group"
          aria-label="Bulk actions"
        >
          <button
            class="btn btn-xs btn-ghost btn-luxe"
            data-action="regenerate-selected"
            title="Regenerate selected failed/pending evaluations"
            aria-label="Regenerate selected rows"
            disabled
          >
            <Icon name="refresh" size="sm" />
            Regenerate Selected
          </button>
          <button
            class="btn btn-xs btn-ghost text-error hover:bg-error/10"
            data-action="delete-selected"
            title="Delete selected results"
            aria-label="Delete selected rows"
            disabled
          >
            <Icon name="trash" size="sm" />
            Delete Selected
          </button>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="badge badge-ghost">
          {selectedModels.length} model{selectedModels.length !== 1 ? 's' : ''}
        </span>
      </div>
    </div>

    <!-- Table with horizontal and vertical scroll -->
    <div
      class="overflow-x-auto overflow-y-auto rounded-lg border border-base-300/50 flex-1 min-h-0 relative"
    >
      <table class="table-luxe table-sm" id="results-table">
        <thead class="bg-base-200/80 sticky top-0 z-20">
          <tr>
            <!-- Row checkbox column -->
            <th class="w-12 sticky left-0 z-30 bg-base-200/90 hover:bg-base-300" scope="col">
              <span class="sr-only">Select row</span>
            </th>
            <!-- Row number column -->
            <th class="w-16 sticky left-[3rem] z-30 bg-base-200/90 hover:bg-base-300" scope="col">
              <span class="sr-only">Row number</span>
            </th>
            <!-- CSV data columns -->
            {
              headers.map((header, index) => (
                <th
                  class="sticky-col z-10 bg-base-200/90 hover:bg-base-300"
                  style={`left: calc(6rem + ${index * 12}rem)`}
                >
                  <div class="flex items-center gap-2">
                    <span>{header}</span>
                  </div>
                </th>
              ))
            }
            <!-- Actions column -->
            <th
              class="w-20 sticky-col z-10 bg-base-200/90 hover:bg-base-300 text-center"
              style={`left: ${getActionsLeftOffset(headers.length)}`}
              scope="col"
            >
              <span class="sr-only">Row actions</span>
            </th>
            <!-- Model output columns -->
            {
              selectedModels.map((model) => (
                <th class="min-w-[200px] max-w-[300px]" scope="col">
                  <div class="flex items-center gap-2">
                    <span>Output</span>
                    <span class="badge badge-sm badge-neutral">{model.name}</span>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody id="results-body">
          {
            csvData.map((row, rowIndex) => (
              <tr class="hover group" data-row-index={rowIndex}>
                <td class="sticky left-0 z-10 bg-base-100">
                  <input
                    type="checkbox"
                    class="checkbox checkbox-sm checkbox-luxe row-checkbox"
                    data-row-index={rowIndex}
                    aria-label={`Select row ${rowIndex + 1}`}
                  />
                </td>
                <td class="sticky left-[3rem] z-10 bg-base-100 tabular-nums text-base-content/60">
                  {rowIndex + 1}
                </td>
                {headers.map((header, cellIndex) => {
                  const value = String(row[header] ?? '');
                  return (
                    <td
                      class="sticky-col z-10 bg-base-100 max-w-[12rem]"
                      style={`left: calc(6rem + ${cellIndex * 12}rem)`}
                    >
                      <div
                        class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                        title={value}
                      >
                        {value || <span class="opacity-30">-</span>}
                      </div>
                    </td>
                  );
                })}
                {/* Actions column with dropdown menu */}
                <td
                  class="sticky-col z-10 bg-base-100 text-center"
                  style={`left: ${getActionsLeftOffset(headers.length)}`}
                >
                  <div class="dropdown dropdown-end">
                    <label
                      tabindex="0"
                      class="btn btn-ghost btn-xs btn-circle"
                      title="Row actions"
                      aria-label={`Actions for row ${rowIndex + 1}`}
                    >
                      <Icon name="more-vertical" size="sm" />
                    </label>
                    <ul
                      tabindex="0"
                      class="dropdown-content z-[50] menu p-2 shadow bg-base-200 rounded-box w-52 text-sm"
                      role="menu"
                      aria-label={`Row ${rowIndex + 1} actions`}
                    >
                      <li role="none">
                        <a
                          data-action="view-details"
                          data-row-index={rowIndex}
                          class="flex items-center gap-2"
                          role="menuitem"
                        >
                          <Icon name="eye" size="sm" />
                          <span>View Details</span>
                        </a>
                      </li>
                      <li role="none">
                        <a
                          data-action="regenerate-row"
                          data-row-index={rowIndex}
                          class="flex items-center gap-2"
                          role="menuitem"
                        >
                          <Icon name="refresh" size="sm" />
                          <span>Regenerate All</span>
                        </a>
                      </li>
                      <li role="none">
                        <a
                          data-action="copy-output"
                          data-row-index={rowIndex}
                          class="flex items-center gap-2"
                          role="menuitem"
                        >
                          <Icon name="copy" size="sm" />
                          <span>Copy All Outputs</span>
                        </a>
                      </li>
                    </ul>
                  </div>
                </td>
                {selectedModels.map((model) => {
                  const resultKey = `${rowIndex}-${model.id}`;
                  const result = resultsMap.get(resultKey);
                  const status = result?.status || 'pending';

                  return (
                    <td
                      class="min-w-[200px] max-w-[300px]"
                      data-model-id={model.id}
                      data-row-index={rowIndex}
                    >
                      <div class="flex flex-col gap-2 group relative">
                        {/* Status Badge and Regenerate Button */}
                        <div class="flex items-center justify-between gap-1">
                          <StatusBadge status={status} size="xs" />
                          <button
                            class="btn btn-ghost btn-xs btn-circle opacity-0 group-hover:opacity-100 transition-opacity"
                            data-action="regenerate-cell"
                            data-row-index={rowIndex}
                            data-model-id={model.id}
                            title={`Regenerate output for ${model.name}`}
                            aria-label={`Regenerate row ${rowIndex + 1} with ${model.name}`}
                          >
                            <Icon name="refresh" size="sm" />
                          </button>
                        </div>

                        {/* Output text or error message */}
                        {status === 'completed' && result?.output_text ? (
                          <div
                            class="text-sm whitespace-pre-wrap break-words max-h-16 overflow-y-auto text-base-content/80"
                            title={result.output_text}
                          >
                            {result.output_text}
                          </div>
                        ) : status === 'failed' ? (
                          <div
                            class="text-xs text-error/80 italic truncate"
                            title={result?.error_message || 'Unknown error'}
                          >
                            {result?.error_message || 'Failed'}
                          </div>
                        ) : (
                          <div class="text-xs text-base-content/40 italic">Pending</div>
                        )}
                      </div>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div
      class="flex items-center justify-between px-2 py-2 border-t border-base-300/80 flex-shrink-0"
    >
      <div class="text-sm text-base-content/60 font-medium">
        <span id="pagination-info">
          Showing 1-{Math.min(pageSize, csvData.length)} of {csvData.length} rows
        </span>
      </div>
      <div class="join" role="navigation" aria-label="Table pagination">
        <button
          class="join-item btn btn-xs btn-ghost"
          data-action="prev-page"
          disabled
          aria-label="Previous page"
        >
          «
        </button>
        <button
          class="join-item btn btn-xs btn-active"
          data-page="1"
          aria-label="Page 1"
          aria-current="page"
        >
          1
        </button>
        {
          totalPages > 1 && (
            <button class="join-item btn btn-xs btn-ghost" data-page="2" aria-label="Page 2">
              2
            </button>
          )
        }
        {totalPages > 2 && <span class="join-item btn btn-xs btn-disabled btn-ghost">...</span>}
        {
          totalPages > 2 && (
            <button
              class="join-item btn btn-xs btn-ghost"
              data-page={totalPages}
              aria-label={`Page ${totalPages}`}
            >
              {totalPages}
            </button>
          )
        }
        <button
          class="join-item btn btn-xs btn-ghost"
          data-action="next-page"
          disabled
          aria-label="Next page"
        >
          »
        </button>
      </div>
    </div>

    <!-- Enhanced Empty State -->
    {
      csvData.length === 0 && (
        <div class="flex-1 flex items-center justify-center p-12">
          <div class="text-center max-w-md">
            <div class="flex justify-center mb-4">
              <div class="w-20 h-20 rounded-full bg-base-200 flex items-center justify-center">
                <Icon name="table" size="lg" class="text-base-content/30" />
              </div>
            </div>
            <h3 class="text-lg font-semibold mb-2">No Data Available</h3>
            <p class="text-sm text-base-content/70 mb-6">
              This evaluation run has no CSV data to display. Upload a CSV file to get started with
              bulk evaluations.
            </p>
            <div class="flex justify-center gap-3">
              <a href="/bulk" class="btn btn-primary btn-sm">
                <Icon name="upload" size="sm" />
                Upload CSV
              </a>
              <a href="/bulk" class="btn btn-ghost btn-sm">
                <Icon name="arrow-left" size="sm" />
                Back to Bulk Runs
              </a>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<script is:inline define:vars={{ pageSize, csvData }}>
  /**
   * Client-side functionality for results table.
   * Handles pagination, row selection, bulk actions, and per-row actions.
   */

  let currentPage = 1;
  const totalRows = csvData.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));

  const selectAllCheckbox = document.getElementById('select-all-rows');
  const paginationInfo = document.getElementById('pagination-info');

  /**
   * Update checkboxes based on visible rows
   */
  function updateCheckboxes() {
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');

    selectAllCheckbox?.addEventListener('change', (e) => {
      const isChecked = e.target.checked;
      rowCheckboxes.forEach((checkbox) => {
        const row = checkbox.closest('tr');
        const isVisible = row && row.style.display !== 'none';
        if (isVisible) {
          checkbox.checked = isChecked;
        }
      });
      updateBulkActionButtons();
    });

    rowCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        // Check if all visible rows are selected
        const visibleCheckboxes = Array.from(rowCheckboxes).filter((cb) => {
          const row = cb.closest('tr');
          return row && row.style.display !== 'none';
        });

        const allSelected = visibleCheckboxes.every((cb) => cb.checked);

        if (selectAllCheckbox) {
          selectAllCheckbox.checked = allSelected && visibleCheckboxes.length > 0;
        }
        updateBulkActionButtons();
      });
    });
  }

  /**
   * Update bulk action button states based on selection
   */
  function updateBulkActionButtons() {
    const selectedCount = getSelectedRows().length;
    const regenerateBtn = document.querySelector('[data-action="regenerate-selected"]');
    const deleteBtn = document.querySelector('[data-action="delete-selected"]');

    if (regenerateBtn) {
      regenerateBtn.disabled = selectedCount === 0;
    }
    if (deleteBtn) {
      deleteBtn.disabled = selectedCount === 0;
    }
  }

  /**
   * Update pagination display and visible rows
   */
  function updatePagination() {
    const start = (currentPage - 1) * pageSize + 1;
    const end = Math.min(currentPage * pageSize, totalRows);

    if (paginationInfo) {
      paginationInfo.textContent = `Showing ${start}-${end} of ${totalRows} rows`;
    }

    // Update page buttons
    document.querySelectorAll('[data-page]').forEach((btn) => {
      const pageNum = parseInt(btn.dataset.page || '0');
      if (pageNum === currentPage) {
        btn.classList.add('btn-active');
        btn.setAttribute('aria-current', 'page');
      } else {
        btn.classList.remove('btn-active');
        btn.removeAttribute('aria-current');
      }
    });

    // Update prev/next buttons
    const prevBtn = document.querySelector('[data-action="prev-page"]');
    const nextBtn = document.querySelector('[data-action="next-page"]');
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPages;

    // Show/hide rows based on current page
    const tbody = document.querySelector('#results-body');
    if (tbody) {
      const rows = tbody.querySelectorAll('tr[data-row-index]');
      rows.forEach((row, index) => {
        const rowNumber = index + 1;
        const shouldShow = rowNumber >= start && rowNumber <= end;
        row.style.display = shouldShow ? '' : 'none';
      });
    }
  }

  /**
   * Handle page button clicks
   */
  document.querySelectorAll('[data-page]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const page = parseInt(btn.dataset.page || '1');
      currentPage = page;
      updatePagination();

      // Reset select all checkbox when changing pages
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
      }
      updateBulkActionButtons();

      // Dispatch event for parent to handle
      const event = new CustomEvent('page-change', {
        bubbles: true,
        detail: { page },
      });
      btn.dispatchEvent(event);
    });
  });

  /**
   * Handle previous page button
   */
  document.querySelector('[data-action="prev-page"]')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      updatePagination();

      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
      }
      updateBulkActionButtons();

      document.dispatchEvent(new CustomEvent('page-change', { detail: { page: currentPage } }));
    }
  });

  /**
   * Handle next page button
   */
  document.querySelector('[data-action="next-page"]')?.addEventListener('click', () => {
    if (currentPage < totalPages) {
      currentPage++;
      updatePagination();

      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
      }
      updateBulkActionButtons();

      document.dispatchEvent(new CustomEvent('page-change', { detail: { page: currentPage } }));
    }
  });

  /**
   * Handle per-row action clicks
   */
  document.querySelectorAll('[data-action]').forEach((element) => {
    element.addEventListener('click', (e) => {
      e.preventDefault();
      const action = element.dataset.action;
      const rowIndex = element.dataset.rowIndex;

      if (!action) return;

      switch (action) {
        case 'view-details': {
          // Dispatch custom event for parent to handle
          const event = new CustomEvent('bulk-row-view-details', {
            bubbles: true,
            detail: { rowIndex: parseInt(rowIndex || '0') },
          });
          element.dispatchEvent(event);
          break;
        }
        case 'regenerate-row': {
          const event = new CustomEvent('bulk-row-regenerate', {
            bubbles: true,
            detail: { rowIndex: parseInt(rowIndex || '0') },
          });
          element.dispatchEvent(event);
          break;
        }
        case 'copy-output': {
          // Find all output cells for this row and copy them
          const row = element.closest('tr');
          if (row) {
            const outputs = [];
            row.querySelectorAll('[data-model-id]').forEach((cell) => {
              const outputText = cell.textContent?.trim();
              if (outputText && outputText !== 'Pending' && outputText !== 'Completed') {
                outputs.push(outputText);
              }
            });
            if (outputs.length > 0) {
              navigator.clipboard.writeText(outputs.join('\n\n---\n\n')).then(() => {
                // Show brief feedback
                const originalText = element.textContent;
                element.textContent = 'Copied!';
                setTimeout(() => {
                  element.textContent = originalText || '';
                }, 1500);
              });
            }
          }
          break;
        }
        case 'regenerate-selected': {
          const selectedRows = getSelectedRows();
          const event = new CustomEvent('bulk-regenerate-selected', {
            bubbles: true,
            detail: { rowIndices: selectedRows },
          });
          element.dispatchEvent(event);
          break;
        }
        case 'delete-selected': {
          const selectedRows = getSelectedRows();
          if (confirm(`Delete ${selectedRows.length} selected results?`)) {
            const event = new CustomEvent('bulk-delete-selected', {
              bubbles: true,
              detail: { rowIndices: selectedRows },
            });
            element.dispatchEvent(event);
          }
          break;
        }
        case 'regenerate-cell': {
          const modelId = element.dataset.modelId;
          if (!modelId) return;

          const event = new CustomEvent('bulk-cell-regenerate', {
            bubbles: true,
            detail: {
              rowIndex: parseInt(rowIndex || '0'),
              modelId,
            },
          });
          element.dispatchEvent(event);
          break;
        }
      }
    });
  });

  /**
   * Get selected row indices
   */
  function getSelectedRows() {
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');
    return Array.from(rowCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => parseInt(cb.dataset.rowIndex || '-1'))
      .filter((idx) => idx >= 0);
  }

  // Expose getSelectedRows function globally for parent components
  window.getSelectedBulkRows = getSelectedRows;

  // Initialize
  updateCheckboxes();
  updatePagination();
  updateBulkActionButtons();
</script>

<style>
  /* Fix zebra striping for sticky columns using .sticky-col class */
  .table-luxe tbody tr:nth-child(even) .sticky-col {
    background-color: hsl(var(--b2));
  }

  .table-luxe tbody tr:nth-child(odd) .sticky-col {
    background-color: hsl(var(--b1));
  }

  .table-luxe tbody tr:hover .sticky-col {
    background-color: hsl(var(--bc) / 0.1);
  }

  /* Ensure proper z-index layering for sticky columns */
  .table-luxe thead th.sticky-col {
    z-index: 10;
  }

  .table-luxe tbody td.sticky-col {
    z-index: 5;
  }

  /* Checkbox column should have highest z-index */
  .table-luxe tbody td.sticky:first-child {
    z-index: 15;
  }

  .table-luxe tbody td.sticky:nth-child(2) {
    z-index: 14;
  }
</style>
