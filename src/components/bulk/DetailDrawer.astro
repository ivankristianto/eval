---
/**
 * DetailDrawer Component
 *
 * Slide-out drawer for displaying full details of a bulk evaluation row.
 * Shows model outputs for a row in a clean, simplified layout.
 *
 * @example
 * <DetailDrawer allRowResults={allRowResults} rowData={rowData} rowIndex={rowIndex} />
 *
 * @param allRowResults - Array of RowResult for all models on this row
 * @param rowData - Original CSV row data as key-value pairs
 * @param rowIndex - The original row index for display
 *
 * Opens via `window.showBulkRowDetails(allRowResults, rowData, rowIndex)` global function.
 */

import Drawer from '@components/ui/Drawer.astro';
import type { RowResult } from '@lib/db';

interface Props {
  allRowResults: RowResult[];
  rowData: Record<string, string>;
  rowIndex: number;
}

// Props are used by client-side script via window.showBulkRowDetails()
const { allRowResults, rowData, rowIndex } = Astro.props;
void allRowResults; // Mark as used for client-side hydration
void rowData;
void rowIndex;
---

<Drawer id="bulk-detail-drawer" width="xl">
  <Fragment slot="title">
    <h2
      class="font-display text-2xl font-semibold text-gradient-gold"
      id="bulk-detail-drawer-title"
    >
      Row Details
    </h2>
  </Fragment>

  <!-- Content -->
  <div class="space-y-6">
    <!-- Row Index Badge -->
    <div id="bulk-detail-row-index" class="flex items-center gap-2">
      <!-- Populated by client script -->
    </div>

    <!-- Original CSV Row Data -->
    <div class="bg-base-200/50 p-4 rounded-lg border border-base-300">
      <h3 class="text-xs font-semibold text-base-content/60 mb-3 uppercase tracking-wide">
        Input Data
      </h3>
      <div id="bulk-detail-csv-data">
        <table class="table table-sm w-full">
          <tbody id="bulk-detail-csv-body">
            <!-- Populated by client script -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Model Outputs - Vertical Stack -->
    <div>
      <h3 class="text-xs font-semibold text-base-content/60 mb-3 uppercase tracking-wide">
        Model Outputs
      </h3>
      <div id="bulk-detail-model-outputs" class="space-y-3">
        <!-- Populated by client script - one section per model -->
      </div>
    </div>
  </div>
</Drawer>

<script>
  import { openDrawer } from '@lib/ui/drawer-events';
  import { initializeOnce } from '@lib/utils/client-utils';

  interface EnrichedRowResult {
    model_id: string;
    model_name: string;
    model_provider: string;
    output_text?: string;
    status: 'pending' | 'completed' | 'failed';
    error_message?: string;
    duration_ms?: number;
  }

  /**
   * Initialize bulk detail drawer functionality.
   */
  function initBulkDetailDrawer() {
    /**
     * Populates the drawer with all model results for a row and opens it.
     * @param allRowResults - Array of enriched RowResult for all models on this row
     * @param rowData - Original CSV row data as key-value pairs
     * @param rowIndex - The original row index for display
     */
    function showDetails(
      allRowResults: EnrichedRowResult[],
      rowData: Record<string, string>,
      rowIndex: number
    ) {
      // Update title
      const title = document.getElementById('bulk-detail-drawer-title');
      if (title) {
        title.textContent = `Row ${rowIndex + 1} Details`;
      }

      // Update row index header
      const rowIndexHeader = document.getElementById('bulk-detail-row-index');
      if (rowIndexHeader) {
        rowIndexHeader.innerHTML = `
          <span class="badge badge-neutral">Row ${rowIndex + 1}</span>
        `;
      }

      // Update CSV data table
      const csvBody = document.getElementById('bulk-detail-csv-body');
      if (csvBody) {
        csvBody.innerHTML = Object.entries(rowData)
          .map(
            ([key, value]) => `
          <tr>
            <td class="font-medium text-base-content/70 w-1/3">${key}</td>
            <td class="text-sm break-words">${value || '<span class="opacity-30">-</span>'}</td>
          </tr>
        `
          )
          .join('');
      }

      // Render all model outputs in vertical stack
      const modelOutputsContainer = document.getElementById('bulk-detail-model-outputs');
      if (modelOutputsContainer) {
        modelOutputsContainer.innerHTML = allRowResults
          .map((result) => {
            const isCompleted = result.status === 'completed' && result.output_text;
            const isFailed = result.status === 'failed';

            return `
              <div class="border border-base-300 rounded-lg overflow-hidden bg-base-100">
                <!-- Model Header -->
                <div class="bg-base-200/70 px-4 py-3 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <h4 class="font-semibold text-base-content">${result.model_name}</h4>
                    <span class="text-xs text-base-content/50">${result.model_provider}</span>
                  </div>
                  ${
                    result.duration_ms
                      ? `<span class="text-xs text-base-content/50 tabular-nums">${result.duration_ms}ms</span>`
                      : ''
                  }
                </div>

                <!-- Model Output -->
                <div class="p-4">
                  ${
                    isCompleted
                      ? `<div class="prose prose-sm max-w-none">
                        <div class="whitespace-pre-wrap text-sm leading-relaxed">${result.output_text}</div>
                      </div>`
                      : isFailed
                        ? `<div class="alert alert-error">
                          <div class="flex flex-col gap-1">
                            <span class="font-semibold">Failed</span>
                            <span class="text-sm opacity-80">${result.error_message || 'Unknown error'}</span>
                          </div>
                        </div>`
                        : `<div class="text-sm text-base-content/40 italic">Pending...</div>`
                  }
                </div>
              </div>
            `;
          })
          .join('');
      }

      // Open drawer
      openDrawer('bulk-detail-drawer');
    }

    // Expose to window for use from other components
    (window as unknown as { showBulkRowDetails: typeof showDetails }).showBulkRowDetails =
      showDetails;
  }

  // Initialize once and re-initialize on Astro page transitions
  initializeOnce('bulkDetailDrawer', initBulkDetailDrawer);
  document.addEventListener('astro:page-load', () => {
    initializeOnce('bulkDetailDrawer', initBulkDetailDrawer);
  });
</script>
