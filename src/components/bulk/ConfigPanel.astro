---
/**
 * ConfigPanel Component
 *
 * Configuration panel for bulk evaluation settings.
 * Provides system prompt input with template syntax, temperature slider,
 * and model selection via checkboxes.
 *
 * @example
 * <ConfigPanel models={models} />
 *
 * Emits 'bulk-config-submit' event with { system_prompt, temperature, model_ids } on submit.
 */

import type { ModelConfiguration } from '@lib/utils/types';
import Icon from '@components/ui/Icon.astro';

interface Props {
  models: ModelConfiguration[];
  modelFetchError?: string | null;
}

const { models, modelFetchError } = Astro.props;
---

<div class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl">
  <div class="card-body p-6">
    <!-- Header -->
    <div class="mb-6">
      <h3 class="font-display text-xl font-semibold text-luxe-gold mb-2">
        Evaluation Configuration
      </h3>
      <p class="text-sm text-base-content/60">
        Configure the system prompt, temperature, and select models to evaluate
      </p>
    </div>

    <!-- Configuration Form -->
    <form id="bulk-config-form" class="space-y-6">
      <!-- System Prompt Section -->
      <div class="form-control w-full">
        <label class="label" for="system-prompt">
          <span class="label-text font-medium">System Prompt</span>
          <span class="label-text-alt text-base-content/50">Max 4,000 characters</span>
        </label>
        <textarea
          id="system-prompt"
          name="system_prompt"
          rows="6"
          maxlength="4000"
          class="textarea textarea-bordered w-full font-mono text-sm"
          placeholder="You are a helpful assistant. Analyze the following data and provide insights based on the {column_name} field."
          required></textarea>
        <label class="label">
          <span class="label-text-alt">
            <strong class="text-luxe-gold">Template Syntax:</strong> Use{' '}
            <code class="badge badge-sm">{String('{column_name}')}</code> to reference CSV columns in
            your prompt.
          </span>
        </label>
        <!-- Template Examples -->
        <div class="mt-2 p-3 bg-base-200 rounded-lg">
          <p class="text-xs font-semibold mb-2">Examples:</p>
          <ul class="text-xs text-base-content/70 space-y-1">
            <li>• <code>Summarize the {String('{description}')} field</code></li>
            <li>• <code>Compare {String('{price}')} with {String('{value}')}</code></li>
            <li>• <code>Extract sentiment from {String('{review}')}</code></li>
          </ul>
        </div>
      </div>

      <!-- Temperature Slider -->
      <div class="form-control w-full">
        <label class="label" for="temperature">
          <span class="label-text font-medium">Temperature</span>
          <span class="label-text-alt font-mono text-base-content/70">
            <span id="temperature-value">0.7</span>
          </span>
        </label>
        <input
          type="range"
          id="temperature"
          name="temperature"
          min="0"
          max="1"
          step="0.1"
          value="0.7"
          class="range range-luxe"
          required
        />
        <div class="flex justify-between text-xs text-base-content/50 px-1 mt-1">
          <span>0.0 (Deterministic)</span>
          <span>1.0 (Creative)</span>
        </div>
        <label class="label">
          <span class="label-text-alt">
            Controls response randomness. Lower values produce more focused outputs.
          </span>
        </label>
      </div>

      <!-- Model Selection -->
      <div class="form-control w-full">
        <label class="label">
          <span class="label-text font-medium">Select Models</span>
          <span class="label-text-alt text-base-content/50">Choose at least one</span>
        </label>
        {
          models.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 p-4 bg-base-200 rounded-lg max-h-64 overflow-y-auto">
              {models.map((model) => (
                <label class="flex items-start gap-3 cursor-pointer p-3 hover:bg-base-300 rounded-lg transition-colors">
                  <input
                    type="checkbox"
                    name="model_ids"
                    value={model.id}
                    class="checkbox checkbox-luxe checkbox-sm mt-1"
                  />
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="font-medium text-sm truncate">{model.model_name}</span>
                      <span class="badge badge-sm badge-neutral">{model.provider}</span>
                    </div>
                    {model.notes && (
                      <p class="text-xs text-base-content/60 mt-1 truncate" title={model.notes}>
                        {model.notes}
                      </p>
                    )}
                  </div>
                </label>
              ))}
            </div>
          ) : (
            <div class="alert alert-warning">
              <Icon name="warning" size="lg" />
              <span>
                {modelFetchError
                  ? `Error loading models: ${modelFetchError}. Please `
                  : 'No models configured. '}
                <a href="/models" class="link">
                  {modelFetchError ? 'check your model configurations' : 'Add models'}
                </a>
                {modelFetchError ? '.' : ' first.'}
              </span>
            </div>
          )
        }
      </div>

      <!-- Validation Error -->
      <div id="config-error" class="hidden alert alert-error" role="alert">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="stroke-current shrink-0 h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span id="error-message">Error message here</span>
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 pt-4 border-t border-base-300">
        <button type="button" id="reset-btn" class="btn btn-ghost min-w-24"> Reset </button>
        <button
          type="submit"
          id="submit-btn"
          class="btn btn-luxe btn-luxe-primary min-w-32"
          disabled={models.length === 0}
        >
          Next Step
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  /**
   * Client-side functionality for bulk evaluation configuration.
   * Handles temperature updates, form validation, and submission.
   */

  const form = document.getElementById('bulk-config-form');
  const temperatureSlider = document.getElementById('temperature');
  const temperatureValue = document.getElementById('temperature-value');
  const resetBtn = document.getElementById('reset-btn');
  const errorDiv = document.getElementById('config-error');
  const errorMessage = document.getElementById('error-message');

  /**
   * Show error message
   */
  function showError(message) {
    errorMessage.textContent = message;
    errorDiv.classList.remove('hidden');
  }

  /**
   * Hide error message
   */
  function hideError() {
    errorDiv.classList.add('hidden');
  }

  /**
   * Update temperature display value
   */
  temperatureSlider?.addEventListener('input', () => {
    const value = parseFloat(temperatureSlider.value).toFixed(1);
    temperatureValue.textContent = value;
  });

  /**
   * Reset form to default state
   */
  resetBtn?.addEventListener('click', () => {
    form.reset();
    temperatureValue.textContent = '0.7';
    hideError();
  });

  /**
   * Validate form before submission
   */
  function validateForm() {
    const formData = new FormData(form);
    const systemPrompt = formData.get('system_prompt');
    const temperature = formData.get('temperature');
    const modelIds = formData.getAll('model_ids');

    // Validate system prompt
    if (!systemPrompt || systemPrompt.trim().length === 0) {
      return { valid: false, error: 'System prompt is required' };
    }

    if (systemPrompt.trim().length > 4000) {
      return { valid: false, error: 'System prompt exceeds 4,000 character limit' };
    }

    // Validate temperature
    const tempValue = parseFloat(temperature);
    if (isNaN(tempValue) || tempValue < 0 || tempValue > 1) {
      return { valid: false, error: 'Temperature must be between 0.0 and 1.0' };
    }

    // Validate model selection
    if (modelIds.length === 0) {
      return { valid: false, error: 'Please select at least one model' };
    }

    return { valid: true };
  }

  /**
   * Handle form submission
   */
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    hideError();

    // Validate form
    const validation = validateForm();
    if (!validation.valid) {
      showError(validation.error || 'Validation failed');
      return;
    }

    const formData = new FormData(form);
    const systemPrompt = formData.get('system_prompt');
    const temperature = parseFloat(formData.get('temperature'));
    const modelIds = formData.getAll('model_ids');

    // Dispatch custom event with configuration
    const event = new CustomEvent('bulk-config-submit', {
      bubbles: true,
      detail: {
        system_prompt: systemPrompt.trim(),
        temperature: temperature,
        model_ids: modelIds,
      },
    });
    form.dispatchEvent(event);
  });
</script>
