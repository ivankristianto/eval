---
/**
 * BulkRunsTable Component
 *
 * Reusable table component for displaying bulk evaluation runs.
 * Features: sticky columns, row selection, per-row actions, pagination, empty state.
 *
 * @example
 * <BulkRunsTable
 *   runs={bulkRuns}
 *   selectable={true}
 *   pageSize={10}
 * />
 *
 * @param runs - Array of bulk run objects
 * @param selectable - Whether to show checkboxes for row selection (default: true)
 * @param showActions - Whether to show inline action buttons (default: true)
 * @param pageSize - Number of rows per page (default: 10)
 */

import StatusBadge from './StatusBadge.astro';
import Icon from '@components/ui/Icon.astro';

export interface BulkRun {
  id: string;
  dataset_id: string;
  dataset_filename: string;
  status: 'pending' | 'running' | 'completed' | 'failed';
  model_count: number;
  total_rows: number;
  processed_rows: number;
  created_at: string;
  started_at: string | null;
  completed_at: string | null;
  error_message: string | null;
}

interface Props {
  runs: BulkRun[];
  selectable?: boolean;
  showActions?: boolean;
  pageSize?: number;
}

const { runs, selectable = true, showActions = true, pageSize = 10 } = Astro.props;

// Pagination state (will be managed by client-side script)
const totalPages = Math.max(1, Math.ceil(runs.length / pageSize));
---

<div
  class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl h-full flex flex-col overflow-hidden"
>
  <div class="card-body p-3 flex flex-col min-h-0">
    <!-- Table Header Actions -->
    <div
      class="flex items-center justify-between px-1 py-2 border-b border-base-300/80 flex-shrink-0"
    >
      <div class="flex items-center gap-3">
        {
          selectable && (
            <label class="flex items-center gap-2 cursor-pointer hover:bg-base-200/50 px-2 py-1 rounded-lg transition-colors">
              <input
                type="checkbox"
                class="checkbox checkbox-sm checkbox-luxe"
                id="select-all-runs"
              />
              <span class="text-sm font-medium">Select All</span>
            </label>
          )
        }
        <span class="text-sm text-base-content/60 font-medium">{runs.length} runs</span>
      </div>
    </div>

    <!-- Empty State -->
    {
      runs.length === 0 && (
        <div class="flex-1 flex items-center justify-center p-12">
          <div class="text-center">
            <Icon name="document" size="xl" class="mx-auto text-base-content/20 mb-4" />
            <h3 class="text-lg font-semibold mb-2">No Evaluation Runs</h3>
            <p class="text-sm text-base-content/70 mb-4">
              Create your first bulk evaluation to compare model outputs across multiple data rows
            </p>
            <a href="/bulk-eval/new" class="btn btn-primary btn-sm gap-2">
              <Icon name="plus" size="sm" />
              Create First Evaluation
            </a>
          </div>
        </div>
      )
    }

    <!-- Table -->
    {
      runs.length > 0 && (
        <div class="overflow-y-auto overflow-x-auto rounded-lg border border-base-300/50 flex-1 min-h-0">
          <table class="table-luxe table-sm" id="bulk-runs-table">
            <thead class="bg-base-200/80 sticky top-0 z-20">
              <tr>
                {selectable && <th class="w-12" />}
                <th class="min-w-[120px] max-w-[150px] sticky left-0 z-10 bg-base-200/90 hover:bg-base-300">
                  Run ID
                </th>
                <th class="min-w-[180px] max-w-[250px] sticky left-[12rem] z-10 bg-base-200/90 hover:bg-base-300">
                  Dataset
                </th>
                <th class="min-w-[120px] w-[140px]">Status</th>
                <th class="w-24 text-center">Models</th>
                <th class="min-w-[120px] w-[150px]">Progress</th>
                <th class="min-w-[140px] w-[160px]">Created</th>
                {showActions && <th class="w-14" />}
              </tr>
            </thead>
            <tbody id="bulk-runs-body">
              {runs.map((run) => (
                <tr class="hover" data-run-id={run.id}>
                  {selectable && (
                    <td>
                      <input
                        type="checkbox"
                        class="checkbox checkbox-sm checkbox-luxe run-checkbox"
                        data-run-id={run.id}
                      />
                    </td>
                  )}
                  <td class="sticky left-0 z-10 sticky-col align-middle">
                    <div class="font-mono text-sm text-base-content/70 truncate" title={run.id}>
                      {run.id.slice(0, 8)}...
                    </div>
                  </td>
                  <td class="sticky left-[12rem] z-10 sticky-col align-middle">
                    <div class="flex items-center gap-2">
                      <Icon name="document" size="sm" class="text-base-content/40 flex-shrink-0" />
                      <span class="text-sm truncate" title={run.dataset_filename}>
                        {run.dataset_filename}
                      </span>
                    </div>
                  </td>
                  <td>
                    <StatusBadge status={run.status} size="sm" />
                  </td>
                  <td class="text-center">
                    <div class="flex items-center justify-center gap-1">
                      <span class="badge badge-neutral badge-sm">{run.model_count}</span>
                    </div>
                  </td>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="flex-1 bg-base-300 rounded-full h-2 max-w-[100px]">
                        <div
                          class={`h-2 rounded-full transition-all duration-300 ${
                            run.processed_rows === run.total_rows
                              ? 'bg-gradient-emerald'
                              : 'bg-gradient-gold'
                          }`}
                          style={
                            run.total_rows > 0
                              ? `width: ${(run.processed_rows / run.total_rows) * 100}%`
                              : 'width: 0%'
                          }
                        />
                      </div>
                      <span class="text-xs font-mono text-base-content/70">
                        {run.processed_rows}/{run.total_rows}
                      </span>
                    </div>
                  </td>
                  <td>
                    <div class="text-sm text-base-content/70" title={run.created_at}>
                      <span class="created-relative" data-date={run.created_at}>
                        {new Date(run.created_at).toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                        })}
                      </span>
                    </div>
                  </td>
                  {showActions && (
                    <td>
                      <div class="flex items-center gap-1">
                        <button
                          class="btn btn-ghost btn-xs btn-circle text-luxe-gold hover:bg-luxe-gold/20"
                          data-action="view-run"
                          data-run-id={run.id}
                          title="View details"
                          aria-label={`View details for run ${run.id}`}
                        >
                          <Icon name="eye" size="sm" />
                        </button>
                        <div class="dropdown dropdown-end">
                          <label tabindex="0" class="btn btn-ghost btn-xs btn-circle">
                            <Icon name="more-vertical" size="sm" />
                          </label>
                          <ul
                            tabindex="0"
                            class="dropdown-content z-[1] menu p-2 shadow bg-base-200 rounded-box w-52 text-sm"
                          >
                            <li>
                              <a data-action="view-run" data-run-id={run.id}>
                                View Details
                              </a>
                            </li>
                            <li>
                              <a data-action="rerun-run" data-run-id={run.id}>
                                Rerun Evaluation
                              </a>
                            </li>
                            <li>
                              <a
                                class="text-error hover:bg-error/20"
                                data-action="delete-run"
                                data-run-id={run.id}
                              >
                                Delete
                              </a>
                            </li>
                          </ul>
                        </div>
                      </div>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    <!-- Pagination -->
    {
      runs.length > 0 && (
        <div class="flex items-center justify-between px-2 py-2 border-t border-base-300/80 flex-shrink-0">
          <div class="text-sm text-base-content/60 font-medium">
            <span id="pagination-info">
              Showing 1-{Math.min(pageSize, runs.length)} of {runs.length} runs
            </span>
          </div>
          <div class="join">
            <button class="join-item btn btn-xs btn-ghost" data-action="prev-page" disabled>
              &laquo;
            </button>
            <button class="join-item btn btn-xs btn-active" data-page="1">
              1
            </button>
            {totalPages > 1 && (
              <button class="join-item btn btn-xs btn-ghost" data-page="2">
                2
              </button>
            )}
            {totalPages > 2 && <span class="join-item btn btn-xs btn-disabled btn-ghost">...</span>}
            {totalPages > 2 && (
              <button class="join-item btn btn-xs btn-ghost" data-page={totalPages}>
                {totalPages}
              </button>
            )}
            <button class="join-item btn btn-xs btn-ghost" data-action="next-page" disabled>
              &raquo;
            </button>
          </div>
        </div>
      )
    }
  </div>
</div>

<script define:vars={{ pageSize, runs }} is:inline>
  // Pagination state
  let currentPage = 1;
  const totalRuns = runs.length;
  const totalPages = Math.max(1, Math.ceil(totalRuns / pageSize));

  // Select all functionality
  const selectAllCheckbox = document.getElementById('select-all-runs');

  function updateCheckboxes() {
    const runCheckboxes = document.querySelectorAll('.run-checkbox');

    selectAllCheckbox?.addEventListener('change', (e) => {
      const isChecked = e.target.checked;
      runCheckboxes.forEach((checkbox) => {
        // Only update checkboxes for visible rows (not hidden by pagination)
        const row = checkbox.closest('tr');
        const isVisible = row && row.style.display !== 'none';
        if (isVisible) {
          checkbox.checked = isChecked;
        }
      });
      // Dispatch event for parent to handle
      document.dispatchEvent(
        new CustomEvent('bulk-runs-selection-change', {
          detail: { selectedIds: getSelectedRunIds() },
        })
      );
    });

    runCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        document.dispatchEvent(
          new CustomEvent('bulk-runs-selection-change', {
            detail: { selectedIds: getSelectedRunIds() },
          })
        );
      });
    });
  }

  function getSelectedRunIds() {
    const runCheckboxes = document.querySelectorAll('.run-checkbox');
    return Array.from(runCheckboxes)
      .filter((cb) => {
        const row = cb.closest('tr');
        return cb.checked && row && row.style.display !== 'none';
      })
      .map((cb) => cb.dataset.runId)
      .filter((id) => id !== undefined);
  }

  // Pagination functions
  function updatePagination() {
    const start = (currentPage - 1) * pageSize + 1;
    const end = Math.min(currentPage * pageSize, totalRuns);
    const infoEl = document.getElementById('pagination-info');
    if (infoEl) {
      infoEl.textContent = `Showing ${start}-${end} of ${totalRuns} runs`;
    }

    // Update page buttons
    document.querySelectorAll('[data-page]').forEach((btn) => {
      const pageNum = parseInt(btn.dataset.page || '0');
      if (pageNum === currentPage) {
        btn.classList.add('btn-active');
      } else {
        btn.classList.remove('btn-active');
      }
    });

    // Update prev/next buttons
    const prevBtn = document.querySelector('[data-action="prev-page"]');
    const nextBtn = document.querySelector('[data-action="next-page"]');
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPages;

    // Show/hide rows based on current page
    const tbody = document.querySelector('#bulk-runs-body');
    if (tbody) {
      const rows = tbody.querySelectorAll('tr');
      rows.forEach((row, index) => {
        const rowNumber = index + 1;
        const shouldShow = rowNumber >= start && rowNumber <= end;
        row.style.display = shouldShow ? '' : 'none';
      });
    }
  }

  document.querySelectorAll('[data-page]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.target;
      const page = parseInt(target.dataset.page || '1');
      currentPage = page;
      updatePagination();
    });
  });

  document.querySelector('[data-action="prev-page"]')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      updatePagination();
    }
  });

  document.querySelector('[data-action="next-page"]')?.addEventListener('click', () => {
    if (currentPage < totalPages) {
      currentPage++;
      updatePagination();
    }
  });

  // View run action
  document.querySelectorAll('[data-action="view-run"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const runId = target.dataset.runId;
      if (runId) {
        // Dispatch custom event for parent to handle navigation
        const event = new CustomEvent('bulk-run-view', {
          bubbles: true,
          detail: { runId },
        });
        target.dispatchEvent(event);
      }
    });
  });

  // Delete run action
  document.querySelectorAll('[data-action="delete-run"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const runId = target.dataset.runId;
      if (runId) {
        // Dispatch custom event for parent to handle deletion
        const event = new CustomEvent('bulk-run-delete', {
          bubbles: true,
          detail: { runId },
        });
        target.dispatchEvent(event);
      }
    });
  });

  // Rerun run action
  document.querySelectorAll('[data-action="rerun-run"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const runId = target.dataset.runId;
      if (runId) {
        // Dispatch custom event for parent to handle rerun
        const event = new CustomEvent('bulk-run-rerun', {
          bubbles: true,
          detail: { runId },
        });
        target.dispatchEvent(event);
      }
    });
  });

  // Format relative time for created dates
  function formatRelativeTime(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    if (diffDays < 7) return `${diffDays}d ago`;
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  }

  // Update relative time displays
  document.querySelectorAll('.created-relative').forEach((el) => {
    const dateString = el.dataset.date;
    if (dateString) {
      el.textContent = formatRelativeTime(dateString);
    }
  });

  // Initialize checkboxes on load
  if (selectAllCheckbox) {
    updateCheckboxes();
  }

  // Initialize pagination on load
  updatePagination();
</script>

<style>
  /* Fix zebra striping for sticky columns */
  .table-luxe tbody tr:nth-child(even) .sticky-col {
    background-color: hsl(var(--b2));
  }

  .table-luxe tbody tr:nth-child(odd) .sticky-col {
    background-color: hsl(var(--b1));
  }

  .table-luxe tbody tr:hover .sticky-col {
    background-color: hsl(var(--bc) / 0.1);
  }
</style>
