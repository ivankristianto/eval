---
/**
 * MetricCard component for displaying a single metric with label, value, and optional trend
 *
 * @param label - Metric name (e.g., "F1 Score", "Precision")
 * @param value - Metric value (0.0 to 1.0 for percentages, or raw number)
 * @param format - Display format: "percentage" | "number" | "raw"
 * @param description - Optional tooltip description
 * @param trend - Optional trend indicator: "up" | "down" | "stable"
 * @param higherIsBetter - For metrics where higher is better (F1, precision, recall), use true.
 *                        For metrics where lower is better (error rate), use false.
 *                        Defaults to true. Controls trend color logic.
 * @param variant - Color variant: "primary" | "success" | "warning" | "error" | "info"
 *
 * Trend Color Logic:
 * - When higherIsBetter=true (default): up=green (good), down=red (bad)
 * - When higherIsBetter=false: up=red (bad), down=green (good)
 * - stable: always gray (neutral)
 */

export interface Props {
  label: string;
  value: number | null;
  format?: 'percentage' | 'number' | 'raw';
  description?: string;
  trend?: 'up' | 'down' | 'stable';
  higherIsBetter?: boolean;
  variant?: 'primary' | 'success' | 'warning' | 'error' | 'info';
}

const {
  label,
  value,
  format = 'percentage',
  description,
  trend,
  higherIsBetter = true,
  variant = 'primary',
} = Astro.props;

// Format value based on format type
function formatValue(val: number | null, fmt: string): string {
  if (val === null) return 'N/A';

  switch (fmt) {
    case 'percentage':
      return `${(val * 100).toFixed(1)}%`;
    case 'number':
      return val.toFixed(2);
    case 'raw':
      return val.toString();
    default:
      return val.toString();
  }
}

// Get variant class for value display
function getVariantClass(v: string): string {
  switch (v) {
    case 'primary':
      return 'text-primary';
    case 'success':
      return 'text-success';
    case 'warning':
      return 'text-warning';
    case 'error':
      return 'text-error';
    case 'info':
      return 'text-info';
    default:
      return 'text-primary';
  }
}

// Get trend icon and color
function getTrendIcon(
  t?: string,
  higherBetter: boolean = true
): { icon: string; color: string } | null {
  if (!t) return null;

  switch (t) {
    case 'up':
      // When higher is better (F1, precision, recall), up is good (green)
      // When lower is better (error rate), up is bad (red)
      return {
        icon: 'M5 15l7-7 7 7',
        color: higherBetter ? 'text-success' : 'text-error',
      };
    case 'down':
      // When higher is better (F1, precision, recall), down is bad (red)
      // When lower is better (error rate), down is good (green)
      return {
        icon: 'M19 9l-7 7-7-7',
        color: higherBetter ? 'text-error' : 'text-success',
      };
    case 'stable':
      return {
        icon: 'M5 12h14',
        color: 'text-base-content/60',
      };
    default:
      return null;
  }
}

const formattedValue = formatValue(value, format);
const variantClass = getVariantClass(variant);
const trendInfo = getTrendIcon(trend, higherIsBetter);
---

<div class="card bg-base-200 shadow-md">
  <div class="card-body p-4">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-semibold text-base-content/60 uppercase tracking-wide">
            {label}
          </h3>
          {
            description && (
              <div class="tooltip tooltip-right" data-tip={description}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-base-content/40"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
              </div>
            )
          }
        </div>

        <div class={`text-3xl font-bold font-mono mt-2 ${variantClass}`}>
          {formattedValue}
        </div>
      </div>

      {
        trendInfo && (
          <div class={`flex items-center gap-1 ${trendInfo.color}`}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d={trendInfo.icon}
              />
            </svg>
          </div>
        )
      }
    </div>
  </div>
</div>
