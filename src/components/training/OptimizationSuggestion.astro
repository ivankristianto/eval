---
/**
 * OptimizationSuggestion Modal Component
 *
 * Modal displaying LLM-suggested prompt improvements with before/after diff.
 * Shows rationale and allows user to Accept, Edit, or Reject the suggestion.
 *
 * @param type - 'task' or 'judge' prompt type
 * @param currentPrompt - Current prompt text
 * @param suggestedPrompt - LLM-suggested improved prompt
 * @param rationale - Explanation of changes
 * @param modalId - Unique ID for the modal (default: 'optimization-modal')
 */

import Modal from '@components/ui/Modal.astro';

interface Props {
  type: 'task' | 'judge';
  currentPrompt: string;
  suggestedPrompt: string;
  rationale: string;
  modalId?: string;
  personaId?: string;
}

const {
  type,
  currentPrompt,
  suggestedPrompt,
  rationale,
  modalId = 'optimization-modal',
  personaId,
} = Astro.props;
---

<!-- Modal using native dialog element -->
<Modal id={modalId} title={`🤖 Optimized ${type} Prompt Suggestion`} size="3xl">
  <!-- Rationale -->
  <div slot="content">
    <div class="alert alert-info mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="stroke-current shrink-0 w-6 h-6"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
      >
      <div>
        <h4 class="font-semibold">Improvement Rationale</h4>
        <p class="text-sm mt-1">{rationale}</p>
      </div>
    </div>

    <!-- Before/After Diff -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <!-- Current Prompt -->
      <div>
        <h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
          <span class="badge badge-ghost badge-sm">Current</span>
          Version
        </h4>
        <div class="mockup-code bg-base-200 text-base-content text-sm max-h-64 overflow-y-auto">
          <pre class="px-4"><code>{currentPrompt}</code></pre>
        </div>
      </div>

      <!-- Suggested Prompt -->
      <div>
        <h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
          <span class="badge badge-success badge-sm">Suggested</span>
          Improved Version
        </h4>
        <div
          class="mockup-code bg-success/10 text-base-content text-sm max-h-64 overflow-y-auto border-2 border-success/30"
          data-suggested-prompt="true"
        >
          <pre class="px-4"><code>{suggestedPrompt}</code></pre>
        </div>
      </div>
    </div>

    <!-- Visual Diff Indicator -->
    <div class="flex items-center gap-2 text-sm text-base-content/70 mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"></path>
      </svg>
      <span>Changes: Added specificity, improved clarity, addressed failure patterns</span>
    </div>
  </div>

  <!-- Actions -->
  <div slot="footer" class="modal-action">
    <button
      type="button"
      class="btn btn-ghost"
      data-action="reject-suggestion"
      data-modal-id={modalId}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      Reject
    </button>
    <button
      type="button"
      class="btn btn-primary"
      data-action="save-suggestion"
      data-modal-id={modalId}
      data-type={type}
      data-persona-id={personaId || ''}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
        ></path>
      </svg>
      Save as New Version
    </button>
    <button
      type="button"
      class="btn btn-secondary"
      data-action="edit-suggestion"
      data-modal-id={modalId}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
        ></path>
      </svg>
      Edit & Accept
    </button>
    <button
      type="button"
      class="btn btn-success"
      data-action="accept-suggestion"
      data-modal-id={modalId}
      data-type={type}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
      </svg>
      Accept
    </button>
  </div>
</Modal>

<script>
  // Helper function to get suggested prompt from modal
  function getSuggestedPrompt(modalId: string): string | null {
    const modal = document.getElementById(modalId);
    if (!modal) return null;

    // Select the code element from the suggested prompt column (has data-suggested-prompt attribute)
    const suggestedContainer = modal.querySelector('[data-suggested-prompt="true"]');
    const suggestedCodeEl = suggestedContainer?.querySelector('pre code');
    return suggestedCodeEl?.textContent?.trim() || null;
  }

  // Save suggestion handler
  document.querySelectorAll('[data-action="save-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;
      const type = button.dataset.type;
      const personaId = button.dataset.personaId;

      if (!personaId) {
        console.error('No personaId provided');
        if (window.toast) {
          window.toast.error('Cannot save: Missing persona ID');
        }
        return;
      }

      if (!modalId) {
        console.error('No modalId provided');
        if (window.toast) {
          window.toast.error('Cannot save: Missing modal ID');
        }
        return;
      }

      const suggestedPrompt = getSuggestedPrompt(modalId);

      if (!suggestedPrompt) {
        console.error('Could not find suggested prompt');
        if (window.toast) {
          window.toast.error('Cannot save: Suggested prompt not found');
        }
        return;
      }

      try {
        // Show loading state
        button.classList.add('loading');
        button.setAttribute('disabled', 'true');

        const response = await fetch(`/api/personas/${personaId}/prompts/${type}/save`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prompt_text: suggestedPrompt,
            improvement_rationale: 'Saved from optimization suggestion',
          }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Failed to save prompt');
        }

        // Show success notification
        if (window.toast) {
          window.toast.success(`New ${type} prompt version saved!`);
        }

        // Close modal
        const modal = document.getElementById(modalId) as HTMLDialogElement | null;
        if (modal) modal.close();

        // Dispatch event to refresh versions list
        const event = new CustomEvent('prompt-saved', {
          bubbles: true,
          detail: { type, personaId },
        });
        document.dispatchEvent(event);

        // Reload page to show new version
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      } catch (error) {
        console.error('Save suggestion error:', error);
        if (window.toast) {
          window.toast.error(error instanceof Error ? error.message : 'Failed to save prompt');
        }
      } finally {
        // Remove loading state
        button.classList.remove('loading');
        button.removeAttribute('disabled');
      }
    });
  });

  // Accept suggestion handler
  document.querySelectorAll('[data-action="accept-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;
      const type = button.dataset.type;

      // Validate required fields
      if (!modalId || !type) {
        console.error('No modalId or type provided');
        if (window.toast) {
          window.toast.error('Cannot accept: Missing modal ID or type');
        }
        return;
      }

      const suggestedPrompt = getSuggestedPrompt(modalId);

      if (!suggestedPrompt) {
        console.error('Could not find suggested prompt');
        if (window.toast) {
          window.toast.error('Cannot accept: Suggested prompt not found');
        }
        return;
      }

      // Close modal
      const modal = document.getElementById(modalId) as HTMLDialogElement | null;
      if (modal) modal.close();

      // Dispatch custom event with the suggested prompt
      const event = new CustomEvent('suggestion-accepted', {
        bubbles: true,
        detail: { modalId, type, suggestedPrompt },
      });
      button.dispatchEvent(event);

      // Show success notification
      if (window.toast) {
        window.toast.success(`${type} prompt updated with optimization suggestion!`);
      }
    });
  });

  // Reject suggestion handler
  document.querySelectorAll('[data-action="reject-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;

      if (!modalId) {
        console.error('No modalId provided');
        return;
      }

      // Close modal
      const modal = document.getElementById(modalId) as HTMLDialogElement | null;
      if (modal) modal.close();

      // Show notification
      if (window.toast) {
        window.toast.info('Optimization suggestion rejected');
      }
    });
  });

  // Edit suggestion handler
  document.querySelectorAll('[data-action="edit-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;
      console.log('Edit suggestion clicked');

      if (!modalId) {
        console.error('No modalId provided');
        return;
      }

      // Close modal first
      const modal = document.getElementById(modalId) as HTMLDialogElement | null;
      if (modal) modal.close();

      // Dispatch custom event for parent to handle
      const event = new CustomEvent('suggestion-edit', {
        bubbles: true,
        detail: { modalId },
      });
      button.dispatchEvent(event);
    });
  });
</script>
