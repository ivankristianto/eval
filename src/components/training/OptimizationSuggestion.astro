---
/**
 * OptimizationSuggestion Modal Component
 *
 * Modal displaying LLM-suggested prompt improvements with before/after diff.
 * Shows rationale and allows user to Accept, Edit, or Reject the suggestion.
 *
 * @param type - 'task' or 'judge' prompt type
 * @param currentPrompt - Current prompt text
 * @param suggestedPrompt - LLM-suggested improved prompt
 * @param rationale - Explanation of changes
 * @param modalId - Unique ID for the modal (default: 'optimization-modal')
 */

interface Props {
  type: 'task' | 'judge';
  currentPrompt: string;
  suggestedPrompt: string;
  rationale: string;
  modalId?: string;
}

const {
  type,
  currentPrompt,
  suggestedPrompt,
  rationale,
  modalId = 'optimization-modal',
} = Astro.props;
---

<!-- Modal Toggle (hidden checkbox) -->
<input type="checkbox" id={modalId} class="modal-toggle" />

<!-- Modal -->
<div class="modal" role="dialog">
  <div class="modal-box max-w-4xl">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-bold text-lg capitalize">
        🤖 Optimized {type} Prompt Suggestion
      </h3>
      <label for={modalId} class="btn btn-sm btn-circle btn-ghost">✕</label>
    </div>

    <!-- Rationale -->
    <div class="alert alert-info mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="stroke-current shrink-0 w-6 h-6"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
      >
      <div>
        <h4 class="font-semibold">Improvement Rationale</h4>
        <p class="text-sm mt-1">{rationale}</p>
      </div>
    </div>

    <!-- Before/After Diff -->
    <div class="grid grid-cols-2 gap-4 mb-4">
      <!-- Current Prompt -->
      <div>
        <h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
          <span class="badge badge-ghost badge-sm">Current</span>
          Version
        </h4>
        <div class="mockup-code bg-base-200 text-sm max-h-64 overflow-y-auto">
          <pre class="px-4"><code>{currentPrompt}</code></pre>
        </div>
      </div>

      <!-- Suggested Prompt -->
      <div>
        <h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
          <span class="badge badge-success badge-sm">Suggested</span>
          Improved Version
        </h4>
        <div
          class="mockup-code bg-success/10 text-sm max-h-64 overflow-y-auto border-2 border-success/30"
        >
          <pre class="px-4"><code>{suggestedPrompt}</code></pre>
        </div>
      </div>
    </div>

    <!-- Visual Diff Indicator -->
    <div class="flex items-center gap-2 text-sm text-base-content/70 mb-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"></path>
      </svg>
      <span>Changes: Added specificity, improved clarity, addressed failure patterns</span>
    </div>

    <!-- Actions -->
    <div class="modal-action">
      <label for={modalId} class="btn btn-ghost">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Reject
      </label>
      <button class="btn btn-secondary" data-action="edit-suggestion" data-modal-id={modalId}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
          ></path>
        </svg>
        Edit & Accept
      </button>
      <button class="btn btn-success" data-action="accept-suggestion" data-modal-id={modalId}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
        </svg>
        Accept
      </button>
    </div>
  </div>
  <label class="modal-backdrop" for={modalId}>Close</label>
</div>

<script>
  // Client-side interaction handling
  document.querySelectorAll('[data-action="accept-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;
      console.log('Accepted optimization suggestion');

      // Close modal
      const modalCheckbox = document.getElementById(modalId) as HTMLInputElement;
      if (modalCheckbox) modalCheckbox.checked = false;

      // Dispatch custom event
      const event = new CustomEvent('suggestion-accepted', {
        bubbles: true,
        detail: { modalId },
      });
      button.dispatchEvent(event);
    });
  });

  document.querySelectorAll('[data-action="edit-suggestion"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const modalId = button.dataset.modalId;
      console.log('Edit suggestion clicked');

      // Dispatch custom event for parent to handle
      const event = new CustomEvent('suggestion-edit', {
        bubbles: true,
        detail: { modalId },
      });
      button.dispatchEvent(event);
    });
  });
</script>
