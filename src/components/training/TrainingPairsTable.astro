---
/**
 * TrainingPairsTable Component
 *
 * Unified table displaying all training pair data with inline actions.
 * Features: pagination, inline row editing, no alert() calls, proper zebra striping
 *
 * @param pairs - Array of training pair objects with results
 * @param selectable - Whether to show checkboxes for selection (default: true)
 * @param showActions - Whether to show inline actions (default: true)
 * @param pageSize - Number of rows per page (default: 10)
 */

import PassFailBadge from './PassFailBadge.astro';

interface TrainingPairResult {
  id: string;
  input: string;
  expected_output: string;
  generated_output?: string;
  judge_rating?: 'pass' | 'fail';
  judge_feedback?: string;
  human_rating?: 'pass' | 'fail';
  human_feedback?: string;
}

interface Props {
  pairs: TrainingPairResult[];
  selectable?: boolean;
  showActions?: boolean;
  pageSize?: number;
  personaId?: string;
}

const { pairs, selectable = true, showActions = true, pageSize = 10, personaId } = Astro.props;

// Pagination state (will be managed by client-side script)
const totalPages = Math.max(1, Math.ceil(pairs.length / pageSize));
---

<div
  class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl overflow-hidden"
>
  <div class="card-body p-3">
    <!-- Table Header Actions -->
    <div class="flex items-center justify-between px-1 py-2 border-b border-base-300/80">
      <div class="flex items-center gap-3">
        {
          selectable && (
            <label class="flex items-center gap-2 cursor-pointer hover:bg-base-200/50 px-2 py-1 rounded-lg transition-colors">
              <input type="checkbox" class="checkbox checkbox-sm" id="select-all-pairs" />
              <span class="text-sm font-medium">Select All</span>
            </label>
          )
        }
        <span class="text-sm text-base-content/60 font-medium">{pairs.length} pairs</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="btn btn-sm btn-ghost border border-base-300 hover:bg-base-200 transition-all"
          data-action="import-csv"
          title="Import CSV"
          aria-label="Import CSV file"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
            ></path>
          </svg>
          Import CSV
        </button>
        <input
          type="file"
          id="csv-upload-input"
          class="hidden"
          accept=".csv"
          data-action="csv-file-input"
          aria-label="CSV file upload"
        />
        <button
          class="btn btn-sm btn-primary shadow-md hover:shadow-lg transition-all"
          data-action="evaluate-selected"
          data-persona-id={personaId}
          disabled
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75m3 7.5V21a.75.75 0 01-.75.75h-4.5a.75.75 0 01-.75-.75v-4.5M9 12.75l3 .75M9 12.75l-.75-3M12 15.75l3-.75M12 15.75l.75-3M15 12.75l-.75 3"
            ></path>
          </svg>
          Evaluate Selected
        </button>
      </div>
    </div>

    <!-- Table with vertical scrolling -->
    <div class="overflow-y-auto max-h-96 overflow-x-auto rounded-lg border border-base-300/50">
      <table class="table table-sm" id="training-pairs-table">
        <thead class="bg-base-200/80 sticky top-0 z-20">
          <tr>
            {selectable && <th class="w-12" />}
            <th
              class="min-w-[200px] max-w-[300px] sticky left-0 z-10 bg-base-200/90 hover:bg-base-300"
              >Input</th
            >
            <th
              class="min-w-[200px] max-w-[300px] sticky left-[12rem] z-10 bg-base-200/90 hover:bg-base-300"
              >Expected Output</th
            >
            <th
              class="min-w-[200px] max-w-[300px] sticky left-[24rem] z-10 bg-base-200/90 hover:bg-base-300"
              >Generated Output</th
            >
            <th class="w-24 text-center">Human Rating</th>
            <th class="min-w-[150px]">Human Feedback</th>
            <th class="w-24 text-center">Judge Rating</th>
            <th class="min-w-[150px]">Judge Feedback</th>
            {showActions && <th class="w-14" />}
          </tr>
        </thead>
        <tbody id="training-pairs-body">
          <!-- New editable row (shown by default) -->
          <tr class="new-row bg-primary/10" data-new-row="true">
            {selectable && <td />}
            <td class="sticky left-0 z-10 align-top">
              <textarea
                class="textarea textarea-xs w-full min-h-[60px] resize-y"
                placeholder="Enter input..."
                data-new-field="input"></textarea>
            </td>
            <td class="sticky left-[12rem] z-10 align-top">
              <textarea
                class="textarea textarea-xs w-full min-h-[60px] resize-y"
                placeholder="Enter expected output..."
                data-new-field="expected_output"></textarea>
            </td>
            <td class="sticky left-[24rem] z-10 align-top">
              <span class="text-sm opacity-50 italic">Auto-generated</span>
            </td>
            <td class="text-center align-middle">
              <span class="text-sm opacity-50 italic">-</span>
            </td>
            <td class="align-top">
              <input
                type="text"
                class="input input-sm input-ghost w-full"
                placeholder="Optional feedback..."
                data-new-field="feedback"
              />
            </td>
            <td class="text-center align-middle">
              <span class="text-sm opacity-50 italic">-</span>
            </td>
            <td class="align-top">
              <span class="text-sm opacity-50 italic">-</span>
            </td>
            {
              showActions && (
                <td>
                  <button
                    class="btn btn-ghost btn-xs btn-circle text-success hover:bg-success/20"
                    data-action="save-new-row"
                    title="Save new row"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      class="w-4 h-4"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"
                      />
                    </svg>
                  </button>
                </td>
              )
            }
          </tr>
          {
            pairs.map((pair) => (
              <tr class="hover" data-pair-id={pair.id}>
                {selectable && (
                  <td>
                    <input
                      type="checkbox"
                      class="checkbox checkbox-sm pair-checkbox"
                      data-pair-id={pair.id}
                    />
                  </td>
                )}
                <td class="sticky left-0 z-10 sticky-col align-top" data-cell-type="input">
                  <div
                    class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                    title={pair.input}
                    data-content
                  >
                    {pair.input}
                  </div>
                </td>
                <td
                  class="sticky left-[12rem] z-10 sticky-col align-top"
                  data-cell-type="expected-output"
                >
                  <div
                    class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                    title={pair.expected_output}
                    data-content
                  >
                    {pair.expected_output}
                  </div>
                </td>
                <td
                  class="sticky left-[24rem] z-10 sticky-col align-top"
                  data-cell-type="generated-output"
                >
                  {pair.generated_output ? (
                    <div
                      class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                      title={pair.generated_output}
                      data-content
                    >
                      {pair.generated_output}
                    </div>
                  ) : (
                    <span class="text-sm opacity-50 italic" data-placeholder>
                      Not generated
                    </span>
                  )}
                </td>
                <td class="text-center align-middle" data-cell-type="human-rating">
                  {pair.human_rating ? (
                    <PassFailBadge rating={pair.human_rating} size="sm" />
                  ) : (
                    <div class="flex gap-1 justify-center">
                      <button
                        class="btn btn-sm btn-success"
                        data-action="human-rate"
                        data-pair-id={pair.id}
                        data-rating="pass"
                        title="Mark as Pass"
                      >
                        Pass
                      </button>
                      <button
                        class="btn btn-sm btn-error"
                        data-action="human-rate"
                        data-pair-id={pair.id}
                        data-rating="fail"
                        title="Mark as Fail"
                      >
                        Fail
                      </button>
                    </div>
                  )}
                </td>
                <td class="align-top" data-cell-type="human-feedback">
                  {pair.human_feedback ? (
                    <div
                      class="text-sm opacity-70 whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                      title={pair.human_feedback}
                      data-content
                    >
                      {pair.human_feedback}
                    </div>
                  ) : (
                    <input
                      type="text"
                      class="input input-sm input-ghost w-full"
                      placeholder="Add note..."
                      data-action="add-feedback"
                      data-pair-id={pair.id}
                    />
                  )}
                </td>
                <td class="text-center align-middle" data-cell-type="judge-rating">
                  <PassFailBadge rating={pair.judge_rating} size="sm" />
                </td>
                <td class="align-top" data-cell-type="judge-feedback">
                  {pair.judge_feedback ? (
                    <div
                      class="text-sm opacity-70 whitespace-pre-wrap break-words max-h-20 overflow-y-auto"
                      title={pair.judge_feedback}
                      data-content
                    >
                      {pair.judge_feedback}
                    </div>
                  ) : (
                    <span class="text-sm opacity-50 italic" data-placeholder>
                      -
                    </span>
                  )}
                </td>
                {showActions && (
                  <td>
                    <div class="dropdown dropdown-end">
                      <label tabindex="0" class="btn btn-ghost btn-xs">
                        ⋮
                      </label>
                      <ul
                        tabindex="0"
                        class="dropdown-content z-[1] menu p-2 shadow bg-base-200 rounded-box w-52 text-sm"
                      >
                        <li>
                          <a data-action="view-details" data-pair-id={pair.id}>
                            View Details
                          </a>
                        </li>
                        <li>
                          <a data-action="regenerate" data-pair-id={pair.id}>
                            Regenerate Output
                          </a>
                        </li>
                        <li>
                          <a data-action="copy" data-pair-id={pair.id}>
                            Copy to Clipboard
                          </a>
                        </li>
                      </ul>
                    </div>
                  </td>
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between px-2 py-2 border-t border-base-300/80">
      <div class="text-sm text-base-content/60 font-medium">
        <span id="pagination-info"
          >Showing 1-{Math.min(pageSize, pairs.length)} of {pairs.length} pairs</span
        >
      </div>
      <div class="join">
        <button class="join-item btn btn-xs btn-ghost" data-action="prev-page" disabled>«</button>
        <button class="join-item btn btn-xs btn-active" data-page="1">1</button>
        {
          totalPages > 1 && (
            <button class="join-item btn btn-xs btn-ghost" data-page="2">
              2
            </button>
          )
        }
        {totalPages > 2 && <span class="join-item btn btn-xs btn-disabled btn-ghost">...</span>}
        {
          totalPages > 2 && (
            <button class="join-item btn btn-xs btn-ghost" data-page={totalPages}>
              {totalPages}
            </button>
          )
        }
        <button class="join-item btn btn-xs btn-ghost" data-action="next-page" disabled>»</button>
      </div>
    </div>

    <!-- Empty State -->
    {
      pairs.length === 0 && (
        <div class="p-12 text-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-16 h-16 mx-auto opacity-30 mb-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
            />
          </svg>
          <h3 class="text-lg font-semibold mb-2">No Training Data</h3>
          <p class="text-sm text-base-content/70 mb-4">Upload a CSV file to add training pairs</p>
          <button class="btn btn-primary btn-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"
              />
            </svg>
            Upload CSV
          </button>
        </div>
      )
    }
  </div>
</div>

<script define:vars={{ pageSize, pairs }}>
  // Pagination state
  let currentPage = 1;
  const totalPairs = pairs.length;
  const totalPages = Math.max(1, Math.ceil(totalPairs / pageSize));

  // Select all functionality
  const selectAllCheckbox = document.getElementById('select-all-pairs');
  const evaluateSelectedBtn = document.querySelector('[data-action="evaluate-selected"]');

  function updateCheckboxes() {
    const pairCheckboxes = document.querySelectorAll('.pair-checkbox');

    selectAllCheckbox?.addEventListener('change', (e) => {
      const isChecked = e.target.checked;
      pairCheckboxes.forEach((checkbox) => {
        checkbox.checked = isChecked;
      });
      updateEvaluateButton();
    });

    pairCheckboxes.forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        updateEvaluateButton();
      });
    });
  }

  function updateEvaluateButton() {
    const pairCheckboxes = document.querySelectorAll('.pair-checkbox');
    const selectedCount = Array.from(pairCheckboxes).filter((cb) => cb.checked).length;
    if (evaluateSelectedBtn) {
      evaluateSelectedBtn.disabled = selectedCount === 0;
    }
  }

  // Pagination functions
  function updatePagination() {
    const start = (currentPage - 1) * pageSize + 1;
    const end = Math.min(currentPage * pageSize, totalPairs);
    const infoEl = document.getElementById('pagination-info');
    if (infoEl) {
      infoEl.textContent = `Showing ${start}-${end} of ${totalPairs} pairs`;
    }

    // Update page buttons
    document.querySelectorAll('[data-page]').forEach((btn) => {
      const pageNum = parseInt(btn.dataset.page || '0');
      if (pageNum === currentPage) {
        btn.classList.add('btn-active');
      } else {
        btn.classList.remove('btn-active');
      }
    });

    // Update prev/next buttons
    const prevBtn = document.querySelector('[data-action="prev-page"]');
    const nextBtn = document.querySelector('[data-action="next-page"]');
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPages;
  }

  document.querySelectorAll('[data-page]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.target;
      const page = parseInt(target.dataset.page || '1');
      currentPage = page;
      updatePagination();
      // Dispatch event for parent to handle actual data re-rendering
      const event = new CustomEvent('page-change', {
        bubbles: true,
        detail: { page },
      });
      target.dispatchEvent(event);
    });
  });

  document.querySelector('[data-action="prev-page"]')?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      updatePagination();
      document.dispatchEvent(new CustomEvent('page-change', { detail: { page: currentPage } }));
    }
  });

  document.querySelector('[data-action="next-page"]')?.addEventListener('click', () => {
    if (currentPage < totalPages) {
      currentPage++;
      updatePagination();
      document.dispatchEvent(new CustomEvent('page-change', { detail: { page: currentPage } }));
    }
  });

  // Human rating buttons
  document.querySelectorAll('[data-action="human-rate"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget;
      const pairId = button.dataset.pairId;
      const rating = button.dataset.rating;
      console.log(`Human rated pair ${pairId} as ${rating}`);

      // Dispatch custom event
      const event = new CustomEvent('human-rating', {
        bubbles: true,
        detail: { pairId, rating },
      });
      button.dispatchEvent(event);

      // Replace buttons with badge
      const td = button.closest('td');
      if (td) {
        td.innerHTML = `<span class="badge badge-sm badge-${rating === 'pass' ? 'success' : 'error'}">${rating}</span>`;
      }
    });
  });

  // Add feedback input handler
  document.querySelectorAll('[data-action="add-feedback"]').forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target;
      const pairId = target.dataset.pairId;
      const feedback = target.value;
      if (feedback) {
        console.log(`Added feedback for pair ${pairId}:`, feedback);

        // Dispatch custom event
        const event = new CustomEvent('human-feedback', {
          bubbles: true,
          detail: { pairId, feedback },
        });
        target.dispatchEvent(event);

        // Show visual confirmation
        target.classList.add('input-success');
        setTimeout(() => {
          target.classList.remove('input-success');
        }, 1000);
      }
    });

    input.addEventListener('blur', (e) => {
      const target = e.target;
      const pairId = target.dataset.pairId;
      const feedback = target.value;
      if (feedback) {
        console.log(`Saved feedback for pair ${pairId}:`, feedback);
      }
    });
  });

  // Evaluate selected button
  evaluateSelectedBtn?.addEventListener('click', async () => {
    const pairCheckboxes = document.querySelectorAll('.pair-checkbox');
    const selectedIds = Array.from(pairCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.dataset.pairId)
      .filter((id) => id !== undefined);

    if (selectedIds.length === 0) {
      console.log('No pairs selected');
      return;
    }

    const personaId = evaluateSelectedBtn?.dataset.personaId;
    if (!personaId) {
      console.error('No persona_id found on evaluate-selected button');
      return;
    }

    console.log('Evaluate selected pairs:', selectedIds);

    // Show loading state
    evaluateSelectedBtn.classList.add('loading');
    evaluateSelectedBtn.disabled = true;

    try {
      const response = await fetch('/api/judge/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          persona_id: personaId,
          training_pair_result_ids: selectedIds,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to evaluate selected pairs');
      }

      console.log(`Evaluated ${result.evaluated_results} pairs`);

      // Dispatch event with results
      const event = new CustomEvent('evaluation-complete', {
        bubbles: true,
        detail: { count: result.evaluated_results, ids: selectedIds },
      });
      evaluateSelectedBtn.dispatchEvent(event);

      // Start polling for real-time updates
      document.dispatchEvent(new CustomEvent('operation-started'));

      // Show success notification
      if (window.toast) {
        window.toast.success(
          `Evaluated ${result.evaluated_results} pairs successfully! Watching for updates...`
        );
      }
    } catch (error) {
      console.error('Evaluate selected error:', error);
      if (window.toast) {
        window.toast.error(
          error instanceof Error ? error.message : 'Failed to evaluate selected pairs'
        );
      }
    } finally {
      evaluateSelectedBtn.classList.remove('loading');
      evaluateSelectedBtn.disabled = false;
    }
  });

  // CSV import button
  const importCsvBtn = document.querySelector('[data-action="import-csv"]');
  const csvFileInput = document.querySelector('[data-action="csv-file-input"]');

  importCsvBtn?.addEventListener('click', () => {
    console.log('Import CSV clicked');
    if (csvFileInput) {
      csvFileInput.click();
    }
  });

  csvFileInput?.addEventListener('change', (e) => {
    const target = e.target;
    const file = target.files?.[0];
    if (file) {
      console.log('CSV file selected:', file.name);
      // Dispatch custom event for CSV import
      const event = new CustomEvent('csv-import', {
        bubbles: true,
        detail: { file },
      });
      csvFileInput.dispatchEvent(event);
      // Reset input
      target.value = '';
    }
  });

  // Save new row button
  document.querySelectorAll('[data-action="save-new-row"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget;
      const row = button.closest('[data-new-row]');
      const input = row.querySelector('[data-new-field="input"]');
      const expectedOutput = row.querySelector('[data-new-field="expected_output"]');
      const feedback = row.querySelector('[data-new-field="feedback"]');

      const inputValue = input?.value?.trim();
      const expectedValue = expectedOutput?.value?.trim();

      if (!inputValue || !expectedValue) {
        // Show error state on empty fields
        if (!inputValue) input?.classList.add('textarea-error');
        if (!expectedValue) expectedOutput?.classList.add('textarea-error');
        setTimeout(() => {
          input?.classList.remove('textarea-error');
          expectedOutput?.classList.remove('textarea-error');
        }, 2000);
        return;
      }

      const newRow = {
        input: inputValue,
        expected_output: expectedValue,
        feedback: feedback?.value?.trim() || '',
      };

      console.log('Saving new row:', newRow);

      // Dispatch custom event
      const event = new CustomEvent('new-row-save', {
        bubbles: true,
        detail: newRow,
      });
      button.dispatchEvent(event);

      // Show success state
      button.classList.add('btn-success');
      button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>`;

      // Clear form after delay
      setTimeout(() => {
        if (input) input.value = '';
        if (expectedOutput) expectedOutput.value = '';
        if (feedback) feedback.value = '';
        button.classList.remove('btn-success');
        button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>`;
      }, 1500);
    });
  });

  // Initialize checkboxes on load
  updateCheckboxes();
</script>

<style>
  /* Fix zebra striping for sticky columns */
  #training-pairs-table tbody tr:nth-child(even) .sticky-col {
    background-color: hsl(var(--b2));
  }

  #training-pairs-table tbody tr:nth-child(odd) .sticky-col {
    background-color: hsl(var(--b1));
  }

  #training-pairs-table tbody tr:hover .sticky-col {
    background-color: hsl(var(--bc) / 0.1);
  }
</style>
