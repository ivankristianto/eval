---
/**
 * TrainingPairsTable Component
 *
 * Unified table displaying all training pair data with inline actions.
 * Columns: checkbox, input, expected_output, generated_output, rating (Pass/Fail), feedback, actions
 *
 * @param pairs - Array of training pair objects with results
 * @param selectable - Whether to show checkboxes for selection (default: true)
 * @param showActions - Whether to show inline actions (default: true)
 */

import PassFailBadge from './PassFailBadge.astro';

interface TrainingPairResult {
  id: string;
  input: string;
  expected_output: string;
  generated_output?: string;
  judge_rating?: 'pass' | 'fail';
  judge_feedback?: string;
  human_rating?: 'pass' | 'fail';
  human_feedback?: string;
}

interface Props {
  pairs: TrainingPairResult[];
  selectable?: boolean;
  showActions?: boolean;
}

const { pairs, selectable = true, showActions = true } = Astro.props;

const truncateText = (text: string, maxLength: number = 100) => {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength) + '...';
};
---

<div class="card bg-base-100 shadow-md">
  <div class="card-body p-0">
    <!-- Table Header Actions -->
    <div class="flex items-center justify-between p-4 border-b border-base-300">
      <div class="flex items-center gap-3">
        {selectable && (
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              class="checkbox checkbox-sm"
              id="select-all-pairs"
            />
            <span class="text-sm font-semibold">Select All</span>
          </label>
        )}
        <span class="text-sm text-base-content/70">
          {pairs.length} training pairs
        </span>
      </div>
      <div class="flex items-center gap-2">
        <button
          class="btn btn-sm btn-primary"
          data-action="evaluate-selected"
          disabled
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Evaluate Selected
        </button>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="table table-sm table-zebra">
        <thead class="bg-base-200">
          <tr>
            {selectable && <th class="w-12"></th>}
            <th class="w-1/6">Input</th>
            <th class="w-1/6">Expected Output</th>
            <th class="w-1/6">Generated Output</th>
            <th class="w-24 text-center">Judge Rating</th>
            <th class="w-1/6">Judge Feedback</th>
            <th class="w-24 text-center">Human Rating</th>
            <th class="w-1/6">Human Feedback</th>
            {showActions && <th class="w-16"></th>}
          </tr>
        </thead>
        <tbody>
          {pairs.map((pair, index) => (
            <tr class="hover" data-pair-id={pair.id}>
              {selectable && (
                <td>
                  <input
                    type="checkbox"
                    class="checkbox checkbox-xs pair-checkbox"
                    data-pair-id={pair.id}
                  />
                </td>
              )}
              <td>
                <div class="text-xs" title={pair.input}>
                  {truncateText(pair.input, 80)}
                </div>
              </td>
              <td>
                <div class="text-xs" title={pair.expected_output}>
                  {truncateText(pair.expected_output, 80)}
                </div>
              </td>
              <td>
                {pair.generated_output ? (
                  <div class="text-xs" title={pair.generated_output}>
                    {truncateText(pair.generated_output, 80)}
                  </div>
                ) : (
                  <span class="text-xs opacity-50 italic">Not generated</span>
                )}
              </td>
              <td class="text-center">
                <PassFailBadge rating={pair.judge_rating} size="sm" />
              </td>
              <td>
                {pair.judge_feedback ? (
                  <div class="text-xs opacity-70" title={pair.judge_feedback}>
                    {truncateText(pair.judge_feedback, 60)}
                  </div>
                ) : (
                  <span class="text-xs opacity-50 italic">-</span>
                )}
              </td>
              <td class="text-center">
                {pair.human_rating ? (
                  <PassFailBadge rating={pair.human_rating} size="sm" />
                ) : (
                  <div class="flex gap-1 justify-center">
                    <button
                      class="btn btn-xs btn-success"
                      data-action="human-rate"
                      data-pair-id={pair.id}
                      data-rating="pass"
                      title="Mark as Pass"
                    >
                      ✓
                    </button>
                    <button
                      class="btn btn-xs btn-error"
                      data-action="human-rate"
                      data-pair-id={pair.id}
                      data-rating="fail"
                      title="Mark as Fail"
                    >
                      ✗
                    </button>
                  </div>
                )}
              </td>
              <td>
                {pair.human_feedback ? (
                  <div class="text-xs opacity-70" title={pair.human_feedback}>
                    {truncateText(pair.human_feedback, 60)}
                  </div>
                ) : (
                  <button
                    class="btn btn-xs btn-ghost"
                    data-action="add-feedback"
                    data-pair-id={pair.id}
                  >
                    Add note
                  </button>
                )}
              </td>
              {showActions && (
                <td>
                  <div class="dropdown dropdown-end">
                    <label tabindex="0" class="btn btn-ghost btn-xs">⋮</label>
                    <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-200 rounded-box w-52 text-sm">
                      <li><a data-action="view-details" data-pair-id={pair.id}>View Details</a></li>
                      <li><a data-action="regenerate" data-pair-id={pair.id}>Regenerate Output</a></li>
                      <li><a data-action="copy" data-pair-id={pair.id}>Copy to Clipboard</a></li>
                    </ul>
                  </div>
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    {pairs.length === 0 && (
      <div class="p-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto opacity-30 mb-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <h3 class="text-lg font-semibold mb-2">No Training Data</h3>
        <p class="text-sm text-base-content/70 mb-4">Upload a CSV file to add training pairs</p>
        <button class="btn btn-primary btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
          Upload CSV
        </button>
      </div>
    )}
  </div>
</div>

<script>
  // Select all functionality
  const selectAllCheckbox = document.getElementById('select-all-pairs') as HTMLInputElement;
  const pairCheckboxes = document.querySelectorAll('.pair-checkbox') as NodeListOf<HTMLInputElement>;
  const evaluateSelectedBtn = document.querySelector('[data-action="evaluate-selected"]') as HTMLButtonElement;

  selectAllCheckbox?.addEventListener('change', (e) => {
    const isChecked = (e.target as HTMLInputElement).checked;
    pairCheckboxes.forEach((checkbox) => {
      checkbox.checked = isChecked;
    });
    updateEvaluateButton();
  });

  pairCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      updateEvaluateButton();
    });
  });

  function updateEvaluateButton() {
    const selectedCount = Array.from(pairCheckboxes).filter(cb => cb.checked).length;
    if (evaluateSelectedBtn) {
      evaluateSelectedBtn.disabled = selectedCount === 0;
      evaluateSelectedBtn.textContent = selectedCount > 0
        ? `Evaluate Selected (${selectedCount})`
        : 'Evaluate Selected';
    }
  }

  // Human rating buttons
  document.querySelectorAll('[data-action="human-rate"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const pairId = button.dataset.pairId;
      const rating = button.dataset.rating;
      console.log(`Human rated pair ${pairId} as ${rating}`);

      // Dispatch custom event
      const event = new CustomEvent('human-rating', {
        bubbles: true,
        detail: { pairId, rating },
      });
      button.dispatchEvent(event);

      // Mock: Replace buttons with badge
      const td = button.closest('td');
      if (td) {
        td.innerHTML = `<span class="badge badge-sm ${rating === 'pass' ? 'badge-success' : 'badge-error'}">${rating}</span>`;
      }
    });
  });

  // Add feedback button
  document.querySelectorAll('[data-action="add-feedback"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLElement;
      const pairId = button.dataset.pairId;
      const feedback = prompt('Add feedback note:');
      if (feedback) {
        console.log(`Added feedback for pair ${pairId}:`, feedback);
        const td = button.closest('td');
        if (td) {
          td.innerHTML = `<div class="text-xs opacity-70" title="${feedback}">${feedback.substring(0, 60)}...</div>`;
        }
      }
    });
  });

  // Evaluate selected button
  evaluateSelectedBtn?.addEventListener('click', () => {
    const selectedIds = Array.from(pairCheckboxes)
      .filter(cb => cb.checked)
      .map(cb => cb.dataset.pairId);
    console.log('Evaluate selected pairs:', selectedIds);

    // Mock: Show loading
    evaluateSelectedBtn.classList.add('loading');
    setTimeout(() => {
      evaluateSelectedBtn.classList.remove('loading');
      alert(`Evaluated ${selectedIds.length} pairs!`);
    }, 2000);
  });
</script>
