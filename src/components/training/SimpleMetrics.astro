---
/**
 * SimpleMetrics Component
 *
 * Displays evaluation metrics for training data.
 * Shows F1 Score, Precision, Recall, Cohen's Kappa, and Confusion Matrix.
 * Aligned with metrics.astro scoring display for consistency.
 * Supports dynamic updates via data attributes for live polling.
 *
 * @param metrics - Object containing evaluation metrics
 * @param metricsHistory - Array of historical metrics for sparklines (last 5 iterations)
 */

import Sparkline from '@components/ui/Sparkline.astro';

interface MetricsData {
  f1_score?: number;
  precision?: number;
  recall?: number;
  cohens_kappa?: number;
  accuracy?: number;
  confusion_matrix?: {
    true_positives?: number;
    true_negatives?: number;
    false_positives?: number;
    false_negatives?: number;
  };
  total_pairs?: number;
}

interface HistoricalMetrics {
  f1_score?: number;
  precision?: number;
  recall?: number;
  cohens_kappa?: number;
  accuracy?: number;
}

interface Props {
  metrics?: MetricsData;
  judgeMetrics?: {
    total_pairs: number;
    pass_count: number;
    fail_count: number;
    pass_rate: number;
  };
  humanMetrics?: {
    total_pairs: number;
    pass_count: number;
    fail_count: number;
    pass_rate: number;
  };
  showComparison?: boolean;
  // Display variant: 'card' (default sidebar card) or 'compact' (horizontal dashboard strip)
  variant?: 'card' | 'compact';
  // Historical metrics data for sparklines (last 5 iterations)
  metricsHistory?: HistoricalMetrics[];
}

// Support both new metrics format and legacy judge/human format
const { metrics, judgeMetrics, humanMetrics, variant = 'card', metricsHistory = [] } = Astro.props;

// Extract historical data for sparklines (last 5 iterations)
const getHistoricalValues = (metricKey: keyof HistoricalMetrics): number[] => {
  if (!metricsHistory || metricsHistory.length === 0) return [];
  // Get last 5 values for the metric
  const last5 = metricsHistory.slice(-5);
  return last5.map((m) => m[metricKey] ?? 0).filter((v) => v > 0);
};

const f1History = getHistoricalValues('f1_score');
const precisionHistory = getHistoricalValues('precision');
const recallHistory = getHistoricalValues('recall');
const kappaHistory = getHistoricalValues('cohens_kappa');

// Use new metrics if provided, otherwise fall back to legacy format
const displayMetrics = metrics || {
  f1_score: judgeMetrics?.pass_rate || 0,
  precision: judgeMetrics?.pass_rate || 0,
  recall: humanMetrics?.pass_rate || 0,
  cohens_kappa: 0.7,
  total_pairs: judgeMetrics?.total_pairs || 0,
};

const formatPercentage = (value: number | undefined) => {
  if (value === undefined || value === null) return 'N/A';
  return `${(value * 100).toFixed(1)}%`;
};

const formatNumber = (value: number | undefined) => {
  if (value === undefined || value === null) return 'N/A';
  return value.toString();
};
---

<div
  id="simple-metrics-card"
  class:list={[
    'overflow-hidden',
    variant === 'card'
      ? 'card-luxe'
      : 'border bg-base-100/90 backdrop-blur-sm rounded-xl shadow-lg',
  ]}
  data-metrics-container="true"
  data-variant={variant}
>
  <div class:list={[variant === 'card' ? 'card-body p-4' : 'p-3']}>
    {
      variant === 'card' && (
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-5 rounded-full bg-gradient-gold" />
          <h3 class="card-title text-sm font-semibold">Evaluation Metrics</h3>
        </div>
      )
    }

    <!-- Primary Metrics Grid -->
    <div
      class:list={[
        'grid gap-3',
        variant === 'card' ? 'grid-cols-2 mb-4' : 'grid-cols-4 lg:grid-cols-6',
      ]}
    >
      <!-- F1 Score - Highlighted -->
      <div
        class:list={[
          'stat rounded-lg shadow-md border',
          variant === 'card'
            ? 'bg-base-100 px-3 py-3 border-luxe-gold/20'
            : 'bg-base-100/60 px-2 py-2 border-luxe-gold/20',
        ]}
      >
        <div class="flex items-center justify-between gap-1 mb-1">
          <span class="metric-label">F1</span>
          {
            f1History.length > 1 && (
              <div class="w-16 h-8">
                <Sparkline data={f1History} color="gold" width={64} height={32} strokeWidth={1.5} />
              </div>
            )
          }
        </div>
        <div
          class:list={[
            'metric-display text-luxe-gold',
            variant === 'card' ? 'text-4xl' : 'text-2xl',
          ]}
          data-metric="f1_score"
          data-value={displayMetrics.f1_score ?? 0}
        >
          {formatPercentage(displayMetrics.f1_score)}
        </div>
      </div>

      <!-- Cohen's Kappa - Highlighted -->
      <div
        class:list={[
          'stat rounded-lg shadow-md border',
          variant === 'card'
            ? 'bg-base-100 px-3 py-3 border-luxe-gold/20'
            : 'bg-base-100/60 px-2 py-2 border-luxe-gold/20',
        ]}
      >
        <div class="flex items-center justify-between gap-1 mb-1">
          <span class="metric-label">Kappa</span>
          {
            kappaHistory.length > 1 && (
              <div class="w-16 h-8">
                <Sparkline
                  data={kappaHistory}
                  color="gold"
                  width={64}
                  height={32}
                  strokeWidth={1.5}
                />
              </div>
            )
          }
        </div>
        <div
          class:list={[
            'metric-display text-luxe-gold',
            variant === 'card' ? 'text-3xl' : 'text-xl',
          ]}
          data-metric="cohens_kappa"
          data-value={displayMetrics.cohens_kappa ?? 0}
        >
          {displayMetrics.cohens_kappa?.toFixed(3) || 'N/A'}
        </div>
      </div>

      <!-- Precision -->
      <div
        class:list={[
          'stat rounded-lg shadow-sm border',
          variant === 'card'
            ? 'bg-base-100/60 px-3 py-2.5 border-luxe-emerald/20'
            : 'bg-base-100/60 px-2 py-2 border-luxe-emerald/20',
        ]}
      >
        <div class="flex items-center justify-between gap-1 mb-1">
          <span class="metric-label">Prec.</span>
          {
            precisionHistory.length > 1 && (
              <div class="w-16 h-8">
                <Sparkline
                  data={precisionHistory}
                  color="emerald"
                  width={64}
                  height={32}
                  strokeWidth={1.5}
                />
              </div>
            )
          }
        </div>
        <div
          class:list={[
            'metric-display metric-success',
            variant === 'card' ? 'text-2xl' : 'text-xl',
          ]}
          data-metric="precision"
          data-value={displayMetrics.precision ?? 0}
        >
          {formatPercentage(displayMetrics.precision)}
        </div>
      </div>

      <!-- Recall -->
      <div
        class:list={[
          'stat rounded-lg shadow-sm border',
          variant === 'card'
            ? 'bg-base-100/60 px-3 py-2.5 border-luxe-emerald/20'
            : 'bg-base-100/60 px-2 py-2 border-luxe-emerald/20',
        ]}
      >
        <div class="flex items-center justify-between gap-1 mb-1">
          <span class="metric-label">Recall</span>
          {
            recallHistory.length > 1 && (
              <div class="w-16 h-8">
                <Sparkline
                  data={recallHistory}
                  color="emerald"
                  width={64}
                  height={32}
                  strokeWidth={1.5}
                />
              </div>
            )
          }
        </div>
        <div
          class:list={[
            'metric-display metric-success',
            variant === 'card' ? 'text-2xl' : 'text-xl',
          ]}
          data-metric="recall"
          data-value={displayMetrics.recall ?? 0}
        >
          {formatPercentage(displayMetrics.recall)}
        </div>
      </div>
    </div>

    <!-- Confusion Matrix (only in card variant) -->
    {
      variant === 'card' && displayMetrics.confusion_matrix && (
        <div
          class="bg-base-100/80 rounded-lg p-3 shadow-md border border-luxe-gold/20 mb-3"
          data-confusion-matrix="true"
        >
          <div class="metric-label mb-3 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-luxe-gold" />
            Confusion Matrix
          </div>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
            <div class="flex justify-between items-center">
              <span class="opacity-60">True Positives</span>
              <span
                class="font-mono font-bold text-luxe-emerald metric-success"
                data-metric="true_positives"
                data-value={displayMetrics.confusion_matrix.true_positives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.true_positives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">True Negatives</span>
              <span
                class="font-mono font-bold text-luxe-emerald metric-success"
                data-metric="true_negatives"
                data-value={displayMetrics.confusion_matrix.true_negatives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.true_negatives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">False Positives</span>
              <span
                class="font-mono font-bold text-luxe-ruby"
                data-metric="false_positives"
                data-value={displayMetrics.confusion_matrix.false_positives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.false_positives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">False Negatives</span>
              <span
                class="font-mono font-bold text-luxe-ruby"
                data-metric="false_negatives"
                data-value={displayMetrics.confusion_matrix.false_negatives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.false_negatives)}
              </span>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>
