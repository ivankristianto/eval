---
/**
 * SimpleMetrics Component
 *
 * Displays evaluation metrics for training data.
 * Shows F1 Score, Precision, Recall, Cohen's Kappa, and Confusion Matrix.
 * Aligned with metrics.astro scoring display for consistency.
 * Supports dynamic updates via data attributes for live polling.
 *
 * @param metrics - Object containing evaluation metrics
 */

import InfoIcon from '@components/icons/InfoIcon.astro';

const metricDefinitions = {
  f1: 'The harmonic mean of precision and recall, providing a balanced measure of model performance.',
  kappa:
    'A statistic measuring inter-rater agreement between judge and human ratings, accounting for chance.',
  precision:
    'The proportion of positive predictions that are actually correct (true positives / all predicted positives).',
  recall:
    'The proportion of actual positives that were correctly identified (true positives / all actual positives).',
};

interface MetricsData {
  f1_score?: number;
  precision?: number;
  recall?: number;
  cohens_kappa?: number;
  accuracy?: number;
  confusion_matrix?: {
    true_positives?: number;
    true_negatives?: number;
    false_positives?: number;
    false_negatives?: number;
  };
  total_pairs?: number;
}

interface Props {
  metrics?: MetricsData;
  judgeMetrics?: {
    total_pairs: number;
    pass_count: number;
    fail_count: number;
    pass_rate: number;
  };
  humanMetrics?: {
    total_pairs: number;
    pass_count: number;
    fail_count: number;
    pass_rate: number;
  };
  showComparison?: boolean;
}

// Support both new metrics format and legacy judge/human format
const { metrics, judgeMetrics, humanMetrics } = Astro.props;

// Use new metrics if provided, otherwise fall back to legacy format
const displayMetrics = metrics || {
  f1_score: judgeMetrics?.pass_rate || 0,
  precision: judgeMetrics?.pass_rate || 0,
  recall: humanMetrics?.pass_rate || 0,
  cohens_kappa: 0.7,
  total_pairs: judgeMetrics?.total_pairs || 0,
};

const formatPercentage = (value: number | undefined) => {
  if (value === undefined || value === null) return 'N/A';
  return `${(value * 100).toFixed(1)}%`;
};

const formatNumber = (value: number | undefined) => {
  if (value === undefined || value === null) return 'N/A';
  return value.toString();
};
---

<div
  id="simple-metrics-card"
  class="card bg-gradient-to-br from-base-200 to-base-100 border border-base-300/50 shadow-lg rounded-xl overflow-hidden"
  data-metrics-container="true"
>
  <div class="card-body p-4">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-1 h-5 rounded-full bg-gradient-to-b from-primary to-primary/50"></div>
      <h3 class="card-title text-sm font-semibold">Evaluation Metrics</h3>
    </div>

    <!-- Primary Metrics Grid -->
    <div class="grid grid-cols-2 gap-3 mb-4">
      <!-- F1 Score - Highlighted -->
      <div class="stat bg-base-100 rounded-lg px-3 py-3 shadow-md border border-primary/10">
        <div class="flex items-center gap-1.5 mb-1">
          <span class="text-xs font-medium opacity-70">F1 Score</span>
          <div class="dropdown dropdown-end">
            <div
              tabindex="0"
              role="button"
              aria-label="Learn more about F1 Score"
              class="btn btn-circle btn-ghost btn-xs text-info opacity-60 hover:opacity-100"
            >
              <InfoIcon size="xs" />
            </div>
            <div
              tabindex="0"
              class="card card-sm dropdown-content bg-base-100 rounded-box z-1 w-64 shadow-sm"
            >
              <div class="card-body p-3">
                <p class="text-sm leading-relaxed text-base-content/80">
                  {metricDefinitions.f1}
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="stat-value text-2xl font-mono font-bold text-primary tracking-tight"
          data-metric="f1_score"
          data-value={displayMetrics.f1_score ?? 0}
        >
          {formatPercentage(displayMetrics.f1_score)}
        </div>
      </div>

      <!-- Cohen's Kappa - Highlighted -->
      <div class="stat bg-base-100 rounded-lg px-3 py-3 shadow-md border border-secondary/10">
        <div class="flex items-center gap-1.5 mb-1">
          <span class="text-xs font-medium opacity-70">Cohen's Kappa</span>
          <div class="dropdown dropdown-end">
            <div
              tabindex="0"
              role="button"
              aria-label="Learn more about Cohen's Kappa"
              class="btn btn-circle btn-ghost btn-xs text-info opacity-60 hover:opacity-100"
            >
              <InfoIcon size="xs" />
            </div>
            <div
              tabindex="0"
              class="card card-sm dropdown-content bg-base-100 rounded-box z-1 w-64 shadow-sm"
            >
              <div class="card-body p-3">
                <p class="text-sm leading-relaxed text-base-content/80">
                  {metricDefinitions.kappa}
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="stat-value text-xl font-mono font-bold text-secondary tracking-tight"
          data-metric="cohens_kappa"
          data-value={displayMetrics.cohens_kappa ?? 0}
        >
          {displayMetrics.cohens_kappa?.toFixed(3) || 'N/A'}
        </div>
      </div>

      <!-- Precision -->
      <div class="stat bg-base-100/60 rounded-lg px-3 py-2.5 shadow-sm border border-success/10">
        <div class="flex items-center gap-1.5 mb-0.5">
          <span class="text-xs font-medium opacity-60">Precision</span>
          <div class="dropdown dropdown-end">
            <div
              tabindex="0"
              role="button"
              aria-label="Learn more about Precision"
              class="btn btn-circle btn-ghost btn-xs text-info opacity-60 hover:opacity-100"
            >
              <InfoIcon size="xs" />
            </div>
            <div
              tabindex="0"
              class="card card-sm dropdown-content bg-base-100 rounded-box z-1 w-64 shadow-sm"
            >
              <div class="card-body p-3">
                <p class="text-sm leading-relaxed text-base-content/80">
                  {metricDefinitions.precision}
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="stat-value text-lg font-mono font-semibold text-success tracking-tight"
          data-metric="precision"
          data-value={displayMetrics.precision ?? 0}
        >
          {formatPercentage(displayMetrics.precision)}
        </div>
      </div>

      <!-- Recall -->
      <div class="stat bg-base-100/60 rounded-lg px-3 py-2.5 shadow-sm border border-info/10">
        <div class="flex items-center gap-1.5 mb-0.5">
          <span class="text-xs font-medium opacity-60">Recall</span>
          <div class="dropdown dropdown-end">
            <div
              tabindex="0"
              role="button"
              aria-label="Learn more about Recall"
              class="btn btn-circle btn-ghost btn-xs text-info opacity-60 hover:opacity-100"
            >
              <InfoIcon size="xs" />
            </div>
            <div
              tabindex="0"
              class="card card-sm dropdown-content bg-base-100 rounded-box z-1 w-64 shadow-sm"
            >
              <div class="card-body p-3">
                <p class="text-sm leading-relaxed text-base-content/80">
                  {metricDefinitions.recall}
                </p>
              </div>
            </div>
          </div>
        </div>
        <div
          class="stat-value text-lg font-mono font-semibold text-info tracking-tight"
          data-metric="recall"
          data-value={displayMetrics.recall ?? 0}
        >
          {formatPercentage(displayMetrics.recall)}
        </div>
      </div>
    </div>

    <!-- Confusion Matrix -->
    {
      displayMetrics.confusion_matrix && (
        <div
          class="bg-base-100/80 rounded-lg p-3 shadow-md border border-base-300/50 mb-3"
          data-confusion-matrix="true"
        >
          <div class="text-xs font-semibold mb-3 opacity-70 flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-base-content/40" />
            Confusion Matrix
          </div>
          <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
            <div class="flex justify-between items-center">
              <span class="opacity-60">True Positives</span>
              <span
                class="font-mono font-bold text-success"
                data-metric="true_positives"
                data-value={displayMetrics.confusion_matrix.true_positives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.true_positives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">True Negatives</span>
              <span
                class="font-mono font-bold text-success"
                data-metric="true_negatives"
                data-value={displayMetrics.confusion_matrix.true_negatives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.true_negatives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">False Positives</span>
              <span
                class="font-mono font-bold text-error"
                data-metric="false_positives"
                data-value={displayMetrics.confusion_matrix.false_positives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.false_positives)}
              </span>
            </div>
            <div class="flex justify-between items-center">
              <span class="opacity-60">False Negatives</span>
              <span
                class="font-mono font-bold text-error"
                data-metric="false_negatives"
                data-value={displayMetrics.confusion_matrix.false_negatives ?? 0}
              >
                {formatNumber(displayMetrics.confusion_matrix.false_negatives)}
              </span>
            </div>
          </div>
        </div>
      )
    }

    <!-- Total Pairs -->
    {
      displayMetrics.total_pairs && (
        <div class="flex justify-between items-center text-xs pt-3 border-t border-base-300/50">
          <span class="text-base-content/60 font-medium">Total Pairs</span>
          <span
            class="font-bold font-mono text-base-content/80"
            data-metric="total_pairs"
            data-value={displayMetrics.total_pairs}
          >
            {displayMetrics.total_pairs}
          </span>
        </div>
      )
    }
  </div>
</div>
