---
/**
 * TrainingWorkspace Layout Component
 *
 * Main workspace layout with split view:
 * - Left panel (30%): Task and Judge prompt editors stacked
 * - Right panel (70%): Training pairs table and metrics
 *
 * @param personaId - Persona ID for data loading
 * @param personaName - Persona display name
 * @param taskPrompt - Mock task prompt configuration
 * @param judgePrompt - Mock judge prompt configuration
 * @param trainingPairs - Mock training pairs data
 * @param metrics - Mock metrics data
 */

import PromptEditor from './PromptEditor.astro';
import TrainingPairsTable from './TrainingPairsTable.astro';
import SimpleMetrics from './SimpleMetrics.astro';
import OptimizationSuggestion from './OptimizationSuggestion.astro';

interface PromptConfig {
  text: string;
  versions: Array<{
    version_number: number;
    created_by: 'human' | 'ai';
    created_at: string;
    improvement_rationale?: string;
  }>;
  selectedVersion: number;
}

interface TrainingPair {
  id: string;
  input: string;
  expected_output: string;
  generated_output?: string;
  judge_rating?: 'pass' | 'fail';
  judge_feedback?: string;
  human_rating?: 'pass' | 'fail';
  human_feedback?: string;
}

interface MetricsData {
  total_pairs: number;
  pass_count: number;
  fail_count: number;
  pass_rate: number;
}

interface NewMetricsData {
  f1_score?: number;
  precision?: number;
  recall?: number;
  cohens_kappa?: number;
  accuracy?: number;
  confusion_matrix?: {
    true_positives?: number;
    true_negatives?: number;
    false_positives?: number;
    false_negatives?: number;
  };
  total_pairs?: number;
}

interface Props {
  personaId: string;
  personaName: string;
  taskPrompt: PromptConfig;
  judgePrompt: PromptConfig;
  trainingPairs: TrainingPair[];
  metrics?: NewMetricsData;
  judgeMetrics?: MetricsData;
  humanMetrics?: MetricsData;
}

const {
  personaId,
  personaName,
  taskPrompt,
  judgePrompt,
  trainingPairs,
  metrics,
  judgeMetrics,
  humanMetrics,
} = Astro.props;
---

<div class="flex flex-col flex-1 min-h-0 bg-gradient-to-b from-base-100 to-base-200/30">
  <!-- Header -->
  <div
    class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 px-6 py-5 border-b border-base-300/80 bg-base-100/50 backdrop-blur-sm flex-shrink-0"
  >
    <div>
      <div class="flex items-center gap-3 mb-1">
        <h1 class="text-2xl font-bold tracking-tight">{personaName}</h1>
        <div class="badge badge-ghost badge-sm font-mono">
          v{taskPrompt.selectedVersion}.{judgePrompt.selectedVersion}
        </div>
      </div>
      <p class="text-sm text-base-content/60">Training Workspace</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <!-- Polling Status Indicator -->
      <div
        id="polling-status"
        class="hidden items-center gap-2 text-sm text-info px-3 py-1 bg-info/10 rounded-lg"
      >
        <span class="loading loading-spinner loading-xs"></span>
        <span>Updating...</span>
        <span id="polling-progress" class="text-info/70 font-mono"></span>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap gap-2">
        <button
          class="btn btn-sm shadow-md hover:shadow-lg transition-all duration-200"
          data-action="generate-outputs"
          data-persona-id={personaId}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path>
          </svg>
          Generate Outputs
        </button>
        <button
          class="btn btn-sm shadow-md hover:shadow-lg transition-all duration-200"
          data-action="generate-judge"
          data-persona-id={personaId}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
            ></path>
          </svg>
          Generate Judge
        </button>
        <button
          class="btn btn-sm btn-primary shadow-md hover:shadow-lg transition-all duration-200"
          data-action="evaluate-all"
          data-persona-id={personaId}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75m3 7.5V21a.75.75 0 01-.75.75h-4.5a.75.75 0 01-.75-.75v-4.5M9 12.75l3 .75M9 12.75l-.75-3M12 15.75l3-.75M12 15.75l.75-3M15 12.75l-.75 3"
            ></path>
          </svg>
          Evaluate All
        </button>
      </div>
    </div>
  </div>

  <!-- Main Workspace Grid -->
  <div class="flex-1 h-full overflow-hidden grid grid-cols-1 lg:grid-cols-12">
    <!-- Left Panel: Metrics & Prompts (3/12 = 25% width on lg screens) -->
    <div
      class="lg:col-span-3 overflow-y-auto p-4 pb-24 space-y-4 border-r border-base-300/50 bg-base-50/30"
    >
      <!-- Metrics Summary -->
      <SimpleMetrics metrics={metrics} judgeMetrics={judgeMetrics} humanMetrics={humanMetrics} />

      <!-- Task Prompt Editor -->
      <PromptEditor
        type="task"
        promptText={taskPrompt.text}
        versions={taskPrompt.versions}
        selectedVersion={taskPrompt.selectedVersion}
      />

      <!-- Judge Prompt Editor -->
      <PromptEditor
        type="judge"
        promptText={judgePrompt.text}
        versions={judgePrompt.versions}
        selectedVersion={judgePrompt.selectedVersion}
      />
    </div>

    <!-- Right Panel: Table (9/12 = 75% width on lg screens) -->
    <div class="lg:col-span-9 h-full flex flex-col overflow-hidden p-4">
      <TrainingPairsTable pairs={trainingPairs} personaId={personaId} />
    </div>
  </div>

  <!-- Optimization Suggestion Modals (hidden by default) -->
  <OptimizationSuggestion
    type="task"
    currentPrompt={taskPrompt.text}
    suggestedPrompt="Write a detailed response that answers the user's question about {topic}. Include:\n1. A clear explanation of the concept\n2. Relevant examples\n3. Common misconceptions to avoid\n\nEnsure the response is beginner-friendly and uses simple language."
    rationale="Added structure with numbered list for clarity. Specified 'beginner-friendly' and 'simple language' to address cases where previous outputs were too technical. These changes directly address the 5 failed examples where responses lacked structure."
    modalId="optimization-modal-task"
    personaId={personaId}
  />

  <OptimizationSuggestion
    type="judge"
    currentPrompt={judgePrompt.text}
    suggestedPrompt="Evaluate if the generated output correctly addresses the user's question.\n\nCheck that the output:\n- Directly answers the question asked\n- Provides accurate information\n- Includes relevant examples when appropriate\n- Avoids hallucinations or unsupported claims\n\nMark as PASS only if all criteria are met. Mark as FAIL if any criterion is not satisfied, and explain which specific criterion failed."
    rationale="Added explicit evaluation criteria with bullet points. Specified 'mark as PASS only if ALL criteria are met' to reduce false positives. Added requirement to explain which criterion failed to improve feedback quality."
    modalId="optimization-modal-judge"
    personaId={personaId}
  />
</div>

<script>
  // Generate outputs action
  document.querySelectorAll('[data-action="generate-outputs"]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement | null;
      if (!button) return;
      const personaId = button.dataset.personaId;
      const buttonSelector = '[data-action="generate-outputs"]';
      const originalContent = button.innerHTML;

      try {
        // Show loading state
        button.classList.add('loading');
        button.setAttribute('disabled', 'true');

        const response = await fetch('/api/task/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona_id: personaId }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Failed to generate outputs');
        }

        // Show success notification
        if (window.toast) {
          window.toast.success(
            `Generated ${result.processed_pairs} outputs successfully! Watching for updates...`
          );
        }

        // Start polling for real-time updates
        document.dispatchEvent(new CustomEvent('operation-started'));
      } catch (error) {
        console.error('Generate outputs error:', error);
        if (window.toast) {
          window.toast.error(error instanceof Error ? error.message : 'Failed to generate outputs');
        }
      } finally {
        // Re-query to get current DOM element (fixes race condition)
        const currentButton = document.querySelector(buttonSelector);
        if (currentButton) {
          currentButton.classList.remove('loading');
          currentButton.removeAttribute('disabled');
          currentButton.innerHTML = originalContent;
        }
      }
    });
  });

  // Generate judge decision action
  document.querySelectorAll('[data-action="generate-judge"]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement | null;
      if (!button) return;
      const personaId = button.dataset.personaId;
      const buttonSelector = '[data-action="generate-judge"]';
      const originalContent = button.innerHTML;

      try {
        // Show loading state
        button.classList.add('loading');
        button.setAttribute('disabled', 'true');

        const response = await fetch('/api/judge/evaluate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona_id: personaId }),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Failed to generate judge decisions');
        }

        // Show success notification
        if (window.toast) {
          window.toast.success(
            `Evaluated ${result.evaluated_results} results with judge! Watching for updates...`
          );
        }

        // Start polling for real-time updates
        document.dispatchEvent(new CustomEvent('operation-started'));
      } catch (error) {
        console.error('Generate judge error:', error);
        if (window.toast) {
          window.toast.error(
            error instanceof Error ? error.message : 'Failed to generate judge decisions'
          );
        }
      } finally {
        // Re-query to get current DOM element (fixes race condition)
        const currentButton = document.querySelector(buttonSelector);
        if (currentButton) {
          currentButton.classList.remove('loading');
          currentButton.removeAttribute('disabled');
          currentButton.innerHTML = originalContent;
        }
      }
    });
  });

  // Evaluate all action (generate outputs + judge decisions)
  document.querySelectorAll('[data-action="evaluate-all"]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement | null;
      if (!button) return;
      const personaId = button.dataset.personaId;
      const buttonSelector = '[data-action="evaluate-all"]';
      const originalContent = button.innerHTML;

      try {
        // Show loading state
        button.classList.add('loading');
        button.setAttribute('disabled', 'true');

        // Step 1: Generate task outputs
        const generateResponse = await fetch('/api/task/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona_id: personaId }),
        });

        const generateResult = await generateResponse.json();

        if (!generateResponse.ok) {
          throw new Error(generateResult.message || 'Failed to generate outputs');
        }

        if (window.toast) {
          window.toast.info(
            `Generated ${generateResult.processed_pairs} outputs. Now evaluating with judge...`
          );
        }

        // Step 2: Evaluate with judge
        const judgeResponse = await fetch('/api/judge/evaluate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ persona_id: personaId }),
        });

        const judgeResult = await judgeResponse.json();

        if (!judgeResponse.ok) {
          throw new Error(judgeResult.message || 'Failed to evaluate with judge');
        }

        // Show success notification
        if (window.toast) {
          window.toast.success(
            `Evaluation complete! Processed ${judgeResult.evaluated_results} results. Watching for updates...`
          );
        }

        // Start polling for real-time updates
        document.dispatchEvent(new CustomEvent('operation-started'));
      } catch (error) {
        console.error('Evaluate all error:', error);
        if (window.toast) {
          window.toast.error(error instanceof Error ? error.message : 'Failed to evaluate all');
        }
      } finally {
        // Re-query to get current DOM element (fixes race condition)
        const currentButton = document.querySelector(buttonSelector);
        if (currentButton) {
          currentButton.classList.remove('loading');
          currentButton.removeAttribute('disabled');
          currentButton.innerHTML = originalContent;
        }
      }
    });
  });

  // Handle prompt optimization events from PromptEditor
  document.addEventListener('prompt-optimize', async (e) => {
    const { type, currentText } = (e as CustomEvent<{ type: string; currentText: string }>).detail;

    try {
      const response = await fetch('/api/prompts/optimize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt_text: currentText,
          prompt_type: type,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to optimize prompt');
      }

      // Update the optimization modal with the results
      const modalId = `optimization-modal-${type}`;
      const modal = document.getElementById(modalId);

      if (modal) {
        // Update modal content dynamically
        const rationaleEl = modal.querySelector('.alert-info p');
        const suggestedCodeEl = modal.querySelectorAll('.mockup-code pre code')[1];

        if (rationaleEl) rationaleEl.textContent = result.rationale;
        if (suggestedCodeEl) suggestedCodeEl.textContent = result.suggested_prompt;

        // Show the modal
        const modalCheckbox = document.getElementById(modalId) as HTMLInputElement | null;
        if (modalCheckbox) modalCheckbox.checked = true;
      }

      if (window.toast) {
        window.toast.success('Optimization suggestion ready!');
      }
    } catch (error) {
      console.error('Optimize prompt error:', error);
      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to optimize prompt');
      }
    }
  });

  // Handle version-load events from PromptEditor
  document.addEventListener('version-load', async (e) => {
    const { type, version } = (e as CustomEvent<{ type: string; version: number }>).detail;

    // Get persona ID from the page
    const personaIdElement = document.querySelector('[data-persona-id]') as HTMLElement | null;
    const personaId = personaIdElement?.dataset.personaId;

    if (!personaId) {
      console.error('No persona_id found on page');
      if (window.toast) {
        window.toast.error('Failed to load version: Missing persona ID');
      }
      return;
    }

    try {
      // Fetch versions based on prompt type
      let versions: Array<{ version_number: number; prompt_text: string }>;

      if (type === 'task') {
        const response = await fetch(`/api/prompts/task/versions?persona_id=${personaId}`);
        if (!response.ok) {
          throw new Error('Failed to fetch task prompt versions');
        }
        const data = await response.json();
        versions = data.versions || [];
      } else {
        // judge type
        const response = await fetch(`/api/personas/${personaId}/prompts`);
        if (!response.ok) {
          throw new Error('Failed to fetch judge prompt versions');
        }
        const data = await response.json();
        versions = data.prompts || [];
      }

      // Find the matching version
      const matchedVersion = versions.find((v) => v.version_number === version);

      if (matchedVersion) {
        // Update the textarea
        const textareaId = `${type}-prompt-editor`;
        const textarea = document.getElementById(textareaId) as HTMLTextAreaElement | null;

        if (textarea) {
          textarea.value = matchedVersion.prompt_text;

          // Update char count
          const charCountLabel = textarea
            .closest('.card')
            ?.querySelector('.label-text-alt') as HTMLElement;
          if (charCountLabel) {
            charCountLabel.textContent = `${matchedVersion.prompt_text.length} chars`;
          }

          if (window.toast) {
            window.toast.success(`Loaded ${type} prompt version ${version}`);
          }
        } else {
          console.error(`Textarea not found: ${textareaId}`);
        }
      } else {
        console.error(`Version ${version} not found for ${type} prompt`);
        if (window.toast) {
          window.toast.error(`Version ${version} not found`);
        }
      }
    } catch (error) {
      console.error('Load version error:', error);
      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to load version');
      }
    }
  });

  // Real-time polling for training pairs updates
  let pollingInterval: ReturnType<typeof setInterval> | null = null;
  let isPolling = false;
  let consecutiveErrors = 0;
  const MAX_CONSECUTIVE_ERRORS = 5;

  /**
   * Helper to add flash animation with proper timer cleanup
   * Prevents memory leaks by clearing previous timers
   */
  function flashElement(element: Element, className = 'bg-success/10', duration = 1000) {
    // Clear any existing timer on this element
    const animationTimer = (
      element as unknown as { _animationTimer: ReturnType<typeof setTimeout> | null }
    )._animationTimer;
    if (animationTimer) {
      clearTimeout(animationTimer);
    }

    // Add the flash class
    element.classList.add(className);

    // Set timer to remove it
    (
      element as unknown as { _animationTimer: ReturnType<typeof setTimeout> | null }
    )._animationTimer = setTimeout(() => {
      element.classList.remove(className);
      (
        element as unknown as { _animationTimer: ReturnType<typeof setTimeout> | null }
      )._animationTimer = null;
    }, duration);
  }

  /**
   * Show/hide polling status indicator
   */
  function setPollingStatus(visible: boolean, progress?: string) {
    const statusEl = document.getElementById('polling-status');
    const progressEl = document.getElementById('polling-progress');

    if (!statusEl) return;

    if (visible) {
      statusEl.classList.remove('hidden');
      statusEl.classList.add('flex');
      if (progress && progressEl) {
        progressEl.textContent = progress;
      }
    } else {
      statusEl.classList.add('hidden');
      statusEl.classList.remove('flex');
      if (progressEl) {
        progressEl.textContent = '';
      }
    }
  }

  /**
   * Start polling for training pairs updates
   */
  function startPolling(personaId: string) {
    if (isPolling) {
      console.log('Polling already active, skipping...');
      return;
    }

    isPolling = true;
    consecutiveErrors = 0;
    console.log('Starting real-time polling for training pairs updates...');
    setPollingStatus(true);

    // Poll every 3 seconds (fixed interval per user requirements)
    pollingInterval = setInterval(async () => {
      try {
        const response = await fetch(`/api/personas/${personaId}/training/pairs-with-results`);

        if (!response.ok) {
          consecutiveErrors++;
          console.error(
            `Polling error (${consecutiveErrors}/${MAX_CONSECUTIVE_ERRORS}):`,
            response.status
          );

          if (consecutiveErrors >= MAX_CONSECUTIVE_ERRORS) {
            stopPolling();
            if (window.toast) {
              window.toast.error('Polling stopped after multiple errors. Please refresh the page.');
            }
          }
          return;
        }

        // Reset error counter on successful response
        consecutiveErrors = 0;

        const data = await response.json();

        // Update the table with new data
        updateTrainingPairsTable(data.pairs);

        // Update polling status with progress
        if (data.stats) {
          const generatedCount = data.stats.with_generated_output || 0;
          const totalCount = data.stats.total_pairs || 0;
          setPollingStatus(true, `${generatedCount}/${totalCount}`);
        }

        // Check if we should stop polling (all pairs have judge ratings)
        const allHaveResults =
          data.stats.total_pairs > 0 && data.stats.with_judge_rating === data.stats.total_pairs;

        if (allHaveResults) {
          stopPolling();
          if (window.toast) {
            window.toast.success(`All ${data.stats.total_pairs} pairs evaluated successfully!`);
          }
        }
      } catch (error) {
        consecutiveErrors++;
        console.error(`Polling error (${consecutiveErrors}/${MAX_CONSECUTIVE_ERRORS}):`, error);

        if (consecutiveErrors >= MAX_CONSECUTIVE_ERRORS) {
          stopPolling();
          if (window.toast) {
            window.toast.error(
              'Polling stopped after multiple errors. Please check your connection and refresh.'
            );
          }
        }
      }
    }, 3000);
  }

  /**
   * Stop polling for updates
   */
  function stopPolling() {
    if (pollingInterval) {
      clearInterval(pollingInterval);
      pollingInterval = null;
      isPolling = false;
      consecutiveErrors = 0;
      console.log('Stopped polling for updates');
      setPollingStatus(false);
    }
  }

  interface TrainingPairData {
    id: string;
    generated_output?: string;
    judge_rating?: string;
    judge_feedback?: string;
  }

  /**
   * Update the training pairs table with new data
   * Uses data-cell-type attributes for robust cell selection regardless of column position
   */
  function updateTrainingPairsTable(pairs: TrainingPairData[]) {
    const tbody = document.querySelector('#training-pairs-body');
    if (!tbody) return;

    // Validate input
    if (!pairs || !Array.isArray(pairs)) {
      console.error('Invalid pairs data:', pairs);
      return;
    }

    // Find all existing data rows (excluding the new-row template)
    const existingRows = tbody.querySelectorAll('tr:not([data-new-row])');

    // Update each row with new data
    pairs.forEach((pair) => {
      // Find row by pair ID instead of index to prevent race conditions
      const row = Array.from(existingRows).find(
        (r) => (r as HTMLElement).dataset.pairId === pair.id
      );
      if (!row) {
        console.warn(`Row not found for pair ${pair.id}`);
        return;
      }

      // Update generated output column
      const generatedOutputCell = row.querySelector('[data-cell-type="generated-output"]');
      if (generatedOutputCell && pair.generated_output) {
        const placeholder = generatedOutputCell.querySelector('[data-placeholder]');
        const contentDiv = generatedOutputCell.querySelector('[data-content]');

        if (placeholder && !contentDiv) {
          // Replace placeholder span with content div
          placeholder.remove();
          const newDiv = document.createElement('div');
          newDiv.className = 'text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto';
          newDiv.setAttribute('data-content', '');
          newDiv.textContent = pair.generated_output;
          generatedOutputCell.appendChild(newDiv);

          // Add flash animation with timer cleanup
          flashElement(newDiv);
        } else if (contentDiv) {
          // Update existing div if content changed
          if (contentDiv.textContent !== pair.generated_output) {
            contentDiv.textContent = pair.generated_output;
            flashElement(contentDiv);
          }
        }
      }

      // Update judge rating column
      const judgeRatingCell = row.querySelector('[data-cell-type="judge-rating"]');
      if (judgeRatingCell && pair.judge_rating) {
        const badge = judgeRatingCell.querySelector('.badge');
        if (badge) {
          const newClassName = `badge badge-sm badge-${pair.judge_rating === 'pass' ? 'success' : 'error'}`;
          if (badge.className !== newClassName) {
            badge.className = newClassName;
            badge.textContent = pair.judge_rating;
            flashElement(badge, 'bg-success/20');
          }
        }
      }

      // Update judge feedback column
      const judgeFeedbackCell = row.querySelector('[data-cell-type="judge-feedback"]');
      if (judgeFeedbackCell && pair.judge_feedback) {
        const placeholder = judgeFeedbackCell.querySelector('[data-placeholder]');
        const contentDiv = judgeFeedbackCell.querySelector('[data-content]');

        if (placeholder && !contentDiv) {
          // Replace placeholder span with content div
          placeholder.remove();
          const newDiv = document.createElement('div');
          newDiv.className =
            'text-sm opacity-70 whitespace-pre-wrap break-words max-h-20 overflow-y-auto';
          newDiv.setAttribute('data-content', '');
          newDiv.textContent = pair.judge_feedback;
          judgeFeedbackCell.appendChild(newDiv);

          // Add flash animation with timer cleanup
          flashElement(newDiv);
        } else if (contentDiv) {
          // Update existing div if content changed
          if (contentDiv.textContent !== pair.judge_feedback) {
            contentDiv.textContent = pair.judge_feedback;
            flashElement(contentDiv);
          }
        }
      }
    });
  }

  // Handle new row save event from TrainingPairsTable
  document.addEventListener('new-row-save', async (e) => {
    const { input, expected_output } = (
      e as CustomEvent<{ input: string; expected_output: string }>
    ).detail;

    // Get persona ID from the page
    const personaIdElement = document.querySelector('[data-persona-id]') as HTMLElement | null;
    const personaId = personaIdElement?.dataset.personaId;

    if (!personaId) {
      console.error('No persona_id found on page');
      if (window.toast) {
        window.toast.error('Failed to save training pair: Missing persona ID');
      }
      return;
    }

    try {
      const response = await fetch(`/api/personas/${personaId}/training/pairs`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ input, expected_output }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to create training pair');
      }

      // Show success notification
      if (window.toast) {
        window.toast.success('Training pair created successfully!');
      }

      // Start polling for real-time updates
      document.dispatchEvent(new CustomEvent('operation-started'));

      // Optionally reload the page after a short delay to show the new row
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } catch (error) {
      console.error('Save training pair error:', error);
      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to save training pair');
      }
    }
  });

  // Handle human-rating event from TrainingPairsTable
  document.addEventListener('human-rating', async (e) => {
    const { pairId, rating } = (e as CustomEvent<{ pairId: string; rating: string }>).detail;

    // Get persona ID from the page
    const personaIdElement = document.querySelector('[data-persona-id]') as HTMLElement | null;
    const personaId = personaIdElement?.dataset.personaId;

    if (!personaId) {
      console.error('No persona_id found on page');
      if (window.toast) {
        window.toast.error('Failed to submit rating: Missing persona ID');
      }
      return;
    }

    // Find the button that was clicked to show loading state
    const button = document.querySelector(
      `[data-action="human-rate"][data-rating="${rating}"][data-pair-id="${pairId}"]`
    );

    try {
      // Show loading state on the specific button
      if (button) {
        button.classList.add('loading');
        button.setAttribute('disabled', 'true');
      }

      const response = await fetch(`/api/personas/${personaId}/feedback-by-pair`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          training_pair_id: pairId,
          human_rating: rating,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to submit rating');
      }

      // Show success notification
      if (window.toast) {
        window.toast.success(`Rating submitted: ${rating.toUpperCase()}`);
      }

      // Update UI to replace buttons with badge after successful API call
      const td = document
        .querySelector(`[data-pair-id="${pairId}"]`)
        ?.closest('tr')
        ?.querySelector('[data-cell-type="human-rating"]');
      if (td) {
        td.innerHTML = `<span class="badge badge-sm badge-${rating === 'pass' ? 'success' : 'error'}">${rating}</span>`;
      }
    } catch (error) {
      console.error('Submit rating error:', error);

      // Revert the UI back to buttons on error
      const td = document
        .querySelector(`[data-pair-id="${pairId}"]`)
        ?.closest('tr')
        ?.querySelector('[data-cell-type="human-rating"]');
      if (td) {
        td.innerHTML = `
          <div class="flex gap-1 justify-center">
            <button
              class="btn btn-sm btn-success"
              data-action="human-rate"
              data-pair-id="${pairId}"
              data-rating="pass"
              title="Mark as Pass"
            >
              Pass
            </button>
            <button
              class="btn btn-sm btn-error"
              data-action="human-rate"
              data-pair-id="${pairId}"
              data-rating="fail"
              title="Mark as Fail"
            >
              Fail
            </button>
          </div>
        `;

        // Re-attach the event listener to the new buttons
        // This is handled by the event delegation in TrainingPairsTable
      }

      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to submit rating');
      }
    } finally {
      // Remove loading state - button may no longer exist if success, but that's ok
      const currentButton = document.querySelector(
        `[data-action="human-rate"][data-rating="${rating}"][data-pair-id="${pairId}"]`
      );
      if (currentButton) {
        currentButton.classList.remove('loading');
        currentButton.removeAttribute('disabled');
      }
    }
  });

  // Debounce timers map for feedback inputs
  const feedbackDebounceTimers = new Map<string, ReturnType<typeof setTimeout>>();

  // Handle human-feedback event from TrainingPairsTable
  document.addEventListener('human-feedback', async (e) => {
    const { pairId } = (e as CustomEvent<{ pairId: string }>).detail;

    // Get persona ID from the page
    const personaIdElement = document.querySelector('[data-persona-id]') as HTMLElement | null;
    const personaId = personaIdElement?.dataset.personaId;

    if (!personaId) {
      console.error('No persona_id found on page');
      if (window.toast) {
        window.toast.error('Failed to save feedback: Missing persona ID');
      }
      return;
    }

    // Clear any existing timer for this pair
    if (feedbackDebounceTimers.has(pairId)) {
      clearTimeout(feedbackDebounceTimers.get(pairId)!);
    }

    // Debounce: wait 500ms after user stops typing
    feedbackDebounceTimers.set(
      pairId,
      setTimeout(async () => {
        // Find the input element to get the current value
        const input = document.querySelector(
          `[data-action="add-feedback"][data-pair-id="${pairId}"]`
        ) as HTMLInputElement;
        if (!input) {
          console.error(`Input not found for pair ${pairId}`);
          return;
        }

        const currentFeedback = input.value;
        if (!currentFeedback.trim()) {
          console.log('Feedback is empty, skipping API call');
          return;
        }

        // Check if there's an existing rating for this pair
        const row = document.querySelector(`[data-pair-id="${pairId}"]`)?.closest('tr');
        const ratingCell = row?.querySelector('[data-cell-type="human-rating"]');
        const ratingBadge = ratingCell?.querySelector('.badge');
        const existingRating = ratingBadge?.textContent?.toLowerCase();

        if (!existingRating || (existingRating !== 'pass' && existingRating !== 'fail')) {
          console.warn(`No rating found for pair ${pairId}, cannot save feedback`);
          if (window.toast) {
            window.toast.warning('Please rate the pair first before adding feedback');
          }
          // Revert visual confirmation
          input.classList.remove('input-success');
          return;
        }

        try {
          // Show loading state
          input.classList.add('input-loading');

          const response = await fetch(`/api/personas/${personaId}/feedback-by-pair`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              training_pair_id: pairId,
              human_rating: existingRating,
              human_feedback: currentFeedback,
            }),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Failed to save feedback');
          }

          // Show success notification
          if (window.toast) {
            window.toast.success('Feedback saved!');
          }

          // Show visual confirmation (green border)
          input.classList.remove('input-loading');
          input.classList.add('input-success');

          // Remove visual confirmation after 2 seconds
          setTimeout(() => {
            input.classList.remove('input-success');
          }, 2000);
        } catch (error) {
          console.error('Save feedback error:', error);
          if (window.toast) {
            window.toast.error(error instanceof Error ? error.message : 'Failed to save feedback');
          }
          // Revert loading state on error
          input.classList.remove('input-loading');
        } finally {
          // Clear the timer
          feedbackDebounceTimers.delete(pairId);
        }
      }, 500)
    );
  });

  // Handle CSV import event from TrainingPairsTable
  document.addEventListener('csv-import', async (e) => {
    const { file } = (e as CustomEvent<{ file: File }>).detail;

    // Get persona ID from the page
    const personaIdElement = document.querySelector('[data-persona-id]') as HTMLElement | null;
    const personaId = personaIdElement?.dataset.personaId;

    if (!personaId) {
      console.error('No persona_id found on page');
      if (window.toast) {
        window.toast.error('Failed to import CSV: Missing persona ID');
      }
      return;
    }

    // Validate file size before processing (10MB limit)
    const MAX_FILE_SIZE = 10 * 1024 * 1024; // 10MB
    if (file.size > MAX_FILE_SIZE) {
      if (window.toast) {
        window.toast.error('File too large. Maximum size is 10MB');
      }
      return;
    }

    try {
      // Show loading state (inside try block so finally always executes)
      let importBtn = document.querySelector('[data-action="import-csv"]');
      if (importBtn) {
        importBtn.classList.add('loading');
        importBtn.setAttribute('disabled', 'true');
      }

      // Read file content
      const fileContent = await file.text();

      // Double-check file content size after reading (for compressed content)
      if (fileContent.length > MAX_FILE_SIZE) {
        if (window.toast) {
          window.toast.error('CSV content too large after processing');
        }
        return;
      }

      // Upload to API
      const response = await fetch(`/api/personas/${personaId}/training/upload`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          csv: fileContent,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to upload CSV');
      }

      // Show success notification with countdown
      if (window.toast) {
        const COUNTDOWN_SECONDS = 3;
        let countdown = COUNTDOWN_SECONDS;
        const toast = window.toast.success(
          `Uploaded ${result.count} training pairs successfully! Reloading in ${countdown}...`
        );

        // Start countdown
        const interval = setInterval(() => {
          countdown--;
          if (countdown > 0) {
            // Check if toast still exists before updating
            if (toast && document.body.contains(toast) && window.toast) {
              window.toast.update(
                toast,
                `Uploaded ${result.count} training pairs successfully! Reloading in ${countdown}...`
              );
            } else {
              clearInterval(interval);
            }
          } else {
            clearInterval(interval);
            // Small delay to allow final update to render
            setTimeout(() => {
              window.location.reload();
            }, 100);
          }
        }, 1000);

        // Store interval for cleanup on page unload
        window.__csvUploadInterval = interval;
      }

      // Start polling for real-time updates
      document.dispatchEvent(new CustomEvent('operation-started'));
    } catch (error) {
      console.error('CSV import error:', error);
      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to import CSV');
      }
    } finally {
      // Remove loading state - re-query to get current DOM element (fixes race condition)
      const importBtn = document.querySelector('[data-action="import-csv"]');
      if (importBtn) {
        importBtn.classList.remove('loading');
        importBtn.removeAttribute('disabled');
      }
    }
  });

  // Start polling when generate/evaluate actions are triggered
  // We'll trigger polling after successful API calls
  document.addEventListener('DOMContentLoaded', () => {
    const generateBtn = document.querySelector('[data-action="generate-outputs"]');
    const evaluateBtn = document.querySelector('[data-action="evaluate-all"]');
    const judgeBtn = document.querySelector('[data-action="generate-judge"]');

    // Get persona ID from any button
    const personaId =
      generateBtn?.getAttribute('data-persona-id') ||
      evaluateBtn?.getAttribute('data-persona-id') ||
      judgeBtn?.getAttribute('data-persona-id');

    if (personaId) {
      // Listen for successful operations to start polling
      document.addEventListener('operation-started', () => {
        startPolling(personaId);
      });
    }
  });

  // Clean up polling and debounce timers on page unload
  window.addEventListener('beforeunload', () => {
    stopPolling();
    // Clear CSV upload countdown interval if exists
    if (window.__csvUploadInterval) {
      clearInterval(window.__csvUploadInterval);
    }
    // Clear all feedback debounce timers
    feedbackDebounceTimers.forEach((timer) => clearTimeout(timer));
    feedbackDebounceTimers.clear();
  });

  // Stop polling when page is hidden (SPA navigation, tab switch)
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && isPolling) {
      console.log('Page hidden, stopping polling to save resources');
      stopPolling();
    }
  });
</script>

<style>
  /* Ensure smooth transitions */
  .btn {
    transition: all 0.2s ease-in-out;
  }

  /* Input loading state */
  .input-loading {
    border-color: hsl(var(--p)) !important;
    opacity: 0.7;
  }
</style>
