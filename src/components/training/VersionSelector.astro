---
/**
 * VersionSelector Component
 *
 * Dropdown selector for prompt versions (v1, v2, v3...).
 * Displays version number and creation info.
 *
 * @param versions - Array of version objects with mock data
 * @param selectedVersion - Currently selected version number
 * @param type - 'task' or 'judge' for styling/labeling
 * @param onVersionChange - Optional callback for version selection (client-side)
 */

interface Version {
  version_number: number;
  created_by: 'human' | 'ai';
  created_at: string;
  improvement_rationale?: string;
}

interface Props {
  versions: Version[];
  selectedVersion: number;
  type: 'task' | 'judge';
  id?: string;
}

const { versions, selectedVersion, type, id = `version-selector-${type}` } = Astro.props;

// Sort versions by version_number descending (latest first)
const sortedVersions = [...versions].sort((a, b) => b.version_number - a.version_number);

const getCreatedByIcon = (createdBy: 'human' | 'ai') => {
  return createdBy === 'ai' ? '✦' : '●';
};

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
};
---

<div class="form-control w-full">
  <label for={id} class="label px-0 py-1">
    <span class="label-text font-semibold capitalize text-xs tracking-wide"
      >{type} Prompt Version</span
    >
    <span class="label-text-alt text-xs">{sortedVersions.length} versions</span>
  </label>
  <div class="dropdown w-full">
    <select
      id={id}
      class="select select-bordered select-sm w-full bg-base-100/80 backdrop-blur-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/20"
      data-version-selector={type}
    >
      {
        sortedVersions.map((version) => (
          <option
            value={version.version_number}
            selected={version.version_number === selectedVersion}
          >
            v{version.version_number} {getCreatedByIcon(version.created_by)}
            {' - '}
            {formatDate(version.created_at)}
            {version.version_number === selectedVersion ? ' (current)' : ''}
          </option>
        ))
      }
    </select>
  </div>
  {
    sortedVersions.find((v) => v.version_number === selectedVersion)?.improvement_rationale && (
      <label class="label px-0 py-1">
        <span class="label-text-alt text-xs text-base-content/60 leading-relaxed">
          {sortedVersions.find((v) => v.version_number === selectedVersion)!.improvement_rationale}
        </span>
      </label>
    )
  }
</div>

<script>
  // Client-side interaction handling
  document.querySelectorAll('[data-version-selector]').forEach((selector) => {
    selector.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const version = parseInt(target.value);
      const type = target.dataset.versionSelector;
      console.log(`Version changed: ${type} prompt v${version}`);

      // Dispatch custom event for parent components to listen to
      const event = new CustomEvent('version-change', {
        detail: { type, version },
        bubbles: true,
      });
      target.dispatchEvent(event);
    });
  });
</script>
