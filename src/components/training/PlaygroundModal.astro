---
/**
 * PlaygroundModal Component
 *
 * Modal for testing individual training pairs with live output streaming.
 * Shows 3 panes: Input (read-only), Generated Output (streaming), and Judge Reasoning (streaming).
 *
 * @param trainingPairId - Training pair ID to test
 * @param isOpen - Whether the modal is open (for dialog element)
 * @param onClose - Optional callback when modal is closed
 */

import Modal from '@components/ui/Modal.astro';

interface Props {
  trainingPairId: string | number;
  isOpen?: boolean;
  onClose?: () => void;
  personaId?: string;
}

// personaId is passed to client-side script via data attribute in TrainingPairsTable
// It is declared here for the Props interface but used only on client-side
const { trainingPairId, isOpen = false, personaId: personaIdUnused } = Astro.props;
// Mark as intentionally unused for server-side
void personaIdUnused;

// Generate unique ID for this modal instance
const modalId = `playground-modal-${trainingPairId}`;
---

<!-- Modal using native dialog element -->
<Modal
  id={modalId}
  size="2xl"
  open={isOpen}
  closeOnEscape={true}
  closeOnBackdropClick={true}
  showCloseButton={false}
  class="p-0 h-[90vh] flex flex-col"
>
  <!-- Custom Header -->
  <div slot="header" class="mb-0 pb-0">
    <div class="flex items-center gap-3">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-lg bg-gradient-to-br from-luxe-gold/20 to-luxe-gold/10 border border-luxe-gold/30"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5 text-luxe-gold"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="font-display text-xl font-semibold text-luxe-gold">Playground</h3>
        <p class="text-xs text-base-content/60 font-mono">
          Training Pair ID: {trainingPairId}
        </p>
      </div>
    </div>
    <button
      class="btn btn-sm btn-circle btn-ghost absolute top-4 right-4"
      onclick={`document.getElementById('${modalId}').close()`}
      aria-label="Close modal"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Modal Body - 3 Pane Layout -->
  <div slot="content" class="flex-1 overflow-hidden p-6 !py-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 h-full">
      <!-- Pane 1: Input (Read-only) -->
      <div class="flex flex-col h-full">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-1 h-4 rounded-full bg-luxe-gold"></div>
          <h4 class="font-semibold text-sm uppercase tracking-wide">Input</h4>
          <span class="badge badge-ghost badge-xs ml-auto">Read-only</span>
        </div>
        <div class="card-luxe flex-1 overflow-hidden">
          <div class="h-full bg-base-100 rounded-xl p-4">
            <div
              id={`playground-input-display-${trainingPairId}`}
              class="h-full overflow-y-auto text-sm whitespace-pre-wrap font-mono text-base-content/80 leading-relaxed"
            >
              <span class="opacity-50 italic">Input data will be displayed here...</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Pane 2: Generated Output (Streaming) -->
      <div class="flex flex-col h-full">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-1 h-4 rounded-full bg-luxe-emerald"></div>
          <h4 class="font-semibold text-sm uppercase tracking-wide">Generated Output</h4>
          <div
            id={`output-status-indicator-${trainingPairId}`}
            class="hidden ml-auto items-center gap-1.5 text-xs text-luxe-emerald"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-luxe-emerald opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-luxe-emerald"></span>
            </span>
            <span class="font-mono">Streaming</span>
          </div>
        </div>
        <div class="card-luxe flex-1 overflow-hidden">
          <div class="h-full bg-base-100 rounded-xl p-4 relative">
            <div
              id={`playground-output-display-${trainingPairId}`}
              class="h-full overflow-y-auto text-sm whitespace-pre-wrap font-mono text-base-content leading-relaxed"
            >
              <span class="opacity-50 italic" id={`output-placeholder-${trainingPairId}`}>
                Output will appear here after running...
              </span>
            </div>
            <!-- Streaming cursor effect -->
            <div
              id={`streaming-cursor-${trainingPairId}`}
              class="hidden absolute bottom-4 left-4 w-0.5 h-5 bg-luxe-emerald animate-pulse"
            >
            </div>
          </div>
        </div>
      </div>

      <!-- Pane 3: Judge Reasoning (Streaming) -->
      <div class="flex flex-col h-full">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-1 h-4 rounded-full bg-info"></div>
          <h4 class="font-semibold text-sm uppercase tracking-wide">Judge Reasoning</h4>
          <div
            id={`judge-status-indicator-${trainingPairId}`}
            class="hidden ml-auto items-center gap-1.5 text-xs text-info"
          >
            <span class="loading loading-spinner loading-xs"></span>
            <span class="font-mono">Evaluating</span>
          </div>
        </div>
        <div class="card-luxe flex-1 overflow-hidden">
          <div class="h-full bg-base-100 rounded-xl p-4">
            <div
              id={`playground-judge-display-${trainingPairId}`}
              class="h-full overflow-y-auto text-sm whitespace-pre-wrap font-mono text-base-content leading-relaxed"
            >
              <span class="opacity-50 italic" id={`judge-placeholder-${trainingPairId}`}>
                Judge reasoning will appear here...
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Footer - Run Button -->
  <div slot="footer" class="!mt-0 !pt-4">
    <div class="flex items-center justify-between">
      <div class="text-xs text-base-content/60">
        <span class="font-mono">ID: {trainingPairId}</span>
      </div>
      <div class="flex gap-3">
        <button
          id={`playground-reset-button-${trainingPairId}`}
          class="btn btn-ghost btn-sm"
          onclick={`resetPlayground('${trainingPairId}')`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
            ></path>
          </svg>
          Reset
        </button>
        <button
          id={`playground-run-button-${trainingPairId}`}
          class="btn btn-luxe btn-luxe-primary btn-sm gap-2"
          onclick={`runPlayground('${trainingPairId}')`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"
            ></path>
          </svg>
          Run
        </button>
      </div>
    </div>
  </div>
</Modal>

<script is:inline>
  /**
   * Simulates streaming text effect for output and judge reasoning panes.
   * @param {string} elementId - The ID of the element to stream text into
   * @param {string} text - The text to stream
   * @param {number} speed - Milliseconds between characters (default: 20)
   * @returns Promise that resolves when streaming is complete
   */
  function streamText(elementId, text, speed = 20) {
    return new Promise((resolve) => {
      const element = document.getElementById(elementId);
      if (!element) {
        resolve();
        return;
      }

      let index = 0;
      element.innerHTML = '';

      const interval = setInterval(() => {
        if (index < text.length) {
          element.innerHTML += text[index];
          element.scrollTop = element.scrollHeight;
          index++;
        } else {
          clearInterval(interval);
          resolve();
        }
      }, speed);
    });
  }

  /**
   * Resets all playground panes to their initial state.
   * @param {string} pairId - The training pair ID to scope element IDs
   */
  function resetPlayground(pairId) {
    const inputDisplay = document.getElementById(`playground-input-display-${pairId}`);
    const outputDisplay = document.getElementById(`playground-output-display-${pairId}`);
    const judgeDisplay = document.getElementById(`playground-judge-display-${pairId}`);
    const outputPlaceholder = document.getElementById(`output-placeholder-${pairId}`);
    const judgePlaceholder = document.getElementById(`judge-placeholder-${pairId}`);
    const outputStatus = document.getElementById(`output-status-indicator-${pairId}`);
    const judgeStatus = document.getElementById(`judge-status-indicator-${pairId}`);
    const streamingCursor = document.getElementById(`streaming-cursor-${pairId}`);

    // Reset input display
    if (inputDisplay) {
      inputDisplay.innerHTML =
        '<span class="opacity-50 italic">Input data will be displayed here...</span>';
    }

    // Reset output display
    if (outputDisplay && outputPlaceholder) {
      outputDisplay.innerHTML =
        '<span class="opacity-50 italic">Output will appear here after running...</span>';
    }

    // Reset judge display
    if (judgeDisplay && judgePlaceholder) {
      judgeDisplay.innerHTML =
        '<span class="opacity-50 italic">Judge reasoning will appear here...</span>';
    }

    // Hide status indicators
    if (outputStatus) {
      outputStatus.classList.add('hidden');
      outputStatus.classList.remove('flex');
    }
    if (judgeStatus) {
      judgeStatus.classList.add('hidden');
      judgeStatus.classList.remove('flex');
    }
    if (streamingCursor) {
      streamingCursor.classList.add('hidden');
    }
  }

  /**
   * Runs the playground with real API calls.
   * Calls POST /api/playground/run, streams the output and judge reasoning.
   * @param {string} pairId - The training pair ID to scope element IDs
   */
  async function runPlayground(pairId) {
    const runButton = document.getElementById(`playground-run-button-${pairId}`);
    const outputDisplay = document.getElementById(`playground-output-display-${pairId}`);
    const judgeDisplay = document.getElementById(`playground-judge-display-${pairId}`);
    const outputStatus = document.getElementById(`output-status-indicator-${pairId}`);
    const judgeStatus = document.getElementById(`judge-status-indicator-${pairId}`);
    const streamingCursor = document.getElementById(`streaming-cursor-${pairId}`);

    // Get personaId from the modal's data attribute
    const modalId = `playground-modal-${pairId}`;
    const modal = document.getElementById(modalId);
    const personaId = modal?.dataset.personaId;

    if (!personaId) {
      console.error('No personaId found on modal');
      if (window.toast) {
        window.toast.error('Unable to run: missing persona ID');
      }
      return;
    }

    // Disable run button and show loading state
    if (runButton) {
      runButton.disabled = true;
      runButton.classList.add('loading');
    }

    try {
      // Show streaming indicator for output
      if (outputStatus) {
        outputStatus.classList.remove('hidden');
        outputStatus.classList.add('flex');
      }
      if (streamingCursor) {
        streamingCursor.classList.remove('hidden');
      }

      // Clear placeholder for output
      if (outputDisplay) {
        outputDisplay.innerHTML = '';
      }

      // Call the playground API
      const response = await fetch('/api/playground/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          personaId,
          pairId,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Failed to run playground');
      }

      // Stream the task output
      await streamText(`playground-output-display-${pairId}`, result.taskOutput, 15);

      // Hide output streaming indicator
      if (outputStatus) {
        outputStatus.classList.add('hidden');
        outputStatus.classList.remove('flex');
      }
      if (streamingCursor) {
        streamingCursor.classList.add('hidden');
      }

      // Show judge evaluation indicator
      if (judgeStatus) {
        judgeStatus.classList.remove('hidden');
        judgeStatus.classList.add('flex');
      }

      // Clear placeholder and stream judge reasoning
      if (judgeDisplay) {
        judgeDisplay.innerHTML = '';
      }

      // Build judge reasoning text from decision
      const judgeText = `**Rating:** ${result.judgeDecision.rating.toUpperCase()}

**Reasoning:**
${result.judgeDecision.reasoning}${
        result.judgeDecision.feedback
          ? `

**Feedback:**
${result.judgeDecision.feedback}`
          : ''
      }`;

      await new Promise((resolve) => setTimeout(resolve, 500)); // Small delay before judge reasoning
      await streamText(`playground-judge-display-${pairId}`, judgeText, 20);

      // Hide judge evaluation indicator
      if (judgeStatus) {
        judgeStatus.classList.add('hidden');
        judgeStatus.classList.remove('flex');
      }

      // Show success notification
      if (window.toast) {
        window.toast.success('Playground run completed successfully');
      }
    } catch (error) {
      console.error('Playground run error:', error);

      // Hide all status indicators
      if (outputStatus) {
        outputStatus.classList.add('hidden');
        outputStatus.classList.remove('flex');
      }
      if (judgeStatus) {
        judgeStatus.classList.add('hidden');
        judgeStatus.classList.remove('flex');
      }
      if (streamingCursor) {
        streamingCursor.classList.add('hidden');
      }

      // Show error in output display
      if (outputDisplay) {
        outputDisplay.innerHTML = `<span class="text-luxe-ruby">Error: ${error instanceof Error ? error.message : 'Failed to run playground'}</span>`;
      }

      // Show error notification
      if (window.toast) {
        window.toast.error(error instanceof Error ? error.message : 'Failed to run playground');
      }
    } finally {
      // Re-enable run button
      if (runButton) {
        runButton.disabled = false;
        runButton.classList.remove('loading');
      }
    }
  }

  // Expose functions to global scope for onclick handlers
  window.resetPlayground = resetPlayground;
  window.runPlayground = runPlayground;
</script>

<style>
  /* Custom scrollbar styling for all panes */
  [id^='playground-input-display']::-webkit-scrollbar,
  [id^='playground-output-display']::-webkit-scrollbar,
  [id^='playground-judge-display']::-webkit-scrollbar {
    width: 6px;
  }

  [id^='playground-input-display']::-webkit-scrollbar-track,
  [id^='playground-output-display']::-webkit-scrollbar-track,
  [id^='playground-judge-display']::-webkit-scrollbar-track {
    background: hsl(var(--b2));
    border-radius: 3px;
  }

  [id^='playground-input-display']::-webkit-scrollbar-thumb,
  [id^='playground-output-display']::-webkit-scrollbar-thumb,
  [id^='playground-judge-display']::-webkit-scrollbar-thumb {
    background: hsl(var(--bc) / 0.3);
    border-radius: 3px;
  }

  [id^='playground-input-display']::-webkit-scrollbar-thumb:hover,
  [id^='playground-output-display']::-webkit-scrollbar-thumb:hover,
  [id^='playground-judge-display']::-webkit-scrollbar-thumb:hover {
    background: hsl(var(--bc) / 0.5);
  }

  /* Card hover animation */
  .card-luxe {
    transition: all 0.3s ease-in-out;
  }

  .card-luxe:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-gold);
  }

  /* Smooth status transitions */
  [id^='output-status-indicator'],
  [id^='judge-status-indicator'] {
    transition: opacity 0.3s ease-in-out;
  }

  /* Streaming cursor blink */
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  [id^='streaming-cursor'].animate-pulse {
    animation: blink 1s infinite;
  }
</style>
