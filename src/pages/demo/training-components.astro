---
/**
 * Training Components Showcase Page
 *
 * Demo page displaying all training UI components with mock data.
 * Research Terminal aesthetic - professional data analysis interface.
 */

import WorkspaceLayout from '@layouts/WorkspaceLayout.astro';
import PassFailBadge from '@components/training/PassFailBadge.astro';
import VersionSelector from '@components/training/VersionSelector.astro';
import SimpleMetrics from '@components/training/SimpleMetrics.astro';
import PromptEditor from '@components/training/PromptEditor.astro';
import OptimizationSuggestion from '@components/training/OptimizationSuggestion.astro';
import LoadingStates from '@components/training/LoadingStates.astro';

// Mock data for demos
const mockVersions = [
  {
    version_number: 3,
    created_by: 'ai' as const,
    created_at: '2026-01-03T10:00:00Z',
    improvement_rationale: 'Enhanced clarity and added examples',
  },
  {
    version_number: 2,
    created_by: 'ai' as const,
    created_at: '2026-01-02T14:30:00Z',
    improvement_rationale: 'Improved specificity',
  },
  {
    version_number: 1,
    created_by: 'human' as const,
    created_at: '2026-01-01T09:00:00Z',
  },
];

const mockMetrics = {
  judgeMetrics: {
    total_pairs: 50,
    pass_count: 35,
    fail_count: 15,
    pass_rate: 0.7,
  },
  humanMetrics: {
    total_pairs: 50,
    pass_count: 40,
    fail_count: 10,
    pass_rate: 0.8,
  },
};

const sampleTaskPrompt = `Write a helpful response as an AI assistant.

Guidelines:
- Be clear and concise
- Provide examples when relevant
- Use friendly, professional tone

Task: Answer the user's question accurately.`;
---

<WorkspaceLayout title="Training Components Showcase">
  <div class="h-screen overflow-y-auto bg-gradient-to-b from-base-100 to-base-200">
    <!-- Hero Header -->
    <div class="border-b border-base-300 bg-base-100/80 backdrop-blur-sm sticky top-0 z-20">
      <div class="max-w-7xl mx-auto px-6 py-8">
        <div class="flex items-start justify-between">
          <div>
            <div class="flex items-center gap-3 mb-2">
              <span class="badge badge-primary badge-outline font-mono text-xs">SHOWCASE</span>
              <span class="text-xs text-base-content/50 font-mono">v2.4.0</span>
            </div>
            <h1 class="text-3xl font-bold tracking-tight">Training Components</h1>
            <p class="text-base-content/60 mt-1 max-w-xl">
              Interactive demonstration of evaluation workspace UI components
            </p>
          </div>
          <div class="flex gap-2">
            <a href="/personas/demo-persona/workspace" class="btn btn-primary btn-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
              </svg>
              Full Workspace
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="max-w-7xl mx-auto px-6 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- PassFailBadge Card -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">01</span>
              <h3 class="card-title text-sm font-semibold">Pass/Fail Badge</h3>
            </div>
            <div class="flex flex-wrap gap-3">
              <PassFailBadge rating="pass" />
              <PassFailBadge rating="fail" />
              <PassFailBadge rating={null} />
              <PassFailBadge rating="pass" size="sm" />
              <PassFailBadge rating="fail" size="lg" />
            </div>
          </div>
        </div>

        <!-- VersionSelector Card -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">02</span>
              <h3 class="card-title text-sm font-semibold">Version Selector</h3>
            </div>
            <div class="space-y-3">
              <VersionSelector versions={mockVersions} selectedVersion={3} type="task" />
              <VersionSelector versions={mockVersions.slice(0, 2)} selectedVersion={2} type="judge" />
            </div>
          </div>
        </div>

        <!-- SimpleMetrics Card (Full Width) -->
        <div class="lg:col-span-2 card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">03</span>
              <h3 class="card-title text-sm font-semibold">Training Metrics Dashboard</h3>
            </div>
            <SimpleMetrics
              judgeMetrics={mockMetrics.judgeMetrics}
              humanMetrics={mockMetrics.humanMetrics}
            />
          </div>
        </div>

        <!-- PromptEditor Cards (Side by Side) -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">04</span>
              <h3 class="card-title text-sm font-semibold">Task Prompt Editor</h3>
            </div>
            <PromptEditor
              type="task"
              promptText={sampleTaskPrompt}
              versions={mockVersions}
              selectedVersion={3}
              showHistory={false}
            />
          </div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">05</span>
              <h3 class="card-title text-sm font-semibold">Judge Prompt Editor</h3>
            </div>
            <PromptEditor
              type="judge"
              promptText="Evaluate if the output is accurate and helpful.\n\nMark PASS if correct, FAIL otherwise."
              versions={mockVersions.slice(0, 2)}
              selectedVersion={2}
              showHistory={false}
            />
          </div>
        </div>

        <!-- Loading States Card -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">06</span>
              <h3 class="card-title text-sm font-semibold">Loading States</h3>
            </div>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <span class="loading loading-spinner text-primary"></span>
                <span class="loading loading-dots text-secondary"></span>
                <span class="loading loading-ring text-accent"></span>
              </div>
              <progress class="progress progress-primary w-full" value="70" max="100"></progress>
              <div class="flex gap-2 flex-wrap">
                <button onclick="window.toast?.success?.('Success!')" class="btn btn-xs btn-success">Success</button>
                <button onclick="window.toast?.error?.('Error!')" class="btn btn-xs btn-error">Error</button>
                <button onclick="window.toast?.warning?.('Warning!')" class="btn btn-xs btn-warning">Warning</button>
                <button onclick="window.toast?.info?.('Info!')" class="btn btn-xs btn-info">Info</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Optimization Modal Card -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
          <div class="card-body p-5">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-xs text-base-content/40">07</span>
              <h3 class="card-title text-sm font-semibold">Optimization Suggestion</h3>
            </div>
            <p class="text-sm text-base-content/60 mb-4">AI-powered prompt improvement suggestions</p>
            <label for="demo-optimization-modal" class="btn btn-outline btn-sm w-full">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
              </svg>
              View Optimization Demo
            </label>
          </div>
        </div>

      </div>

      <!-- Footer -->
      <div class="mt-12 pt-8 border-t border-base-300 text-center">
        <p class="text-xs text-base-content/40 font-mono">TRAINING WORKSPACE • COMPONENT SHOWCASE</p>
        <p class="text-xs text-base-content/30 mt-1">All data is mock/demo</p>
      </div>
    </div>
  </div>

  <!-- Modals and Overlays -->
  <slot slot="overlays">
    <OptimizationSuggestion
      type="task"
      currentPrompt={sampleTaskPrompt}
      suggestedPrompt={`Write a helpful, detailed response as an AI assistant.

Guidelines:
- Be clear, concise, and well-structured
- Provide concrete examples with code snippets when relevant
- Use friendly, professional, and encouraging tone
- Break complex topics into digestible steps

Quality Standards:
- Ensure accuracy and cite sources when applicable
- Anticipate follow-up questions
- Avoid jargon unless it's necessary (then define it)

Task: Answer the user's question accurately and comprehensively.`}
      rationale={`Added 'detailed' and 'well-structured' to improve completeness. Added 'concrete examples with code snippets' because 8 failures lacked specific examples. Added Quality Standards section to address accuracy issues. Added 'comprehensive' to final task instruction to reduce incomplete answers.`}
      modalId="demo-optimization-modal"
    />
    <LoadingStates />
  </slot>
</WorkspaceLayout>
