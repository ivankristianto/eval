---
/**
 * Bulk Evaluation Runs List Page
 *
 * Displays a table of all bulk evaluation runs with:
 * - Run ID, Dataset filename, Status, Model count, Created date
 * - Action buttons per row (View, Delete, Rerun)
 * - Empty state if no runs exist
 */

import Layout from '@layouts/Layout.astro';
import Icon from '@components/ui/Icon.astro';
import BulkRunsTable, { type BulkRun } from '@components/bulk/BulkRunsTable.astro';
import { listEvaluationRuns, getBulkDataset } from '@lib/db/bulk-db';

// Fetch all bulk runs from the database and enrich with dataset info
const allRuns = listEvaluationRuns();
const runs: BulkRun[] = allRuns.map((run) => {
  const dataset = getBulkDataset(run.dataset_id);
  const selectedModels = JSON.parse(run.selected_models) as string[];
  return {
    id: run.id,
    dataset_id: run.dataset_id,
    dataset_filename: dataset?.filename || 'Unknown',
    status: run.status,
    model_count: selectedModels.length,
    total_rows: run.total_rows,
    processed_rows: run.processed_rows,
    created_at: run.created_at,
    started_at: run.started_at || null,
    completed_at: run.completed_at || null,
    error_message: run.error_message || null,
  };
});
---

<Layout title="Bulk Evaluations - Eval AI">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between animate-reveal">
      <div class="accent-line">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight mb-3 text-gradient-gold"
        >
          Bulk Evaluations
        </h1>
        <p class="text-base-content/60 text-lg">View and manage your bulk evaluation runs</p>
      </div>
      <a href="/bulk-eval/new" class="btn btn-luxe btn-luxe-primary gap-2">
        <Icon name="plus" size="md" />
        New Evaluation
      </a>
    </div>

    <!-- Runs Table -->
    <div class="animate-reveal delay-100">
      <BulkRunsTable runs={runs} pageSize={10} />
    </div>

    <!-- Delete Confirmation Modal -->
    <dialog id="delete-modal" class="modal">
      <div class="modal-box">
        <h3 class="font-bold text-lg mb-4">Delete Evaluation Run?</h3>
        <p class="text-base-content/70 mb-6">
          This will permanently delete this evaluation run and all its results. This action cannot
          be undone.
        </p>
        <div class="modal-action">
          <button id="cancel-delete" class="btn btn-ghost">Cancel</button>
          <button id="confirm-delete" class="btn btn-error">Delete</button>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  </div>
</Layout>

<style>
  /* Component handles its own styles */
</style>

<script>
  import { addToast } from '@lib/ui/toastStore';

  const deleteModal = document.getElementById('delete-modal') as HTMLDialogElement;
  const cancelDeleteBtn = document.getElementById('cancel-delete');
  const confirmDeleteBtn = document.getElementById('confirm-delete');

  let runToDelete: string | null = null;

  /**
   * Open delete confirmation modal
   */
  function openDeleteModal(runId: string): void {
    runToDelete = runId;
    deleteModal?.showModal();
  }

  /**
   * Close delete modal
   */
  function closeDeleteModal(): void {
    runToDelete = null;
    deleteModal?.close();
  }

  /**
   * Delete the run
   */
  async function deleteRun(): Promise<void> {
    if (!runToDelete) return;

    try {
      const response = await fetch(`/api/bulk/runs/${runToDelete}`, {
        method: 'DELETE',
      });

      if (!response.ok) {
        throw new Error('Failed to delete evaluation run');
      }

      addToast('Evaluation run deleted successfully', 'success');
      closeDeleteModal();

      // Reload to show updated data
      window.location.reload();
    } catch (error) {
      addToast(
        `Failed to delete evaluation run: ${error instanceof Error ? error.message : 'Unknown error'}`,
        'error'
      );
    }
  }

  /**
   * Handle view run action from component
   */
  function handleViewRun(event: CustomEvent): void {
    const { runId } = event.detail;
    if (runId) {
      window.location.href = `/bulk-eval/${runId}`;
    }
  }

  /**
   * Handle delete run action from component
   */
  function handleDeleteRun(event: CustomEvent): void {
    const { runId } = event.detail;
    if (runId) {
      openDeleteModal(runId);
    }
  }

  /**
   * Handle rerun action from component
   */
  function handleRerunRun(event: CustomEvent): void {
    const { runId } = event.detail;
    if (runId) {
      // TODO: Implement rerun functionality
      addToast(`Rerun functionality for ${runId} is not yet implemented`, 'info');
    }
  }

  // Setup event listeners
  cancelDeleteBtn?.addEventListener('click', closeDeleteModal);
  confirmDeleteBtn?.addEventListener('click', deleteRun);

  // Close modal on backdrop click
  deleteModal?.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
      closeDeleteModal();
    }
  });

  // Listen for custom events from BulkRunsTable component
  document.addEventListener('bulk-run-view', (e: Event) => {
    const customEvent = e as CustomEvent<{ runId: string }>;
    handleViewRun(customEvent);
  });
  document.addEventListener('bulk-run-delete', (e: Event) => {
    const customEvent = e as CustomEvent<{ runId: string }>;
    handleDeleteRun(customEvent);
  });
  document.addEventListener('bulk-run-rerun', (e: Event) => {
    const customEvent = e as CustomEvent<{ runId: string }>;
    handleRerunRun(customEvent);
  });
</script>
