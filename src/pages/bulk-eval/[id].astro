---
/**
 * Bulk Evaluation Detail Page
 *
 * Displays detailed view of a single bulk evaluation run:
 * - Run metadata (status, model count, progress)
 * - Dataset preview
 * - Results table with model outputs (server-side rendered)
 * - Detail drawer for row results
 * - Polls for status if run is in progress
 * - Handles 404 if run not found
 */

import Layout from '@layouts/Layout.astro';
import ResultsTable from '@components/bulk/ResultsTable.astro';
import DetailDrawer from '@components/bulk/DetailDrawer.astro';
import StatusBadge from '@components/bulk/StatusBadge.astro';
import Icon from '@components/ui/Icon.astro';
import {
  getRunWithResults,
  getBulkDataset,
  type BulkDataset,
  type EvaluationRun,
  type EvaluationRunWithResults,
  type RowResult,
} from '@lib/db/bulk-db';
import { getModelById } from '@lib/db/db';

// Get run ID from URL params
const { id } = Astro.params;

// Handle missing ID
if (!id) {
  return Astro.redirect('/404');
}

// Fetch run and dataset data server-side
let run: EvaluationRunWithResults | null = null;
let dataset: BulkDataset | null = null;
let results: RowResult[] = [];

let notFound = false;

// Fetch data from database
try {
  run = getRunWithResults(id);
  if (!run) {
    notFound = true;
  } else {
    dataset = getBulkDataset(run.dataset_id);
    if (!dataset) {
      notFound = true;
    } else {
      // Get results for this run
      results = run.results || [];
    }
  }
} catch (e) {
  console.error('Error fetching run data:', e);
  notFound = true;
}

// Handle 404
if (notFound || !run || !dataset) {
  return Astro.redirect('/404');
}

// Parse selected model IDs and fetch model names
const selectedModelIds = JSON.parse(run.selected_models) as string[];
const modelInfoArray: Array<{ id: string; name: string; provider: string } | null> =
  selectedModelIds.map((modelId) => {
    const model = getModelById(modelId);
    if (!model) return null;
    return {
      id: model.id,
      name: model.model_name,
      provider: model.provider,
    };
  });
const selectedModels = modelInfoArray.filter(
  (m): m is { id: string; name: string; provider: string } => m !== null
);

// Calculate summary stats
const completedCount = results.filter((r) => r.status === 'completed').length;
const failedCount = results.filter((r) => r.status === 'failed').length;
const pendingCount = results.filter((r) => r.status === 'pending').length;

// Status for UI
const isRunning = run.status === 'running' || run.status === 'pending';
const progress = run.total_rows > 0 ? (run.processed_rows / run.total_rows) * 100 : 0;
---

<Layout title={`Bulk Evaluation ${run.id.slice(0, 8)}... - Eval AI`}>
  <!-- Pass run ID and initial status to client script -->
  <span id="run-id" data-run-id={id} data-is-running={isRunning} class="hidden"></span>

  <div class="space-y-6">
    <!-- Page Header with Back Button -->
    <div class="flex items-center gap-4 animate-reveal">
      <a href="/bulk-eval" class="btn btn-ghost btn-sm btn-circle">
        <Icon name="arrow-left" size="md" />
      </a>
      <div class="flex-1">
        <h1
          class="text-2xl md:text-3xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          Evaluation Run Details
        </h1>
        <p class="text-base-content/60 text-sm">
          Run ID: <span class="font-mono">{run.id.slice(0, 8)}...</span>
        </p>
      </div>
      <div id="run-status-badge" data-status={run.status}>
        <StatusBadge status={run.status as 'pending' | 'running' | 'completed' | 'failed'} />
      </div>
    </div>

    <!-- Run Metadata Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 animate-reveal delay-100">
      <!-- Dataset Info -->
      <div
        class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl"
      >
        <div class="card-body p-4">
          <div class="text-xs text-base-content/50 font-medium uppercase tracking-wider mb-1">
            Dataset
          </div>
          <div class="flex items-center gap-2">
            <Icon name="document" size="sm" class="text-base-content/40" />
            <div class="text-sm font-medium truncate" title={dataset.filename}>
              {dataset.filename}
            </div>
          </div>
          <div class="text-xs text-base-content/60 mt-1">{dataset.row_count} rows</div>
        </div>
      </div>

      <!-- Models Count -->
      <div
        class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl"
      >
        <div class="card-body p-4">
          <div class="text-xs text-base-content/50 font-medium uppercase tracking-wider mb-1">
            Models
          </div>
          <div class="flex items-center gap-2">
            <span class="badge badge-neutral">{selectedModels.length}</span>
            <div class="text-sm text-base-content/70">
              {selectedModels.length === 1 ? 'model' : 'models'}
            </div>
          </div>
          <div class="flex flex-wrap gap-1 mt-1">
            {
              selectedModels.map((model) => (
                <span class="badge badge-ghost badge-xs">{model.name}</span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Progress -->
      <div
        class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl"
      >
        <div class="card-body p-4">
          <div class="text-xs text-base-content/50 font-medium uppercase tracking-wider mb-1">
            Progress
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1 bg-base-300 rounded-full h-2">
              <div
                id="progress-bar"
                class={`h-2 rounded-full transition-all duration-300 ${progress === 100 ? 'bg-gradient-emerald' : 'bg-gradient-gold'}`}
                style={`width: ${progress}%`}
              >
              </div>
            </div>
            <span id="progress-text" class="text-sm font-mono text-base-content/70">
              {run.processed_rows}/{run.total_rows}
            </span>
          </div>
          <div class="text-xs text-base-content/60 mt-1">
            {Math.round(progress)}% complete
          </div>
        </div>
      </div>

      <!-- Summary Stats -->
      <div
        class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl"
      >
        <div class="card-body p-4">
          <div class="text-xs text-base-content/50 font-medium uppercase tracking-wider mb-1">
            Results
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div class="text-center">
              <div class="text-lg font-bold text-success" id="completed-count">
                {completedCount}
              </div>
              <div class="text-[10px] text-base-content/50 uppercase">Done</div>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-error" id="failed-count">
                {failedCount}
              </div>
              <div class="text-[10px] text-base-content/50 uppercase">Failed</div>
            </div>
            <div class="text-center">
              <div class="text-lg font-bold text-warning" id="pending-count">
                {pendingCount}
              </div>
              <div class="text-[10px] text-base-content/50 uppercase">Pending</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- System Prompt Preview -->
    <div
      class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl animate-reveal"
    >
      <div class="card-body p-4">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-sm font-semibold text-base-content/70">System Prompt</h3>
          <div class="badge badge-ghost badge-sm">Temperature: {run.temperature}</div>
        </div>
        <div
          class="bg-base-200 p-3 rounded-lg text-sm whitespace-pre-wrap max-h-24 overflow-y-auto"
        >
          {run.system_prompt}
        </div>
      </div>
    </div>

    <!-- Results Table (Server-Side Rendered) -->
    <div class="animate-reveal" id="results-table-wrapper">
      <ResultsTable dataset={dataset} run={run as EvaluationRun} results={results} />
    </div>

    <!-- Status Bar (shown during evaluation) -->
    <div id="status-bar" class={`sticky bottom-4 z-40 animate-reveal ${isRunning ? '' : 'hidden'}`}>
      <div
        class="card bg-base-100/95 backdrop-blur-sm border border-luxe-gold/50 shadow-elevated rounded-xl"
      >
        <div class="card-body p-4 flex items-center gap-4">
          <div class="flex items-center gap-3 flex-1">
            <span class="loading loading-spinner loading-sm text-luxe-emerald"></span>
            <div class="flex-1">
              <p class="font-semibold text-sm">Evaluation in progress...</p>
              <div class="w-full bg-base-300 rounded-full h-2 mt-1">
                <div
                  id="status-progress-bar"
                  class="bg-gradient-emerald h-2 rounded-full transition-all duration-300"
                  style={`width: ${progress}%`}
                >
                </div>
              </div>
            </div>
            <span id="status-progress-text" class="text-sm font-mono text-base-content/70"
              >{run.processed_rows} / {run.total_rows}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Drawer (hidden by default) -->
  <DetailDrawer allRowResults={[]} rowData={{} as Record<string, string>} rowIndex={0} />
</Layout>

<style>
  .bg-gradient-emerald {
    background: linear-gradient(135deg, #00ff87 0%, #00d9ff 100%);
  }
</style>

<script>
  import { addToast } from '@lib/ui/toastStore';
  import type { RowResult } from '@lib/db/bulk-db';

  // Declare the global function added by DetailDrawer
  declare global {
    interface Window {
      showBulkRowDetails?: (
        allRowResults: RowResult[],
        rowData: Record<string, string>,
        rowIndex: number
      ) => void;
    }
  }

  // Get run ID and initial status from data attribute
  const runIdEl = document.querySelector('[data-run-id]');
  const runId = runIdEl?.getAttribute('data-run-id');
  const initialIsRunning = runIdEl?.getAttribute('data-is-running') === 'true';

  if (!runId) {
    addToast('Run ID not found', 'error');
    window.location.href = '/bulk-eval';
  }

  /**
   * Handle bulk-row-view-details custom event
   * Dispatched when the View Details button is clicked
   */
  document.addEventListener('bulk-row-view-details', (e: Event) => {
    const customEvent = e as CustomEvent<{ rowIndex: number }>;
    const { rowIndex } = customEvent.detail;

    if (!runId) return;

    // Fetch row details and show drawer
    fetchRowDetails(rowIndex).then((data) => {
      if (window.showBulkRowDetails) {
        window.showBulkRowDetails(data.allRowResults, data.rowData, rowIndex);
      }
    });
  });

  /**
   * Fetch row details for the detail drawer
   */
  async function fetchRowDetails(rowIndex: number): Promise<{
    allRowResults: RowResult[];
    rowData: Record<string, string>;
  }> {
    const response = await fetch(`/api/bulk/result?run_id=${runId}&row_index=${rowIndex}`);

    if (!response.ok) {
      throw new Error('Failed to fetch row details');
    }

    return await response.json();
  }

  /**
   * Handle bulk-cell-regenerate custom event
   * Dispatched when user clicks regenerate on a specific cell
   */
  document.addEventListener('bulk-cell-regenerate', async (e: Event) => {
    const customEvent = e as CustomEvent<{ rowIndex: number; modelId: string }>;
    const { rowIndex, modelId } = customEvent.detail;

    if (!runId) return;

    // Show loading toast
    addToast(`Regenerating evaluation for row ${rowIndex + 1}...`, 'info', 0);

    // Find the cell to update its UI
    const cell = document.querySelector(
      `td[data-model-id="${modelId}"][data-row-index="${rowIndex}"]`
    );
    if (!cell) {
      addToast('Cell not found', 'error');
      return;
    }

    // Show loading state in cell
    const originalContent = cell.innerHTML;
    cell.innerHTML = `
      <div class="flex items-center gap-2 text-warning">
        <span class="loading loading-spinner loading-xs"></span>
        <span class="text-xs">Regenerating...</span>
      </div>
    `;

    try {
      const response = await fetch('/api/bulk/rerun-result', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: runId, row_index: rowIndex, model_id: modelId }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Failed to regenerate');
      }

      const data = await response.json();
      const { result_id } = data;

      // Poll for result completion
      await pollForResult(result_id, rowIndex, modelId, cell);

      // Show success toast
      addToast(`Row ${rowIndex + 1} regenerated successfully`, 'success');

      // Refresh the page to show updated results
      window.location.reload();
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Unknown error';
      addToast(`Failed to regenerate row ${rowIndex + 1}: ${errorMessage}`, 'error');
      // Restore original content on error
      cell.innerHTML = originalContent;
    }
  });

  /**
   * Poll for a single result to complete
   */
  async function pollForResult(
    resultId: string,
    rowIndex: number,
    modelId: string,
    cell: Element
  ): Promise<void> {
    const maxAttempts = 60; // 2 minutes with 2-second intervals
    let attempts = 0;

    while (attempts < maxAttempts) {
      try {
        const response = await fetch(`/api/bulk/result?result_id=${resultId}`);

        if (!response.ok) {
          throw new Error('Failed to fetch result status');
        }

        const data = await response.json();

        if (data.status === 'completed' || data.status === 'failed') {
          return; // Done, will refresh page
        }

        // Update loading state
        cell.innerHTML = `
          <div class="flex items-center gap-2 text-warning">
            <span class="loading loading-spinner loading-xs"></span>
            <span class="text-xs">Regenerating...</span>
          </div>
        `;

        await new Promise((resolve) => setTimeout(resolve, 2000));
        attempts++;
      } catch (err) {
        console.error('Error polling for result:', err);
        await new Promise((resolve) => setTimeout(resolve, 2000));
        attempts++;
      }
    }

    throw new Error('Timeout waiting for regeneration to complete');
  }

  /**
   * Polling configuration constants
   */
  const MAX_CONSECUTIVE_FAILURES = 10;
  const INITIAL_BACKOFF_MS = 1500;
  const MAX_BACKOFF_MS = 12000;
  const BACKOFF_MULTIPLIER = 2;

  interface BulkRunStatus {
    status: string;
    processed_rows: number;
    total_rows: number;
  }

  let isPolling = false;
  let pollInterval: number | null = null;
  let consecutiveFailures = 0;
  let currentBackoffMs = INITIAL_BACKOFF_MS;

  // DOM elements
  const statusBar = document.getElementById('status-bar');
  const statusProgressBar = document.getElementById('status-progress-bar');
  const statusProgressText = document.getElementById('status-progress-text');
  const runStatusBadge = document.getElementById('run-status-badge');
  const progressBar = document.getElementById('progress-bar');
  const progressText = document.getElementById('progress-text');
  const completedCount = document.getElementById('completed-count');
  const failedCount = document.getElementById('failed-count');
  const pendingCount = document.getElementById('pending-count');

  /**
   * Get status badge HTML
   */
  function getStatusBadge(status: string): string {
    const statusConfig: Record<string, { class: string; label: string }> = {
      pending: { class: 'status-pending', label: 'Pending' },
      running: { class: 'status-running', label: 'Running' },
      completed: { class: 'status-completed', label: 'Completed' },
      failed: { class: 'status-failed', label: 'Failed' },
    };
    const config = statusConfig[status] || { class: 'status-pending', label: status };
    return `<span class="${config.class}">${config.label}</span>`;
  }

  /**
   * Update status badge
   */
  function updateStatusBadge(status: string): void {
    if (runStatusBadge) {
      runStatusBadge.innerHTML = getStatusBadge(status);
      runStatusBadge.setAttribute('data-status', status);
    }
  }

  /**
   * Update progress bar
   */
  function updateProgress(processed: number, total: number): void {
    const percentage = total > 0 ? (processed / total) * 100 : 0;
    if (progressBar) {
      progressBar.style.width = `${percentage}%`;
      // Change color based on completion
      if (percentage === 100) {
        progressBar.classList.remove('bg-gradient-gold');
        progressBar.classList.add('bg-gradient-emerald');
      } else {
        progressBar.classList.remove('bg-gradient-emerald');
        progressBar.classList.add('bg-gradient-gold');
      }
    }
    if (progressText) {
      progressText.textContent = `${processed}/${total}`;
    }
  }

  /**
   * Update summary stats
   */
  function updateSummaryStats(summary: {
    completed_count: number;
    failed_count: number;
    pending_count: number;
  }): void {
    if (completedCount) completedCount.textContent = summary.completed_count.toString();
    if (failedCount) failedCount.textContent = summary.failed_count.toString();
    if (pendingCount) pendingCount.textContent = summary.pending_count.toString();
  }

  /**
   * Fetch latest status from API
   */
  async function fetchStatus(): Promise<void> {
    if (!runId) return;

    try {
      const response = await fetch(`/api/bulk/results?run_id=${runId}`);

      if (!response.ok) {
        if (response.status === 404) {
          addToast('Evaluation run not found', 'error');
          window.location.href = '/bulk-eval';
          return;
        }
        throw new Error('Failed to fetch run status');
      }

      const data: {
        run: BulkRunStatus;
        summary: { completed_count: number; failed_count: number; pending_count: number };
      } = await response.json();

      // Reset failure counter on successful request
      consecutiveFailures = 0;
      currentBackoffMs = INITIAL_BACKOFF_MS;

      // Update UI
      updateStatusBadge(data.run.status);
      updateProgress(data.run.processed_rows, data.run.total_rows);
      updateSummaryStats(data.summary);

      // Update status bar if running
      if (statusBar && statusProgressBar && statusProgressText) {
        const isRunning = data.run.status === 'running' || data.run.status === 'pending';
        statusBar.classList.toggle('hidden', !isRunning);
        if (isRunning) {
          const percentage = (data.run.processed_rows / data.run.total_rows) * 100;
          statusProgressBar.style.width = `${percentage}%`;
          statusProgressText.textContent = `${data.run.processed_rows} / ${data.run.total_rows}`;
        }
      }

      // Check if we should stop polling
      if (data.run.status === 'completed' || data.run.status === 'failed') {
        stopPolling();
        if (statusBar) {
          statusBar.classList.add('hidden');
        }

        if (data.run.status === 'completed') {
          addToast('Evaluation completed successfully!', 'success');
        } else if (data.run.status === 'failed') {
          addToast(`Evaluation failed`, 'error');
        }

        // Reload the page to show final results
        setTimeout(() => window.location.reload(), 1000);
      }
    } catch (error) {
      consecutiveFailures++;

      console.error(`[Polling error] Attempt ${consecutiveFailures}/${MAX_CONSECUTIVE_FAILURES}:`, {
        error: error instanceof Error ? error.message : 'Unknown error',
        runId,
        currentBackoff: currentBackoffMs,
      });

      // Check if we've exceeded max retries
      if (consecutiveFailures >= MAX_CONSECUTIVE_FAILURES) {
        stopPolling();
        if (statusBar) {
          statusBar.classList.add('hidden');
        }
        addToast(
          `Polling failed after ${MAX_CONSECUTIVE_FAILURES} attempts. Please refresh the page.`,
          'error'
        );
        return;
      }

      // Increase backoff time exponentially
      currentBackoffMs = Math.min(currentBackoffMs * BACKOFF_MULTIPLIER, MAX_BACKOFF_MS);
    }
  }

  /**
   * Start polling for status updates
   */
  function startPolling(): void {
    if (isPolling || !runId) return;

    isPolling = true;
    consecutiveFailures = 0;
    currentBackoffMs = INITIAL_BACKOFF_MS;

    // Poll immediately
    fetchStatus();

    // Set up recursive polling with variable backoff
    const scheduleNextPoll = () => {
      if (!isPolling) return;

      pollInterval = window.setTimeout(() => {
        fetchStatus().finally(() => {
          scheduleNextPoll();
        });
      }, currentBackoffMs);
    };

    scheduleNextPoll();
  }

  /**
   * Stop polling for status updates
   */
  function stopPolling(): void {
    if (pollInterval) {
      clearTimeout(pollInterval);
      pollInterval = null;
    }
    isPolling = false;
  }

  // Initialize - Start polling if run is in progress
  if (initialIsRunning) {
    startPolling();
  }

  // Cleanup on page unload
  window.addEventListener('beforeunload', stopPolling);
</script>
