---
/**
 * Training Data Page
 * Displays uploaded training pairs and provides CSV upload interface
 */

import Layout from '../../../../layouts/Layout.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import Badge from '../../../../components/ui/Badge.astro';
import CSVUploader from '../../../../components/CSVUploader.astro';
import PersonaTabs from '../../../../components/PersonaTabs.astro';
import { getPersona } from '@lib/db/persona-db';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/personas');
}

// Fetch persona
const persona = getPersona(id);
if (!persona) {
  return Astro.redirect('/personas');
}

// Fetch training pairs
const pairsResponse = await fetch(`${Astro.url.origin}/api/personas/${id}/training/pairs`);
const pairsData = await pairsResponse.json();
const trainingPairs = pairsData.pairs || [];
const pairCount = pairsData.count || 0;

// Breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: 'Training Data' },
];

// Helper function to get status variant
function getStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}
---

<Layout title={`Training Data - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="training-data" />

  <div class="container mx-auto">
    <!-- Upload Section -->
    <div class="mb-8 animate-reveal delay-200">
      <CSVUploader personaId={id} />
    </div>

    <!-- Training Pairs Section -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title text-2xl">
            Training Pairs
            <div class="badge badge-primary badge-lg">{pairCount}</div>
          </h2>

          <!-- Search Filter -->
          <div class="form-control">
            <div class="input-group">
              <input
                type="text"
                id="search-input"
                placeholder="Search by input..."
                class="input input-bordered w-64"
              />
              <button class="btn btn-square" id="search-btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>

        {
          pairCount === 0 ? (
            <div class="alert alert-info">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="stroke-current shrink-0 w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <div>
                <p class="font-semibold">No training data uploaded yet</p>
                <p class="text-sm">Upload a CSV file to add training pairs</p>
              </div>
            </div>
          ) : (
            <div class="overflow-x-auto">
              <table class="table table-zebra w-full" id="pairs-table">
                <thead>
                  <tr>
                    <th class="w-12">#</th>
                    <th class="w-2/5">Input</th>
                    <th class="w-2/5">Expected Output</th>
                    <th class="w-1/5">Created</th>
                  </tr>
                </thead>
                <tbody>
                  {trainingPairs.map((pair: any, index: number) => (
                    <tr class="pair-row" data-input={pair.input.toLowerCase()}>
                      <td>{index + 1}</td>
                      <td class="whitespace-pre-wrap wrap-break-word">{pair.input}</td>
                      <td class="whitespace-pre-wrap wrap-break-word">{pair.expected_output}</td>
                      <td class="text-sm text-base-content/60">
                        {new Date(pair.created_at).toLocaleDateString()}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>

              {/* Pagination info */}
              <div class="flex justify-between items-center mt-4">
                <div class="text-sm text-base-content/60">
                  Showing <span id="visible-count">{pairCount}</span> of{' '}
                  <span id="total-count">{pairCount}</span> pairs
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Actions -->
    <div class="flex justify-between mt-8">
      <a href={`/personas/${id}`} class="btn btn-ghost">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Persona
      </a>

      {
        pairCount >= 10 && persona.status === 'draft' && (
          <button class="btn btn-primary start-training-btn" data-persona-id={id}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            Start Training
          </button>
        )
      }
    </div>
  </div>
</Layout>

<script>
  // Search functionality
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn');
  const pairRows = document.querySelectorAll('.pair-row');
  const visibleCountEl = document.getElementById('visible-count');

  /**
   * Filters the training pairs table based on the search input.
   * Updates the visible row count in the UI.
   */
  function performSearch() {
    const searchTerm = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    pairRows.forEach((row) => {
      const input = (row as HTMLElement).dataset.input || '';

      if (searchTerm === '' || input.includes(searchTerm)) {
        (row as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = visibleCount.toString();
    }
  }

  // Search on button click
  searchBtn?.addEventListener('click', performSearch);

  // Search on Enter key
  searchInput?.addEventListener('keyup', (e) => {
    if (e.key === 'Enter') {
      performSearch();
    }
  });

  // Clear search when input is cleared
  searchInput?.addEventListener('input', () => {
    if (searchInput.value === '') {
      performSearch();
    }
  });

  // Start training button
  document.querySelectorAll('.start-training-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const personaId = button.dataset.personaId;

      if (!personaId) return;

      button.disabled = true;
      button.classList.add('loading');

      try {
        const response = await fetch(`/api/personas/${personaId}/training/start`, {
          method: 'POST',
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || 'Failed to start training');
        }

        // Redirect to metrics/training page
        window.location.href = `/personas/${personaId}/metrics`;
      } catch (error) {
        console.error('Failed to start training:', error);
        alert(
          `Failed to start training: ${error instanceof Error ? error.message : 'Unknown error'}`
        );
        button.disabled = false;
        button.classList.remove('loading');
      }
    });
  });
</script>
