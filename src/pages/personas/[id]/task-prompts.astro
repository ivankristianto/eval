---
/**
 * Task Prompts History Page
 * Displays version history of task prompts with diff viewer
 */
import Layout from '../../../layouts/Layout.astro';
import { getDatabase } from '../../../lib/db';
import Badge from '../../../components/ui/Badge.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import PersonaTabs from '../../../components/PersonaTabs.astro';
import PromptDiffViewer from '../../../components/PromptDiffViewer.astro';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/personas');
}

const db = getDatabase();

// Fetch persona
const persona = db.prepare('SELECT * FROM personas WHERE id = ?').get(id) as any;

if (!persona) {
  return Astro.redirect('/personas');
}

// Fetch prompt version history
const promptVersions = db
  .prepare(
    `SELECT * FROM task_prompt_versions
     WHERE persona_id = ?
     ORDER BY iteration_number DESC`
  )
  .all(id) as any[];

// Get current active prompt (latest version or initial prompt)
const currentPrompt =
  promptVersions.length > 0 ? promptVersions[0].prompt_text : persona.task_prompt;

/**
 * Maps persona status to DaisyUI color variants.
 * @param status - Persona lifecycle status
 * @returns Color variant string
 */
function getPersonaStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: 'Task Prompts' },
];
---

<Layout title={`Task Prompts - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getPersonaStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="task-prompts" />

  <div class="container mx-auto">
    <!-- Current Active Prompt -->
    <div class="card bg-base-200 shadow-lg mb-6 animate-reveal delay-200">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title">Current Active Task Prompt</h2>
          <Badge variant="primary" size="md">Active</Badge>
        </div>
        <div class="bg-base-300 rounded-lg p-4">
          <pre class="text-sm whitespace-pre-wrap">{currentPrompt}</pre>
        </div>
        {
          promptVersions.length > 0 && (
            <div class="text-xs text-base-content/60 mt-2">
              Last updated: Iteration {promptVersions[0].iteration_number} (
              {new Date(promptVersions[0].created_at).toLocaleDateString()})
            </div>
          )
        }
      </div>
    </div>

    <!-- Version History -->
    <div class="mb-6 animate-reveal delay-300">
      <h2 class="text-2xl font-bold mb-4">Version History</h2>

      {
        promptVersions.length === 0 ? (
          <div class="alert">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="stroke-info shrink-0 w-6 h-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>No task prompt versions yet. Versions will appear after training iterations.</span>
          </div>
        ) : (
          <div class="space-y-4">
            {promptVersions.map((version, index) => {
              const isLatest = index === 0;
              const previousVersion = promptVersions[index + 1];

              return (
                <div class="card bg-base-200 shadow">
                  <div class="card-body">
                    {/* Version Header */}
                    <div class="flex items-center justify-between mb-3">
                      <div class="flex items-center gap-3">
                        <h3 class="font-semibold text-lg">Iteration {version.iteration_number}</h3>
                        {isLatest && (
                          <Badge variant="primary" size="sm">
                            Current
                          </Badge>
                        )}
                        <Badge
                          variant={version.created_by === 'ai' ? 'info' : 'secondary'}
                          size="sm"
                        >
                          {version.created_by === 'ai' ? 'AI-Refined' : 'Human'}
                        </Badge>
                      </div>
                      <div class="text-sm text-base-content/60">
                        {new Date(version.created_at).toLocaleString()}
                      </div>
                    </div>

                    {/* Improvement Rationale */}
                    {version.improvement_rationale && (
                      <div class="mb-3">
                        <div class="text-xs font-semibold text-base-content/60 uppercase tracking-wide mb-1">
                          Rationale
                        </div>
                        <p class="text-sm">{version.improvement_rationale}</p>
                      </div>
                    )}

                    {/* Prompt Text */}
                    <div class="mb-3">
                      <div class="text-xs font-semibold text-base-content/60 uppercase tracking-wide mb-1">
                        Prompt Text
                      </div>
                      <div class="bg-base-300 rounded-lg p-3">
                        <pre class="text-sm whitespace-pre-wrap">{version.prompt_text}</pre>
                      </div>
                    </div>

                    {/* Compare with Previous */}
                    {previousVersion && (
                      <div class="card-actions justify-end">
                        <button
                          class="btn btn-sm btn-outline view-diff-btn"
                          data-current-id={version.id}
                          data-previous-id={previousVersion.id}
                          data-current-iteration={version.iteration_number}
                          data-previous-iteration={previousVersion.iteration_number}
                        >
                          Compare with Iteration {previousVersion.iteration_number}
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )
      }
    </div>

    <!-- Modals for each version pair -->
    {promptVersions.map((version, index) => {
      const previousVersion = promptVersions[index + 1];
      if (!previousVersion) return null;

      return (
        <dialog id={`diff-modal-${version.id}`} class="modal">
          <div class="modal-box max-w-5xl">
            <form method="dialog">
              <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
            </form>
            <h3 class="font-bold text-lg mb-4">
              Comparing Iteration {previousVersion.iteration_number} → {version.iteration_number}
            </h3>
            <PromptDiffViewer
              beforePrompt={previousVersion.prompt_text}
              afterPrompt={version.prompt_text}
              beforeLabel={`Iteration ${previousVersion.iteration_number}`}
              afterLabel={`Iteration ${version.iteration_number}`}
            />
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>close</button>
          </form>
        </dialog>
      );
    })}
  </div>
</Layout>

<script>
  // Handle "Compare with Previous" button clicks
  document.querySelectorAll('.view-diff-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const currentId = button.dataset.currentId;

      if (!currentId) return;

      // Show the corresponding modal
      const modal = document.getElementById(`diff-modal-${currentId}`) as HTMLDialogElement;
      modal?.showModal();
    });
  });
</script>
