---
/**
 * Human Review Page
 * Displays judge decisions for an iteration and collects human feedback
 * Route: /personas/:id/review/:iteration
 */
import Layout from '../../../../layouts/Layout.astro';
import JudgeDecisionReview from '../../../../components/JudgeDecisionReview.astro';
import Badge from '../../../../components/ui/Badge.astro';
import Breadcrumbs from '../../../../components/ui/Breadcrumbs.astro';
import PersonaTabs from '../../../../components/PersonaTabs.astro';
import { getDatabase } from '../../../../lib/db';

const { id, iteration } = Astro.params;

if (!id || !iteration) {
  return Astro.redirect('/personas');
}

const iterationNumber = parseInt(iteration, 10);
if (isNaN(iterationNumber)) {
  return Astro.redirect(`/personas/${id}`);
}

const db = getDatabase();

// Fetch persona
const persona = db.prepare('SELECT * FROM personas WHERE id = ?').get(id) as any;

if (!persona) {
  return Astro.redirect('/personas');
}

// Fetch iteration
const iterationData = db
  .prepare('SELECT * FROM training_iterations WHERE persona_id = ? AND iteration_number = ?')
  .get(id, iterationNumber) as any;

if (!iterationData) {
  return Astro.redirect(`/personas/${id}`);
}

// Fetch all judge decisions with training pair info and human review status
const decisions = db
  .prepare(
    `
    SELECT
      jd.id as decision_id,
      jd.generated_output,
      jd.judge_decision,
      jd.judge_confidence,
      jd.judge_reasoning,
      jd.created_at as decision_created_at,
      tp.id as training_pair_id,
      tp.input,
      tp.expected_output,
      hr.id as review_id,
      hr.human_decision,
      hr.human_confidence,
      hr.human_notes,
      hr.created_at as review_created_at
    FROM judge_decisions jd
    JOIN training_pairs tp ON tp.id = jd.training_pair_id
    LEFT JOIN human_reviews hr ON hr.judge_decision_id = jd.id
    WHERE jd.iteration_id = ?
    ORDER BY tp.created_at ASC
  `
  )
  .all(iterationData.id) as any[];

// Format decisions for component
const formattedDecisions = decisions.map((d) => ({
  decision_id: d.decision_id,
  training_pair: {
    id: d.training_pair_id,
    input: d.input,
    expected_output: d.expected_output,
  },
  judge: {
    generated_output: d.generated_output,
    decision: d.judge_decision,
    confidence: d.judge_confidence,
    reasoning: d.judge_reasoning,
    created_at: d.decision_created_at,
  },
  human_review: d.review_id
    ? {
        id: d.review_id,
        decision: d.human_decision,
        confidence: d.human_confidence,
        notes: d.human_notes,
        created_at: d.review_created_at,
      }
    : null,
}));

// Calculate summary
const totalDecisions = formattedDecisions.length;
const reviewedDecisions = formattedDecisions.filter((d) => d.human_review !== null).length;
const pendingDecisions = totalDecisions - reviewedDecisions;
const progressPercentage =
  totalDecisions > 0 ? Math.round((reviewedDecisions / totalDecisions) * 100) : 0;

// Helper function to get persona status variant
function getPersonaStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

// Get iteration status variant
function getIterationStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'in_progress':
      return 'info';
    case 'completed':
      return 'success';
    case 'paused':
      return 'warning';
    case 'failed':
      return 'error';
    default:
      return 'info';
  }
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: `Review Iteration ${iterationNumber}` },
];
---

<Layout title={`Review Iteration ${iterationNumber} - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getPersonaStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="training-progress" />

  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Review Iteration {iterationNumber}</h1>
    <p class="text-base-content/70 mb-4">
      Review judge decisions and provide human feedback to calculate metrics.
    </p>

    <!-- Progress Summary -->
    <div class="card bg-base-200 shadow-lg mb-6">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title">Review Progress</h2>
          <Badge variant={getIterationStatusVariant(iterationData.status)} size="md">
            {iterationData.status}
          </Badge>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
              Total Decisions
            </div>
            <div class="text-2xl font-bold font-mono">{totalDecisions}</div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Reviewed</div>
            <div class="text-2xl font-bold font-mono text-success">
              {reviewedDecisions}
            </div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Pending</div>
            <div class="text-2xl font-bold font-mono text-warning">
              {pendingDecisions}
            </div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Progress</div>
            <div class="text-2xl font-bold font-mono">{progressPercentage}%</div>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="mt-4">
          <progress
            class="progress progress-success w-full"
            value={reviewedDecisions}
            max={totalDecisions}></progress>
        </div>

        {
          pendingDecisions === 0 && (
            <div class="alert alert-success mt-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-current shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <div class="flex-1">
                <span>
                  All decisions have been reviewed! You can now calculate metrics for this iteration.
                </span>
              </div>
              <button
                class="btn btn-primary calculate-metrics-btn"
                data-persona-id={id}
                data-iteration={iterationNumber}
              >
                Calculate Metrics & Continue
              </button>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Decisions List -->
  {
    formattedDecisions.length === 0 ? (
      <div class="alert alert-info">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="stroke-current shrink-0 w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>No decisions found for this iteration.</span>
      </div>
    ) : (
      <div class="space-y-6">
        {formattedDecisions.map((decision, index) => (
          <div>
            <div class="text-sm font-semibold text-base-content/60 mb-2">
              Decision {index + 1} of {totalDecisions}
            </div>
            <JudgeDecisionReview
              decision={decision}
              personaId={id}
              iterationNumber={iterationNumber}
            />
          </div>
        ))}
      </div>
    )
  }
</Layout>

<script>
  import { addToast } from '../../../../lib/toastStore';

  // Calculate metrics button
  document.querySelectorAll('.calculate-metrics-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const personaId = button.dataset.personaId;
      const iteration = button.dataset.iteration;

      if (!personaId || !iteration) return;

      if (
        !confirm(
          'Calculate metrics for this iteration? This will complete the current iteration and determine if training should continue.'
        )
      ) {
        return;
      }

      button.disabled = true;
      button.classList.add('loading');

      try {
        const response = await fetch(
          `/api/personas/${personaId}/iterations/${iteration}/calculate-metrics`,
          {
            method: 'POST',
          }
        );

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || 'Failed to calculate metrics');
        }

        const result = await response.json();

        if (result.status === 'training_complete') {
          addToast(
            `Training complete! ${result.reason === 'target_reached' ? 'Target F1 score reached' : 'Maximum iterations reached'}`,
            'success'
          );
          // Redirect to metrics page
          window.location.href = `/personas/${personaId}/metrics`;
        } else if (result.status === 'continue') {
          addToast('Metrics calculated! Next iteration started.', 'success');
          // Redirect to next iteration review page
          const nextIteration = result.next_iteration.iteration_number;
          window.location.href = `/personas/${personaId}/review/${nextIteration}`;
        }
      } catch (error) {
        console.error('Failed to calculate metrics:', error);
        addToast(
          `Failed to calculate metrics: ${error instanceof Error ? error.message : 'Unknown error'}`,
          'error'
        );
        button.disabled = false;
        button.classList.remove('loading');
      }
    });
  });
</script>
