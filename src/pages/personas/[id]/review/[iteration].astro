---
/**
 * Human Review Page for Iteration
 *
 * Allows human reviewers to evaluate judge decisions from iteration 1.
 * After completing all reviews, provides button to calculate metrics.
 *
 * Flow:
 * 1. Display each judge decision with input, expected output, and model output
 * 2. Human reviews: Agree or Disagree with judge's assessment
 * 3. Optional notes for feedback
 * 4. Submit each decision
 * 5. When all reviewed: Show "Calculate Metrics" button
 * 6. Clicking redirects to /metrics page with iteration parameter
 *
 * Phase 12 Enhancement: Async metrics calculation with polling
 */
import Layout from '@layouts/Layout.astro';
import JudgeDecisionReview from '@components/JudgeDecisionReview.astro';
import Badge from '@components/ui/Badge.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import PersonaTabs from '@components/PersonaTabs.astro';
import { getDatabase } from '@lib/db';
import { notFound } from '@lib/api-error-handler';

const { id, iteration } = Astro.params;

if (!id || !iteration) {
  return Astro.redirect('/personas');
}

const iterationNumber = parseInt(iteration, 10);
if (isNaN(iterationNumber) || iterationNumber < 1) {
  return Astro.redirect(`/personas/${id}`);
}

const db = getDatabase();

// Fetch persona
const persona = db.prepare('SELECT * FROM personas WHERE id = ?').get(id) as any | undefined;

if (!persona) {
  return notFound('Persona');
}

// Fetch iteration
const iterationData = db
  .prepare(
    `SELECT ti.*, tls.status as loop_status
     FROM training_iterations ti
     LEFT JOIN training_loop_state tls ON tls.persona_id = ti.persona_id
       AND tls.current_iteration = ti.iteration_number
     WHERE ti.persona_id = ? AND ti.iteration_number = ?`
  )
  .get(id, iterationNumber) as any | undefined;

if (!iterationData) {
  return notFound('Iteration');
}

// Fetch judge decisions with human review status
const decisions = db
  .prepare(
    `SELECT
       jd.id,
       jd.generated_output,
       jd.judge_decision,
       jd.judge_confidence,
       jd.judge_reasoning,
       tp.input,
       tp.expected_output,
       hr.id as review_id,
       hr.human_decision,
       hr.human_confidence,
       hr.human_notes,
       hr.created_at as review_created_at
     FROM judge_decisions jd
     JOIN training_pairs tp ON tp.id = jd.training_pair_id
     LEFT JOIN human_reviews hr ON hr.judge_decision_id = jd.id
     WHERE jd.iteration_id = ?
     ORDER BY tp.id`
  )
  .all(iterationData.id) as any[];

// Calculate review progress
const totalDecisions = decisions.length;
const reviewedDecisions = decisions.filter((d) => d.review_id).length;
const pendingDecisions = totalDecisions - reviewedDecisions;
const progressPercentage =
  totalDecisions > 0 ? Math.round((reviewedDecisions / totalDecisions) * 100) : 0;
const isComplete = reviewedDecisions === totalDecisions && totalDecisions > 0;

// Format decisions for component
const formattedDecisions = decisions.map((d) => ({
  decision_id: d.id,
  training_pair: {
    id: d.id,
    input: d.input,
    expected_output: d.expected_output,
  },
  judge: {
    generated_output: d.generated_output,
    decision: d.judge_decision,
    confidence: d.judge_confidence,
    reasoning: d.judge_reasoning,
  },
  human_review: d.review_id
    ? {
        id: d.review_id,
        decision: d.human_decision,
        confidence: d.human_confidence,
        notes: d.human_notes,
        created_at: d.review_created_at,
      }
    : null,
}));

// Helper function to get persona status variant
function getPersonaStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

// Get iteration status variant
function getIterationStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'in_progress':
      return 'info';
    case 'completed':
      return 'success';
    case 'paused':
      return 'warning';
    case 'failed':
      return 'error';
    default:
      return 'info';
  }
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: `Review Iteration ${iterationNumber}` },
];
---

<Layout title={`Review Iteration ${iterationNumber} - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getPersonaStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="training-progress" />

  <div class="mb-8">
    <h1 class="text-3xl font-bold mb-2">Review Iteration {iterationNumber}</h1>
    <p class="text-base-content/70 mb-4">
      Review judge decisions and provide human feedback to calculate metrics.
    </p>

    <!-- Progress Summary -->
    <div class="card bg-base-200 shadow-lg mb-6">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="card-title">Review Progress</h2>
          <Badge variant={getIterationStatusVariant(iterationData.status)} size="md">
            {iterationData.status}
          </Badge>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">
              Total Decisions
            </div>
            <div class="text-2xl font-bold font-mono">{totalDecisions}</div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Reviewed</div>
            <div class="text-2xl font-bold font-mono text-success">
              {reviewedDecisions}
            </div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Pending</div>
            <div class="text-2xl font-bold font-mono text-warning">
              {pendingDecisions}
            </div>
          </div>

          <div>
            <div class="text-xs text-base-content/60 uppercase tracking-wide mb-1">Progress</div>
            <div class="text-2xl font-bold font-mono text-primary">
              {progressPercentage}%
            </div>
          </div>
        </div>

        <progress class="progress progress-primary w-full mt-4" value={progressPercentage} max="100"
        ></progress>
      </div>
    </div>

    <!-- Phase 12: Complete State - Show Calculate Metrics Button -->
    {
      isComplete && (
        <div class="alert alert-success mb-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 shrink-0 stroke-current"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <div class="flex-1">
            <h3 class="font-bold">All Decisions Reviewed!</h3>
            <p>You have completed reviewing all {totalDecisions} judge decisions.</p>
          </div>
          <a
            id="calculate-metrics-btn"
            href="#"
            data-persona-id={id}
            data-iteration={iterationNumber}
            class="btn btn-primary"
          >
            Calculate Metrics
          </a>
        </div>
      )
    }

    <!-- No Decisions State -->
    {
      totalDecisions === 0 && (
        <div class="alert alert-warning mb-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 shrink-0 stroke-current"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            />
          </svg>
          <div>
            <h3 class="font-bold">No Decisions to Review</h3>
            <p>There are no judge decisions for this iteration yet.</p>
          </div>
        </div>
      )
    }

    <!-- Decision Reviews -->
    <div class="space-y-6">
      {
        formattedDecisions.map((decision) => (
          <JudgeDecisionReview
            decision={decision}
            iterationNumber={iterationNumber}
            personaId={id}
          />
        ))
      }
    </div>
  </div>
</Layout>

<script>
  /**
   * Handle Calculate Metrics button click
   * Makes POST request and redirects to metrics page
   */
  function handleCalculateMetrics(event: Event) {
    event.preventDefault();

    const button = event.currentTarget as HTMLAnchorElement;
    const personaId = button.dataset.personaId;
    const iteration = button.dataset.iteration;

    if (!personaId || !iteration) {
      alert('Missing required data');
      return;
    }

    button.disabled = true;
    button.innerHTML = '<span class="loading loading-spinner"></span> Starting...';

    fetch(`/api/personas/${personaId}/iterations/${iteration}/calculate-metrics`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
    })
      .then((response) => {
        if (!response.ok) {
          return response.json().then((data) => {
            throw new Error(data.message || 'Failed to start metrics calculation');
          });
        }
        // Redirect to metrics page
        window.location.href = `/personas/${personaId}/metrics?iteration=${iteration}`;
      })
      .catch((error) => {
        button.disabled = false;
        button.textContent = 'Calculate Metrics';
        alert(`Failed to start metrics calculation: ${error.message || 'Unknown error'}`);
      });
  }

  // Set up event listener when DOM is fully ready
  document.addEventListener('DOMContentLoaded', () => {
    const calculateBtn = document.getElementById('calculate-metrics-btn');
    if (calculateBtn) {
      calculateBtn.addEventListener('click', handleCalculateMetrics);
    }
  });
</script>
