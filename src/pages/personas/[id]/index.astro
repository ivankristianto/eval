---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Badge from '../../../components/ui/Badge.astro';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/personas');
}

// Fetch persona details
let persona: any = null;
let error: string | null = null;

try {
  const response = await fetch(new URL(`/api/personas/${id}`, Astro.url.origin).toString());

  if (response.ok) {
    persona = await response.json();
  } else if (response.status === 404) {
    error = 'Persona not found';
  } else {
    error = 'Failed to load persona';
  }
} catch (e) {
  console.error('Error fetching persona:', e);
  error = 'Failed to load persona';
}

if (error || !persona) {
  return Astro.redirect('/personas');
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name },
];

// Helper function to get status variant
function getStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

// Get current tab from query param (default: overview)
const currentTab = Astro.url.searchParams.get('tab') || 'overview';
---

<Layout title={`${persona.name} - Persona Details`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold">
          {persona.name}
        </h1>
        <Badge variant={getStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>

    <div class="flex gap-3">
      {
        persona.status === 'draft' && (
          <button class="btn btn-success btn-lg" id="start-training-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            Start Training
          </button>
        )
      }

      <button class="btn btn-error btn-outline" id="delete-persona-btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
          ></path>
        </svg>
        Delete
      </button>
    </div>
  </div>

  <!-- Tabs -->
  <div class="tabs tabs-boxed bg-base-200 mb-8 animate-reveal delay-100">
    <a
      href={`/personas/${id}?tab=overview`}
      class={`tab tab-lg ${currentTab === 'overview' ? 'tab-active' : ''}`}
    >
      Overview
    </a>
    <a
      href={`/personas/${id}?tab=training-data`}
      class={`tab tab-lg ${currentTab === 'training-data' ? 'tab-active' : ''}`}
    >
      Training Data
    </a>
    <a
      href={`/personas/${id}?tab=training-progress`}
      class={`tab tab-lg ${currentTab === 'training-progress' ? 'tab-active' : ''}`}
    >
      Training Progress
    </a>
    <a
      href={`/personas/${id}?tab=prompts`}
      class={`tab tab-lg ${currentTab === 'prompts' ? 'tab-active' : ''}`}
    >
      Judge Prompts
    </a>
    <a
      href={`/personas/${id}?tab=settings`}
      class={`tab tab-lg ${currentTab === 'settings' ? 'tab-active' : ''}`}
    >
      Settings
    </a>
  </div>

  <!-- Tab Content -->
  {
    currentTab === 'overview' && (
      <div class="space-y-8 animate-reveal delay-200">
        <!-- Persona Info Card -->
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Persona Information</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Task Prompt
                </div>
                <p class="text-base-content bg-base-300 p-4 rounded-lg whitespace-pre-wrap">
                  {persona.task_prompt}
                </p>
              </div>

              <div class="space-y-4">
                <div>
                  <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                    Target F1 Score
                  </div>
                  <div class="font-mono font-semibold text-2xl text-primary">
                    {(persona.target_f1_score * 100).toFixed(0)}%
                  </div>
                </div>

                <div>
                  <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                    Max Iterations
                  </div>
                  <div class="font-mono font-semibold text-2xl">{persona.max_iterations}</div>
                </div>

                <div>
                  <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                    Current Iteration
                  </div>
                  <div class="font-mono font-semibold text-2xl">{persona.current_iteration}</div>
                </div>

                {persona.best_f1_score !== null && (
                  <div>
                    <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                      Best F1 Score
                    </div>
                    <div class="font-mono font-semibold text-2xl text-success">
                      {(persona.best_f1_score * 100).toFixed(1)}%
                    </div>
                    <div class="text-sm text-base-content/60">
                      (Iteration {persona.best_f1_iteration})
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        <!-- Model Configuration Card -->
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Model Configuration</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Task Model
                </div>
                <div class="font-mono text-lg">{persona.task_model_id}</div>
              </div>

              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Judge Model
                </div>
                <div class="font-mono text-lg">{persona.judge_model_id}</div>
              </div>

              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Prompt Engineer Model
                </div>
                <div class="font-mono text-lg">{persona.prompt_engineer_model_id}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Metadata Card -->
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Metadata</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Created At
                </div>
                <div>{new Date(persona.created_at).toLocaleString()}</div>
              </div>

              <div>
                <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                  Updated At
                </div>
                <div>{new Date(persona.updated_at).toLocaleString()}</div>
              </div>

              {persona.created_by && (
                <div>
                  <div class="text-base-content/60 text-sm uppercase tracking-wide mb-2">
                    Created By
                  </div>
                  <div>{persona.created_by}</div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    currentTab === 'settings' && (
      <div class="animate-reveal delay-200">
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h2 class="card-title text-2xl mb-6">Persona Settings</h2>

            <form id="update-persona-form" class="space-y-6">
              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Persona Name</span>
                </label>
                <input
                  type="text"
                  name="name"
                  value={persona.name}
                  class="input input-bordered w-full"
                  required
                />
              </div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Description</span>
                </label>
                <textarea
                  name="description"
                  class="textarea textarea-bordered w-full h-24"
                  value={persona.description || ''}
                />
              </div>

              <div class="form-control">
                <label class="label">
                  <span class="label-text font-semibold">Task Prompt</span>
                </label>
                <textarea
                  name="task_prompt"
                  class="textarea textarea-bordered w-full h-32"
                  required
                  value={persona.task_prompt}
                />
                <label class="label">
                  <span class="label-text-alt text-base-content/60">
                    The prompt used to generate outputs that will be judged
                  </span>
                </label>
              </div>

              <div class="card-actions justify-end">
                <button type="button" class="btn btn-ghost" onclick="history.back()">
                  Cancel
                </button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    )
  }

  {
    (currentTab === 'training-data' ||
      currentTab === 'training-progress' ||
      currentTab === 'prompts') && (
      <div class="card bg-base-200 shadow-xl animate-reveal delay-200">
        <div class="card-body">
          <div class="text-center py-16">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-24 w-24 mx-auto mb-4 text-base-content/40"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
              />
            </svg>
            <h3 class="text-2xl font-semibold mb-2">Coming Soon</h3>
            <p class="text-base-content/60">
              This feature is under development and will be available in a future update.
            </p>
          </div>
        </div>
      </div>
    )
  }
</Layout>

<script>
  import { addToast } from '../../../lib/toastStore';

  const personaId = window.location.pathname.split('/')[2];

  // Delete persona
  document.getElementById('delete-persona-btn')?.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to delete this persona? This action cannot be undone.')) {
      return;
    }

    try {
      const response = await fetch(`/api/personas/${personaId}`, {
        method: 'DELETE',
      });

      if (response.ok) {
        addToast('Persona deleted successfully', 'success');
        window.location.href = '/personas';
      } else {
        const data = await response.json();
        addToast(data.message || 'Failed to delete persona', 'error');
      }
    } catch (error) {
      console.error('Delete error:', error);
      addToast('Failed to delete persona', 'error');
    }
  });

  // Start training (placeholder)
  document.getElementById('start-training-btn')?.addEventListener('click', () => {
    addToast('Training feature will be available in the next phase', 'info');
  });

  // Update persona form
  document.getElementById('update-persona-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const data = {
      name: formData.get('name') as string,
      description: formData.get('description') as string,
      task_prompt: formData.get('task_prompt') as string,
    };

    try {
      const response = await fetch(`/api/personas/${personaId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        addToast('Persona updated successfully', 'success');
        // Refresh the page to show updated data
        window.location.reload();
      } else {
        const result = await response.json();
        addToast(result.message || 'Failed to update persona', 'error');
      }
    } catch (error) {
      console.error('Update error:', error);
      addToast('Failed to update persona', 'error');
    }
  });
</script>
