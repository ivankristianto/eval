---
/**
 * Metrics Dashboard Page
 * Displays training metrics and iteration history for a persona
 * Route: /personas/:id/metrics
 */
import Layout from '../../../layouts/Layout.astro';
import TrainingDashboard from '../../../components/TrainingDashboard.astro';
import ConfusionMatrix from '../../../components/ConfusionMatrix.astro';
import Badge from '../../../components/ui/Badge.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import PersonaTabs from '../../../components/PersonaTabs.astro';
import { getDatabase } from '../../../lib/db';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/personas');
}

const db = getDatabase();

// Fetch persona
const persona = db.prepare('SELECT * FROM personas WHERE id = ?').get(id) as any;

if (!persona) {
  return Astro.redirect('/personas');
}

// Fetch all iterations with metrics
const iterations = db
  .prepare(
    `
    SELECT
      ti.id,
      ti.iteration_number,
      ti.status,
      ti.total_pairs_evaluated,
      ti.pairs_reviewed_by_human,
      ti.started_at,
      ti.completed_at,
      im.f1_score,
      im.precision,
      im.recall,
      im.cohens_kappa,
      im.accuracy,
      im.true_positives,
      im.true_negatives,
      im.false_positives,
      im.false_negatives
    FROM training_iterations ti
    LEFT JOIN iteration_metrics im ON im.iteration_id = ti.id
    WHERE ti.persona_id = ?
    ORDER BY ti.iteration_number ASC
  `
  )
  .all(id) as any[];

// Get latest iteration with metrics
const latestIterationWithMetrics = iterations
  .filter((i) => i.f1_score !== null)
  .sort((a, b) => b.iteration_number - a.iteration_number)[0];

const latestMetrics = latestIterationWithMetrics
  ? {
      f1_score: latestIterationWithMetrics.f1_score,
      precision: latestIterationWithMetrics.precision,
      recall: latestIterationWithMetrics.recall,
      cohens_kappa: latestIterationWithMetrics.cohens_kappa,
      accuracy: latestIterationWithMetrics.accuracy,
      confusion_matrix: {
        true_positives: latestIterationWithMetrics.true_positives,
        true_negatives: latestIterationWithMetrics.true_negatives,
        false_positives: latestIterationWithMetrics.false_positives,
        false_negatives: latestIterationWithMetrics.false_negatives,
      },
    }
  : null;

// Helper function to get persona status variant
function getPersonaStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

// Get iteration status variant
function getIterationStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'in_progress':
      return 'info';
    case 'completed':
      return 'success';
    case 'paused':
      return 'warning';
    case 'failed':
      return 'error';
    default:
      return 'info';
  }
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: 'Metrics' },
];
---

<Layout title={`Metrics - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getPersonaStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="metrics" />

  <!-- Training Dashboard with Chart -->
  <div class="mb-8 animate-reveal delay-200">
    <TrainingDashboard personaId={id} showChart={true} />
  </div>

  <!-- Detailed Confusion Matrix (if metrics exist) -->
  {
    latestMetrics && (
      <div class="mb-8 animate-reveal delay-300">
        <h2 class="text-xl font-semibold mb-4">
          Detailed Analysis (Iteration {latestIterationWithMetrics.iteration_number})
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <ConfusionMatrix matrix={latestMetrics.confusion_matrix} />

          <div class="card bg-base-200 shadow-md">
            <div class="card-body">
              <h3 class="card-title text-lg mb-4">Cohen's Kappa</h3>
              <div class="text-center">
                <div class="text-5xl font-bold font-mono text-primary mb-2">
                  {latestMetrics.cohens_kappa !== null
                    ? latestMetrics.cohens_kappa.toFixed(3)
                    : 'N/A'}
                </div>
                <p class="text-sm text-base-content/70">
                  Measures agreement between judge and human, accounting for chance.
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-base-content/10">
                <div class="text-xs text-base-content/60 uppercase tracking-wide mb-2">
                  Interpretation
                </div>
                <div class="space-y-1 text-sm">
                  <div>&lt; 0.20: Poor agreement</div>
                  <div>0.21-0.40: Fair agreement</div>
                  <div>0.41-0.60: Moderate agreement</div>
                  <div>0.61-0.80: Substantial agreement</div>
                  <div>0.81-1.00: Almost perfect agreement</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <!-- Iteration History -->
  <div class="animate-reveal delay-300">
    <h2 class="text-xl font-semibold mb-4">Iteration History</h2>

    {
      iterations.length === 0 ? (
        <div class="alert alert-info">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="stroke-current shrink-0 w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <span>No training iterations found.</span>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="table table-zebra w-full">
            <thead>
              <tr>
                <th>Iteration</th>
                <th>Status</th>
                <th>Pairs Evaluated</th>
                <th>Human Reviews</th>
                <th>F1 Score</th>
                <th>Precision</th>
                <th>Recall</th>
                <th>Accuracy</th>
                <th>Started</th>
              </tr>
            </thead>
            <tbody>
              {iterations.map((iteration) => (
                <tr>
                  <td class="font-mono font-semibold">{iteration.iteration_number}</td>
                  <td>
                    <Badge variant={getIterationStatusVariant(iteration.status)} size="sm">
                      {iteration.status}
                    </Badge>
                  </td>
                  <td class="font-mono">{iteration.total_pairs_evaluated}</td>
                  <td class="font-mono">{iteration.pairs_reviewed_by_human}</td>
                  <td class="font-mono">
                    {iteration.f1_score !== null
                      ? `${(iteration.f1_score * 100).toFixed(1)}%`
                      : '—'}
                  </td>
                  <td class="font-mono">
                    {iteration.precision !== null
                      ? `${(iteration.precision * 100).toFixed(1)}%`
                      : '—'}
                  </td>
                  <td class="font-mono">
                    {iteration.recall !== null ? `${(iteration.recall * 100).toFixed(1)}%` : '—'}
                  </td>
                  <td class="font-mono">
                    {iteration.accuracy !== null
                      ? `${(iteration.accuracy * 100).toFixed(1)}%`
                      : '—'}
                  </td>
                  <td>{new Date(iteration.started_at).toLocaleDateString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</Layout>
