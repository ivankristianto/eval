---
/**
 * Metrics Dashboard Page
 * Displays training metrics and iteration history for a persona
 * Route: /personas/:id/metrics
 *
 * Phase 12 Enhancement: Supports async metrics calculation with polling
 */
import Layout from '@layouts/Layout.astro';
import TrainingDashboard from '@components/TrainingDashboard.astro';
import ConfusionMatrix from '@components/ConfusionMatrix.astro';
import Badge from '@components/ui/Badge.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import PersonaTabs from '@components/PersonaTabs.astro';
import MetricsCalculationProgress from '@components/MetricsCalculationProgress.astro';
import MetricCard from '@components/MetricCard.astro';
import { getDatabase } from '@lib/db';
import { notFound } from '@lib/api-error-handler';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/personas');
}

// Read iteration from query parameter (e.g., ?iteration=3)
const queryIteration = Astro.url.searchParams.get('iteration');
const iteration = queryIteration ? parseInt(queryIteration, 10) : undefined;

const db = getDatabase();

// Fetch persona
const persona = db.prepare('SELECT * FROM personas WHERE id = ?').get(id) as any | undefined;

if (!persona) {
  return notFound('Persona');
}

// Fetch iteration data
let iterationData: any = null;
if (iteration) {
  iterationData = db
    .prepare(
      `SELECT ti.*, tls.status as loop_status
       FROM training_iterations ti
       LEFT JOIN training_loop_state tls ON tls.persona_id = ti.persona_id
         AND tls.current_iteration = ti.iteration_number
       WHERE ti.persona_id = ? AND ti.iteration_number = ?`
    )
    .get(id, iteration);
} else {
  iterationData = db
    .prepare(
      `SELECT ti.*, tls.status as loop_status
       FROM training_iterations ti
       LEFT JOIN training_loop_state tls ON tls.persona_id = ti.persona_id
         AND tls.current_iteration = ti.iteration_number
       WHERE ti.persona_id = ?
       ORDER BY ti.iteration_number DESC
       LIMIT 1`
    )
    .get(id);
}

// Fetch metrics if iteration exists
let metrics: any = null;
if (iterationData?.id) {
  const rawMetrics = db
    .prepare('SELECT * FROM iteration_metrics WHERE iteration_id = ?')
    .get(iterationData.id) as any | undefined;

  // Transform to have same structure as latestMetrics
  if (rawMetrics) {
    metrics = {
      f1_score: rawMetrics.f1_score,
      precision: rawMetrics.precision,
      recall: rawMetrics.recall,
      cohens_kappa: rawMetrics.cohens_kappa,
      accuracy: rawMetrics.accuracy,
      confusion_matrix: {
        true_positives: rawMetrics.true_positives,
        true_negatives: rawMetrics.true_negatives,
        false_positives: rawMetrics.false_positives,
        false_negatives: rawMetrics.false_negatives,
      },
    };
  }
}

// Fetch all iterations with metrics
const iterations = db
  .prepare(
    `
    SELECT
      ti.id,
      ti.iteration_number,
      ti.status,
      ti.total_pairs_evaluated,
      ti.pairs_reviewed_by_human,
      ti.started_at,
      ti.completed_at,
      im.f1_score,
      im.precision,
      im.recall,
      im.cohens_kappa,
      im.accuracy,
      im.true_positives,
      im.true_negatives,
      im.false_positives,
      im.false_negatives,
      im.calculated_at
    FROM training_iterations ti
    LEFT JOIN iteration_metrics im ON im.iteration_id = ti.id
    WHERE ti.persona_id = ?
    ORDER BY ti.iteration_number ASC
  `
  )
  .all(id) as any[];

// Get latest iteration with metrics
const latestIterationWithMetrics = iterations
  .filter((i) => i.f1_score !== null)
  .sort((a, b) => b.iteration_number - a.iteration_number)[0];

const latestMetrics = latestIterationWithMetrics
  ? {
      f1_score: latestIterationWithMetrics.f1_score,
      precision: latestIterationWithMetrics.precision,
      recall: latestIterationWithMetrics.recall,
      cohens_kappa: latestIterationWithMetrics.cohens_kappa,
      accuracy: latestIterationWithMetrics.accuracy,
      confusion_matrix: {
        true_positives: latestIterationWithMetrics.true_positives,
        true_negatives: latestIterationWithMetrics.true_negatives,
        false_positives: latestIterationWithMetrics.false_positives,
        false_negatives: latestIterationWithMetrics.false_negatives,
      },
    }
  : null;

// Use current iteration metrics or latest metrics (for ConfusionMatrix display regardless of iteration)
const displayMetrics = metrics || latestMetrics;

// Determine current status for Phase 12 async calculation
let displayStatus: 'calculating' | 'completed' | 'error' = 'completed';
let progressMessage = 'The training in progress';
let progressPercent: number | undefined;

// New variable to track the actual training loop state
let trainingStatus: 'idle' | 'in_progress' | 'completed' | 'failed' = 'idle';

if (iterationData) {
  switch (iterationData.status) {
    case 'in_progress':
      displayStatus = 'calculating';
      trainingStatus = 'in_progress';
      if (iterationData.total_pairs_evaluated) {
        const totalPairs = db
          .prepare('SELECT COUNT(*) as count FROM training_pairs WHERE persona_id = ?')
          .get(id) as { count: number };
        if (totalPairs?.count) {
          progressPercent = Math.min(
            100,
            Math.round((iterationData.total_pairs_evaluated / totalPairs.count) * 100)
          );
        }
      }
      break;
    case 'failed':
      displayStatus = 'error';
      trainingStatus = 'failed';
      progressMessage = iterationData.error_message || 'Calculation failed';
      break;
    default:
      if (!metrics) {
        displayStatus = 'calculating';
      }
  }

  // Check training loop status separately
  const loopStatus = iterationData.loop_status;
  if (
    loopStatus === 'in_progress' ||
    loopStatus === 'pending' ||
    loopStatus === 'awaiting_human_review'
  ) {
    trainingStatus = 'in_progress';
  } else if (loopStatus === 'completed') {
    trainingStatus = 'completed';
  } else if (loopStatus === 'failed') {
    trainingStatus = 'failed';
  }
} else {
  displayStatus = 'calculating';
  trainingStatus = 'in_progress';
}

// Helper function to get persona status variant
function getPersonaStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'draft':
      return 'warning';
    case 'training':
      return 'info';
    case 'trained':
      return 'success';
    case 'incomplete':
      return 'error';
    default:
      return 'info';
  }
}

// Get iteration status variant
function getIterationStatusVariant(status: string): 'warning' | 'info' | 'success' | 'error' {
  switch (status) {
    case 'in_progress':
      return 'info';
    case 'completed':
      return 'success';
    case 'paused':
      return 'warning';
    case 'failed':
      return 'error';
    default:
      return 'info';
  }
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: persona.name, href: `/personas/${id}` },
  { label: 'Metrics' },
];
---

<Layout title={`Metrics - ${persona.name}`}>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Header -->
  <div class="flex items-start justify-between mb-8 animate-reveal">
    <div class="flex-1">
      <div class="flex items-center gap-4 mb-4">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight text-gradient-gold"
        >
          {persona.name}
        </h1>
        <Badge variant={getPersonaStatusVariant(persona.status)} size="lg">
          {persona.status}
        </Badge>
      </div>
      {
        persona.description && (
          <p class="text-base-content/70 text-lg max-w-3xl">{persona.description}</p>
        )
      }
    </div>
  </div>

  <!-- Tabs -->
  <PersonaTabs personaId={id} activeTab="workspace" />

  <!-- Phase 12: Async Metrics Calculation Progress -->
  {
    (displayStatus === 'calculating' || displayStatus === 'error') && iteration && (
      <div class="max-w-2xl mx-auto mb-8 animate-reveal">
        {/* Live status info bar for SSE updates */}
        <div id="sse-status-bar" class="alert alert-info shadow-lg mb-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 shrink-0 stroke-current animate-spin"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            />
          </svg>
          <div>
            <h3 class="font-bold text-lg">Training in progress</h3>
            <p class="text-sm opacity-80">
              Current iteration: <span id="sse-current-iteration">#{iteration}</span>
            </p>
          </div>
        </div>

        <MetricsCalculationProgress
          status={displayStatus}
          message={progressMessage}
          progressPercent={progressPercent}
          iteration={iterationData?.iteration_number || iteration}
          personaId={id}
        />
      </div>
    )
  }

  <!-- Training Dashboard with Chart -->
  {
    displayStatus === 'completed' && (
      <div class="mb-8 animate-reveal delay-200">
        <TrainingDashboard personaId={id} showChart={true} />
      </div>
    )
  }

  <!-- Phase 12: Display metrics with new MetricCard components -->
  {
    displayStatus === 'completed' && metrics && (
      <div class="mb-8 animate-reveal delay-300" data-metrics-section>
        <h2 class="text-xl font-semibold mb-4">
          {iteration
            ? `Iteration ${iteration} Metrics`
            : `Iteration ${latestIterationWithMetrics?.iteration_number} Metrics`}
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <MetricCard
            label="F1 Score"
            value={metrics.f1_score}
            format="percentage"
            description="Harmonic mean of precision and recall"
            variant="primary"
            id="metric-f1-score"
          />
          <MetricCard
            label="Precision"
            value={metrics.precision}
            format="percentage"
            description="Ratio of true positives to all positive predictions"
            variant="success"
            id="metric-precision"
          />
          <MetricCard
            label="Recall"
            value={metrics.recall}
            format="percentage"
            description="Ratio of true positives to all actual positives"
            variant="info"
            id="metric-recall"
          />
          <MetricCard
            label="Cohen's Kappa"
            value={metrics.cohens_kappa}
            format="percentage"
            description="Inter-rater reliability measure"
            variant="warning"
            id="metric-cohens-kappa"
          />
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <ConfusionMatrix
            truePositives={displayMetrics.confusion_matrix.true_positives}
            trueNegatives={displayMetrics.confusion_matrix.true_negatives}
            falsePositives={displayMetrics.confusion_matrix.false_positives}
            falseNegatives={displayMetrics.confusion_matrix.false_negatives}
          />

          <div class="card bg-base-200 shadow-md">
            <div class="card-body">
              <h3 class="card-title text-lg mb-4">Cohen's Kappa</h3>
              <div class="text-center">
                <div class="text-5xl font-bold font-mono text-primary mb-2">
                  {metrics.cohens_kappa !== null ? metrics.cohens_kappa.toFixed(3) : 'N/A'}
                </div>
                <p class="text-sm text-base-content/70">
                  Measures agreement between judge and human, accounting for chance.
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-base-content/10">
                <div class="text-xs text-base-content/60 uppercase tracking-wide mb-2">
                  Interpretation
                </div>
                <div class="space-y-1 text-sm">
                  <div>&lt; 0.20: Poor agreement</div>
                  <div>0.21-0.40: Fair agreement</div>
                  <div>0.41-0.60: Moderate agreement</div>
                  <div>0.61-0.80: Substantial agreement</div>
                  <div>0.81-1.00: Almost perfect agreement</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <!-- Iteration History -->
  <div class="animate-reveal delay-300">
    <h2 class="text-xl font-semibold mb-4">Iteration History</h2>

    <div class="overflow-x-auto">
      <table class="table table-zebra" id="iteration-history-table">
        <thead>
          <tr>
            <th>Iteration</th>
            <th>Status</th>
            <th>Progress</th>
            <th>F1 Score</th>
            <th>Cohen's Kappa</th>
            <th>Completed</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {
            iterations.map((iter) => (
              <tr class={iter.id === iterationData?.id ? 'active' : ''}>
                <td class="font-mono">#{iter.iteration_number}</td>
                <td>
                  <Badge variant={getIterationStatusVariant(iter.status)} size="sm">
                    {iter.status}
                  </Badge>
                </td>
                <td>
                  {iter.total_pairs_evaluated ? (
                    <span class="text-sm">
                      {iter.pairs_reviewed_by_human || 0} / {iter.total_pairs_evaluated} reviewed
                    </span>
                  ) : (
                    <span class="text-sm text-base-content/50">-</span>
                  )}
                </td>
                <td class="font-mono">
                  {iter.f1_score !== null ? (iter.f1_score * 100).toFixed(1) + '%' : '-'}
                </td>
                <td class="font-mono">
                  {iter.cohens_kappa !== null ? iter.cohens_kappa.toFixed(3) : '-'}
                </td>
                <td>
                  {iter.completed_at ? new Date(iter.completed_at).toLocaleDateString() : '-'}
                </td>
                <td>
                  <div class="flex gap-2">
                    {iter.iteration_number === iteration ? (
                      <span class="text-xs text-base-content/50">Current</span>
                    ) : (
                      <a
                        href={`/personas/${id}/metrics?iteration=${iter.iteration_number}`}
                        class="btn btn-xs btn-ghost"
                      >
                        View
                      </a>
                    )}
                    {iter.status === 'completed' && (
                      <a
                        href={`/personas/${id}/review/${iter.iteration_number}`}
                        class="btn btn-xs btn-ghost"
                      >
                        Review
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <!-- Phase 12: SSE script for async metrics calculation -->
  <script type="module" define:vars={{ personaId: id, trainingStatus, iteration }}>
    // Only start SSE if metrics are NOT already shown server-side
    // trainingStatus 'in_progress' means training is actively running
    const shouldStartSSE = trainingStatus === 'in_progress';

    if (personaId && shouldStartSSE) {
      const url = `/api/personas/${personaId}/training/status?stream=true`;
      let reconnectAttempts = 0;
      const maxReconnectAttempts = 5;

      /**
       * Handle SSE messages
       */
      const handleMessage = (event) => {
        try {
          const message = JSON.parse(event.data);

          switch (message.type) {
            case 'status_update':
              handleStatusUpdate(message.data);
              break;
            case 'stream_closed':
              // Clean close - close EventSource without reconnecting
              if (eventSource) {
                eventSource.close();
              }
              break;
            case 'error':
              // Error events are logged but not reconnected
              break;
          }
        } catch {
          // Ignore parse errors
        }
      };

      /**
       * Handle status update from SSE
       * This is the main handler for all status updates from the server
       * @param {{latest_iteration: any, training_loop_state: any, metrics?: any}} data
       */
      function handleStatusUpdate(data) {
        // 1. Update status bar with current iteration
        const currentIterEl = document.getElementById('sse-current-iteration');
        if (currentIterEl && data.training_loop_state?.current_iteration) {
          currentIterEl.textContent = `#${data.training_loop_state.current_iteration}`;
        }

        // 2. If metrics are available, remove progress section and show metrics
        if (data.metrics) {
          const progressSection = document.querySelector('.max-w-2xl.mx-auto.mb-8');
          if (progressSection) {
            progressSection.remove();
          }

          // Show metrics section if it exists but is hidden
          const metricsSection = document.querySelector('[data-metrics-section]');
          if (metricsSection) {
            metricsSection.classList.remove('hidden');
            updateMetricsCards(data.metrics);
          }
        }

        // 3. Update iteration history table
        if (data.latest_iteration) {
          updateIterationHistory(data);
        }
      }

      /**
       * Handle SSE errors and attempt reconnection
       */
      const handleError = () => {
        if (reconnectAttempts < maxReconnectAttempts) {
          reconnectAttempts++;
          const delay = Math.min(1000 * Math.pow(2, reconnectAttempts), 10000);

          setTimeout(() => {
            const newEventSource = new EventSource(url);
            newEventSource.onopen = () => {
              reconnectAttempts = 0;
            };
            newEventSource.onmessage = handleMessage;
            newEventSource.onerror = handleError;
            eventSource = newEventSource;
          }, delay);
        } else {
          if (eventSource) eventSource.close();
        }
      };

      let eventSource = new EventSource(url);
      eventSource.onopen = () => {
        reconnectAttempts = 0;
      };
      eventSource.onmessage = handleMessage;
      eventSource.onerror = handleError;
    }

    /**
     * Update metrics cards with new data
     * @param {{f1_score: number, precision: number, recall: number, cohens_kappa: number, accuracy: number, confusion_matrix: any}} metrics
     */
    function updateMetricsCards(metrics) {
      // Helper function to update a metric card's value
      const updateMetricCard = (metricId, value) => {
        const card = document.querySelector(`[data-metric-id="${metricId}"]`);
        if (card) {
          const valueEl = card.querySelector('.text-3xl.font-bold.font-mono');
          if (valueEl) {
            valueEl.textContent = value;
          }
        }
      };

      // Update F1 Score
      if (metrics.f1_score !== undefined) {
        updateMetricCard('metric-f1-score', `${(metrics.f1_score * 100).toFixed(1)}%`);
      }

      // Update Precision
      if (metrics.precision !== undefined) {
        updateMetricCard('metric-precision', `${(metrics.precision * 100).toFixed(1)}%`);
      }

      // Update Recall
      if (metrics.recall !== undefined) {
        updateMetricCard('metric-recall', `${(metrics.recall * 100).toFixed(1)}%`);
      }

      // Update Cohen's Kappa
      if (metrics.cohens_kappa !== undefined) {
        updateMetricCard('metric-cohens-kappa', metrics.cohens_kappa.toFixed(3));
      }

      // Update confusion matrix values if displayed
      if (metrics.confusion_matrix) {
        const tpEl = document.getElementById('metric-tp');
        const tnEl = document.getElementById('metric-tn');
        const fpEl = document.getElementById('metric-fp');
        const fnEl = document.getElementById('metric-fn');

        if (tpEl) tpEl.textContent = metrics.confusion_matrix.true_positives.toString();
        if (tnEl) tnEl.textContent = metrics.confusion_matrix.true_negatives.toString();
        if (fpEl) fpEl.textContent = metrics.confusion_matrix.false_positives.toString();
        if (fnEl) fnEl.textContent = metrics.confusion_matrix.false_negatives.toString();
      }
    }

    /**
     * Update iteration history table row
     * @TODO: Refactor this to use Astro state management or a frontend framework for better DOM handling.
     * @param {{latest_iteration: any, training_loop_state: any, metrics?: any}} data
     */
    function updateIterationHistory(data) {
      const tbody = document.querySelector('#iteration-history-table tbody');
      if (!tbody || !data.latest_iteration) return;

      const iterNum = data.latest_iteration.iteration_number;

      // Find the row by iteration number - handle potential whitespace in textContent
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const row = rows.find((r) => {
        const iterCell = r.querySelector('td:first-child');
        if (!iterCell) return false;
        const cellText = iterCell.textContent?.trim();
        return cellText === `#${iterNum}` || cellText === iterNum.toString();
      });

      // If row doesn't exist, create it
      if (!row) {
        createIterationRow(tbody, data);
        return;
      }

      // Update status badge
      const statusCell = row.querySelector('td:nth-child(2)');
      if (statusCell && data.latest_iteration.status) {
        const statusVariant =
          data.latest_iteration.status === 'completed'
            ? 'success'
            : data.latest_iteration.status === 'in_progress'
              ? 'info'
              : data.latest_iteration.status === 'failed'
                ? 'error'
                : 'warning';
        statusCell.innerHTML = `<div class="badge badge-${statusVariant} badge-sm gap-1">${data.latest_iteration.status}</div>`;
      }

      // Update F1 score if available
      const f1Cell = row.querySelector('td:nth-child(4)');
      if (f1Cell && data.metrics?.f1_score !== undefined) {
        f1Cell.textContent = `${(data.metrics.f1_score * 100).toFixed(1)}%`;
      }

      // Update Cohen's Kappa if available
      const kappaCell = row.querySelector('td:nth-child(5)');
      if (kappaCell && data.metrics?.cohens_kappa !== undefined) {
        kappaCell.textContent = data.metrics.cohens_kappa.toFixed(3);
      }

      // Update completed date if available
      const completedCell = row.querySelector('td:nth-child(6)');
      if (
        completedCell &&
        data.latest_iteration.completed_at &&
        completedCell.textContent.trim() === '-'
      ) {
        completedCell.textContent = new Date(
          data.latest_iteration.completed_at
        ).toLocaleDateString();
      }

      // Update review button if iteration is completed
      if (data.latest_iteration.status === 'completed') {
        const actionsCell = row.querySelector('td:nth-child(7)');
        if (actionsCell) {
          // Check if review button already exists
          if (!actionsCell.querySelector('a[href*="/review/"]')) {
            const reviewButton = document.createElement('a');
            reviewButton.href = `/personas/${personaId}/review/${iterNum}`;
            reviewButton.className = 'btn btn-xs btn-ghost';
            reviewButton.textContent = 'Review';
            actionsCell.appendChild(reviewButton);
          }
        }
      }
    }

    /**
     * Create a new iteration row in the history table
     * @param {HTMLTableSectionElement} tbody - The tbody element
     * @param {{latest_iteration: any, training_loop_state: any, metrics?: any}} data - The iteration data
     */
    function createIterationRow(tbody, data) {
      const iter = data.latest_iteration;
      const metrics = data.metrics;
      const iterNum = iter.iteration_number;

      // Create row element
      const row = document.createElement('tr');
      row.className = 'animate-reveal';

      // Status variant helper
      const getStatusVariant = (status) => {
        switch (status) {
          case 'completed':
            return 'success';
          case 'in_progress':
            return 'info';
          case 'failed':
            return 'error';
          case 'paused':
            return 'warning';
          default:
            return 'info';
        }
      };

      const statusVariant = getStatusVariant(iter.status);
      const f1Display =
        metrics?.f1_score !== undefined ? `${(metrics.f1_score * 100).toFixed(1)}%` : '-';
      const kappaDisplay =
        metrics?.cohens_kappa !== undefined ? metrics.cohens_kappa.toFixed(3) : '-';
      const completedDisplay = iter.completed_at
        ? new Date(iter.completed_at).toLocaleDateString()
        : '-';

      // Build row HTML
      row.innerHTML = `
        <td class="font-mono">#${iterNum}</td>
        <td>
          <div class="badge badge-${statusVariant} badge-sm gap-1">${iter.status}</div>
        </td>
        <td>
          ${iter.total_pairs_evaluated ? `<span class="text-sm">${iter.pairs_reviewed_by_human || 0} / ${iter.total_pairs_evaluated} reviewed</span>` : '<span class="text-sm text-base-content/50">-</span>'}
        </td>
        <td class="font-mono">${f1Display}</td>
        <td class="font-mono">${kappaDisplay}</td>
        <td>${completedDisplay}</td>
        <td>
          <div class="flex gap-2">
            ${iter.iteration_number === iteration ? '<span class="text-xs text-base-content/50">Current</span>' : `<a href="/personas/${personaId}/metrics?iteration=${iterNum}" class="btn btn-xs btn-ghost">View</a>`}
            ${iter.status === 'completed' ? `<a href="/personas/${personaId}/review/${iterNum}" class="btn btn-xs btn-ghost">Review</a>` : ''}
          </div>
        </td>
      `;

      // Append row to tbody
      tbody.appendChild(row);
    }
  </script>
</Layout>
