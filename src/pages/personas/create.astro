---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { getModels } from '@lib/db';
import type { ModelConfiguration } from '@lib/utils/types';

// Fetch available models directly from DB
let models: ModelConfiguration[] = [];
let error: string | null = null;

try {
  models = getModels(true); // activeOnly = true
} catch (e) {
  console.error('Error fetching models:', e);
  error = 'Failed to load models';
}

// Group models by provider
const modelsByProvider = models.reduce((acc: Record<string, ModelConfiguration[]>, model) => {
  if (!acc[model.provider]) {
    acc[model.provider] = [];
  }
  acc[model.provider].push(model);
  return acc;
}, {});

const providers = Object.keys(modelsByProvider);

// Show error if no models available
if (models.length === 0 && !error) {
  error = 'No models configured. Please add models in the Models page before creating a persona.';
}

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Personas', href: '/personas' },
  { label: 'Create New Persona' },
];
---

<Layout title="Create Persona - Eval AI">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="max-w-4xl mx-auto animate-reveal">
    <div class="accent-line mb-8">
      <h1
        class="text-5xl md:text-6xl font-display font-semibold tracking-tight mb-4 text-gradient-gold"
      >
        Create New Persona
      </h1>
      <p class="mt-3 text-base-content/60 text-lg">
        Configure a new LLM-as-Judge persona for training evaluations.
      </p>
    </div>

    {
      error ? (
        <div class="alert alert-error mb-8">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="stroke-current shrink-0 h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          <span>{error}</span>
        </div>
      ) : null
    }

    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <form
          id="create-persona-form"
          class="space-y-6"
          class:list={{ 'opacity-50 pointer-events-none': error }}
        >
          <!-- Basic Information -->
          <div class="space-y-4">
            <h2 class="text-2xl font-semibold">Basic Information</h2>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Persona Name <span class="text-error">*</span></span
                >
              </label>
              <input
                type="text"
                name="name"
                placeholder="e.g., Customer Support Judge"
                class="input input-bordered w-full"
                required
              />
              <label class="label">
                <span class="label-text-alt">A unique, descriptive name for this judge persona</span
                >
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold">Description</span>
              </label>
              <textarea
                name="description"
                placeholder="What does this judge evaluate?"
                class="textarea textarea-bordered w-full h-24"
                rows="3"></textarea>
              <label class="label">
                <span class="label-text-alt"
                  >Optional description of what this persona evaluates</span
                >
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Task Prompt <span class="text-error">*</span></span
                >
              </label>
              <textarea
                name="task_prompt"
                placeholder="e.g., You are a helpful customer support agent. Respond to the customer's inquiry professionally and accurately."
                class="textarea textarea-bordered w-full h-32"
                rows="5"
                required></textarea>
              <label class="label">
                <span class="label-text-alt"
                  >The prompt used to generate outputs that the judge will evaluate</span
                >
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Initial Judge Prompt <span class="text-error">*</span></span
                >
              </label>
              <textarea
                name="initial_judge_prompt"
                placeholder="e.g., Evaluate if the response is professional, accurate, and helpful. Respond with 'agree' if it meets the criteria, or 'disagree' if it does not."
                class="textarea textarea-bordered w-full h-32"
                rows="5"
                required></textarea>
              <label class="label">
                <span class="label-text-alt"
                  >The initial evaluation criteria for the judge. This will be refined during
                  training.</span
                >
              </label>
            </div>
          </div>

          <!-- Model Configuration -->
          <div class="divider"></div>

          <div class="space-y-4">
            <h2 class="text-2xl font-semibold">Model Configuration</h2>
            <div class="alert alert-info">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="stroke-current shrink-0 w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span
                >All three models must be from <strong>different providers</strong> to prevent bias.</span
              >
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Task Model <span class="text-error">*</span></span
                >
              </label>
              <div class="flex gap-2 items-center">
                <select
                  name="task_model_id"
                  class="select select-bordered w-full"
                  required
                  id="task-model-select"
                >
                  <option value="" selected>Select a model to generate outputs</option>
                  {
                    providers.map((provider) => (
                      <optgroup label={provider.toUpperCase()}>
                        {modelsByProvider[provider].map((model: any) => (
                          <option value={model.id} data-provider={model.provider}>
                            {model.model_name}
                          </option>
                        ))}
                      </optgroup>
                    ))
                  }
                </select>
                <button
                  type="button"
                  class="btn btn-square btn-outline border-base-300 text-base-content/50 hover:text-error hover:border-error clear-selection-btn"
                  data-target="task-model-select"
                  aria-label="Clear selection"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
              <label class="label">
                <span class="label-text-alt">Model that generates the outputs to be evaluated</span>
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Judge Model <span class="text-error">*</span></span
                >
              </label>
              <div class="flex gap-2 items-center">
                <select
                  name="judge_model_id"
                  class="select select-bordered w-full"
                  required
                  id="judge-model-select"
                >
                  <option value="" selected>Select a model to judge outputs</option>
                  {
                    providers.map((provider) => (
                      <optgroup label={provider.toUpperCase()}>
                        {modelsByProvider[provider].map((model: any) => (
                          <option value={model.id} data-provider={model.provider}>
                            {model.model_name}
                          </option>
                        ))}
                      </optgroup>
                    ))
                  }
                </select>
                <button
                  type="button"
                  class="btn btn-square btn-outline border-base-300 text-base-content/50 hover:text-error hover:border-error clear-selection-btn"
                  data-target="judge-model-select"
                  aria-label="Clear selection"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
              <label class="label">
                <span class="label-text-alt">Model that evaluates the generated outputs</span>
              </label>
            </div>

            <div class="form-control">
              <label class="label">
                <span class="label-text font-semibold"
                  >Prompt Engineer Model <span class="text-error">*</span></span
                >
              </label>
              <div class="flex gap-2 items-center">
                <select
                  name="prompt_engineer_model_id"
                  class="select select-bordered w-full"
                  required
                  id="prompt-engineer-select"
                >
                  <option value="" selected>Select a model to refine judge prompts</option>
                  {
                    providers.map((provider) => (
                      <optgroup label={provider.toUpperCase()}>
                        {modelsByProvider[provider].map((model: any) => (
                          <option value={model.id} data-provider={model.provider}>
                            {model.model_name}
                          </option>
                        ))}
                      </optgroup>
                    ))
                  }
                </select>
                <button
                  type="button"
                  class="btn btn-square btn-outline border-base-300 text-base-content/50 hover:text-error hover:border-error clear-selection-btn"
                  data-target="prompt-engineer-select"
                  aria-label="Clear selection"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                      clip-rule="evenodd"></path>
                  </svg>
                </button>
              </div>
              <label class="label">
                <span class="label-text-alt">Model that suggests improvements to judge prompts</span
                >
              </label>
            </div>

            <div id="validation-error" class="alert alert-error hidden">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-current shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span id="validation-error-message"></span>
            </div>
          </div>

          <!-- Actions -->
          <div class="divider"></div>

          <div class="flex justify-end gap-4">
            <a href="/personas" class="btn btn-ghost">Cancel</a>
            <button type="submit" class="btn btn-primary" id="submit-btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              Create Persona
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { addToast } from '@lib/ui/toastStore';

  const form = document.getElementById('create-persona-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const validationError = document.getElementById('validation-error') as HTMLDivElement;
  const validationErrorMessage = document.getElementById(
    'validation-error-message'
  ) as HTMLSpanElement;

  const taskModelSelect = document.getElementById('task-model-select') as HTMLSelectElement;
  const judgeModelSelect = document.getElementById('judge-model-select') as HTMLSelectElement;
  const promptEngineerSelect = document.getElementById(
    'prompt-engineer-select'
  ) as HTMLSelectElement;

  // Store original text for all options
  const allSelects = [taskModelSelect, judgeModelSelect, promptEngineerSelect];
  allSelects.forEach((select) => {
    select.querySelectorAll('option').forEach((option) => {
      if (option.value && !option.disabled) {
        option.dataset.originalText = option.text;
      }
    });
  });

  /**
   * Updates model select options based on currently selected providers.
   * Disables providers that are already selected in other dropdowns to enforce separation.
   */
  function updateAvailableOptions() {
    const selectedProviders: Record<string, string> = {};

    // Get currently selected providers
    allSelects.forEach((select) => {
      const option = select.selectedOptions[0];
      if (option && option.value && !option.disabled) {
        selectedProviders[select.id] = option.dataset.provider || '';
      }
    });

    // Update each select
    allSelects.forEach((currentSelect) => {
      const options = currentSelect.querySelectorAll('option');

      options.forEach((option) => {
        // Skip placeholders
        if (!option.value) return;

        const provider = option.dataset.provider;
        if (!provider) return;

        // Check if this provider is selected in any OTHER select
        let isProviderTaken = false;
        for (const [selectId, selectedProvider] of Object.entries(selectedProviders)) {
          if (selectId !== currentSelect.id && selectedProvider === provider) {
            isProviderTaken = true;
            break;
          }
        }

        // Disable/enable option
        if (isProviderTaken) {
          option.disabled = true;
          option.text = `${option.dataset.originalText} (Provider selected)`;
        } else {
          option.disabled = false;
          if (option.dataset.originalText) {
            option.text = option.dataset.originalText;
          }
        }
      });
    });

    validateModelSeparation();
  }

  /**
   * Validates that all three selected models come from different providers.
   * Updates validation error UI if requirements are not met.
   * @returns True if selection is valid or incomplete, false if invalid
   */
  function validateModelSeparation() {
    const taskModelOption = taskModelSelect.selectedOptions[0];
    const judgeModelOption = judgeModelSelect.selectedOptions[0];
    const promptEngineerOption = promptEngineerSelect.selectedOptions[0];

    if (!taskModelOption || !judgeModelOption || !promptEngineerOption) {
      validationError.classList.add('hidden');
      return true;
    }

    const taskProvider = taskModelOption.dataset.provider;
    const judgeProvider = judgeModelOption.dataset.provider;
    const promptEngineerProvider = promptEngineerOption.dataset.provider;

    const errors: string[] = [];

    // Only validate if all fields have a valid selection (not disabled placeholder)
    if (taskModelSelect.value && judgeModelSelect.value && promptEngineerSelect.value) {
      if (taskProvider === judgeProvider) {
        errors.push('Task model and Judge model must be from different providers');
      }
      if (taskProvider === promptEngineerProvider) {
        errors.push('Task model and Prompt Engineer model must be from different providers');
      }
      if (judgeProvider === promptEngineerProvider) {
        errors.push('Judge model and Prompt Engineer model must be from different providers');
      }
    }

    if (errors.length > 0) {
      validationErrorMessage.textContent = errors.join('. ');
      validationError.classList.remove('hidden');
      return false;
    } else {
      validationError.classList.add('hidden');
      return true;
    }
  }

  taskModelSelect.addEventListener('change', updateAvailableOptions);
  judgeModelSelect.addEventListener('change', updateAvailableOptions);
  promptEngineerSelect.addEventListener('change', updateAvailableOptions);

  // Initialize options state
  updateAvailableOptions();

  // Clear selection buttons
  document.querySelectorAll('.clear-selection-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetId = (e.currentTarget as HTMLButtonElement).dataset.target;
      if (!targetId) return;

      const select = document.getElementById(targetId) as HTMLSelectElement;
      if (select) {
        select.value = '';
        select.dispatchEvent(new Event('change'));
        updateAvailableOptions();
      }
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!validateModelSeparation()) {
      addToast('Please fix model separation errors', 'error');
      return;
    }

    const formData = new FormData(form);
    const data = {
      name: formData.get('name') as string,
      description: (formData.get('description') as string) || null,
      task_prompt: formData.get('task_prompt') as string,
      initial_judge_prompt: formData.get('initial_judge_prompt') as string,
      task_model_id: formData.get('task_model_id') as string,
      judge_model_id: formData.get('judge_model_id') as string,
      prompt_engineer_model_id: formData.get('prompt_engineer_model_id') as string,
    };

    // Disable submit button
    submitBtn.disabled = true;
    submitBtn.classList.add('loading');

    try {
      const response = await fetch('/api/personas', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        addToast('Persona created successfully!', 'success');
        // Redirect to the new persona's detail page
        window.location.href = `/personas/${result.id}`;
      } else {
        // Handle validation errors
        if (result.details && Array.isArray(result.details)) {
          validationErrorMessage.textContent = result.details.join('. ');
          validationError.classList.remove('hidden');
          addToast('Validation failed', 'error');
        } else {
          addToast(result.error || 'Failed to create persona', 'error');
        }
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
      }
    } catch (error) {
      console.error('Create persona error:', error);
      addToast('Failed to create persona', 'error');
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  });
</script>
