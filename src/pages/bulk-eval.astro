---
/**
 * Bulk Evaluation Page
 *
 * Main page for bulk evaluation workflow:
 * 1. Upload CSV file via UploadZone
 * 2. Configure evaluation via ConfigPanel (system prompt, temperature, models)
 * 3. Run evaluation and poll for status updates
 * 4. View results in ResultsTable with DetailDrawer for row details
 *
 * State persistence: Uses sessionStorage to persist state across page navigation
 */

import Layout from '@layouts/Layout.astro';
import UploadZone from '@components/bulk/UploadZone.astro';
import ConfigPanel from '@components/bulk/ConfigPanel.astro';
import DetailDrawer from '@components/bulk/DetailDrawer.astro';
import { getModels } from '@lib/db';
import type { ModelConfiguration } from '@lib/utils/types';
import type { RowResult } from '@lib/db';

// Fetch available models for configuration panel
let models: ModelConfiguration[] = [];
let modelFetchError: string | null = null;
try {
  models = getModels(true); // Only active models
} catch (e) {
  console.error('Error fetching models:', e);
  modelFetchError = e instanceof Error ? e.message : 'Failed to load available models';
}
---

<Layout title="Bulk Evaluation - Eval AI">
  <!-- Pass modelFetchError to client script -->
  <span
    id="model-fetch-error"
    data-model-fetch-error={JSON.stringify(modelFetchError)}
    class="hidden"></span>
  <div class="space-y-8">
    <!-- Page Header -->
    <div class="flex items-center justify-between animate-reveal">
      <div class="accent-line">
        <h1
          class="text-4xl md:text-5xl font-display font-semibold tracking-tight mb-3 text-gradient-gold"
        >
          Bulk Evaluation
        </h1>
        <p class="text-base-content/60 text-lg">
          Upload CSV data, configure models, and run bulk evaluations across multiple rows
        </p>
      </div>
      <button id="new-eval-btn" class="btn btn-ghost btn-sm hidden" type="button">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
          ></path>
        </svg>
        New Evaluation
      </button>
    </div>

    <!-- Workflow Steps Indicator -->
    <div class="flex items-center gap-4 animate-reveal delay-100" id="steps-indicator">
      <div class="flex items-center gap-2" data-step="1">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 step-badge step-badge-active"
        >
          1
        </div>
        <span class="text-sm font-medium step-label">Upload</span>
      </div>
      <div class="w-12 h-0.5 bg-base-300 step-connector"></div>
      <div class="flex items-center gap-2" data-step="2">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 step-badge"
        >
          2
        </div>
        <span class="text-sm font-medium text-base-content/50 step-label">Configure</span>
      </div>
      <div class="w-12 h-0.5 bg-base-300 step-connector"></div>
      <div class="flex items-center gap-2" data-step="3">
        <div
          class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 step-badge"
        >
          3
        </div>
        <span class="text-sm font-medium text-base-content/50 step-label">Results</span>
      </div>
    </div>

    <!-- Step 1: Upload Zone -->
    <div id="step-upload" class="animate-reveal delay-200">
      <UploadZone />
    </div>

    <!-- Step 2: Configuration Panel -->
    <div id="step-config" class="hidden animate-reveal">
      <ConfigPanel models={models} modelFetchError={modelFetchError} />
    </div>

    <!-- Step 3: Results Table -->
    <div id="step-results" class="hidden animate-reveal">
      <div
        id="results-placeholder"
        class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl p-12 text-center"
      >
        <span class="loading loading-spinner loading-lg text-luxe-gold"></span>
        <p class="text-base-content/60 mt-4">Loading results...</p>
      </div>
    </div>

    <!-- Status Bar (shown during evaluation) -->
    <div id="status-bar" class="hidden sticky bottom-4 z-40 animate-reveal">
      <div
        class="card bg-base-100/95 backdrop-blur-sm border border-luxe-gold/50 shadow-elevated rounded-xl"
      >
        <div class="card-body p-4 flex items-center gap-4">
          <div class="flex items-center gap-3 flex-1">
            <span class="loading loading-spinner loading-sm text-luxe-emerald"></span>
            <div class="flex-1">
              <p class="font-semibold text-sm">Evaluating...</p>
              <div class="w-full bg-base-300 rounded-full h-2 mt-1">
                <div
                  id="progress-bar"
                  class="bg-gradient-emerald h-2 rounded-full transition-all duration-300"
                  style="width: 0%"
                >
                </div>
              </div>
            </div>
            <span id="progress-text" class="text-sm font-mono text-base-content/70">0 / 0</span>
          </div>
          <button id="cancel-eval-btn" class="btn btn-sm btn-ghost"> Cancel </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Drawer (hidden by default) -->
  <DetailDrawer result={{} as RowResult} rowData={{} as Record<string, string>} />

  <!-- Drawer in overlays slot for proper z-index -->
  <div slot="overlays" id="drawer-overlays"></div>
</Layout>

<style>
  .step-badge-active {
    background: linear-gradient(135deg, #d4af37 0%, #f0d678 100%);
    color: var(--color-luxe-midnight);
  }
  .step-badge-inactive {
    background: hsl(var(--b3));
    color: var(--bc);
  }
  .step-label-active {
    color: var(--bc);
  }
  .bg-gradient-emerald {
    background: linear-gradient(135deg, #00ff87 0%, #00d9ff 100%);
  }
</style>

<script>
  import { addToast } from '@lib/ui/toastStore';
  import type { BulkDataset, EvaluationRun, RowResult } from '@lib/db';

  // Declare the global function added by DetailDrawer
  declare global {
    interface Window {
      showBulkRowDetails?: (result: RowResult, rowData: Record<string, string>) => void;
    }
  }

  // Show error toast if model fetch failed (eval-dfb)
  const modelFetchError = JSON.parse(
    document.querySelector('[data-model-fetch-error]')?.getAttribute('data-model-fetch-error') ||
      'null'
  );
  if (modelFetchError) {
    addToast(
      `Unable to load available models: ${modelFetchError}. Please check your model configurations.`,
      'warning'
    );
  }

  /**
   * Bulk Evaluation State
   */
  interface BulkState {
    step: 'upload' | 'config' | 'results';
    datasetId: string | null;
    dataset: BulkDataset | null;
    runId: string | null;
    run: EvaluationRun | null;
    config: {
      systemPrompt: string;
      temperature: number;
      modelIds: string[];
    } | null;
    isPolling: boolean;
    pollInterval: number | null;
    consecutiveFailures: number;
    currentBackoffMs: number;
  }

  /**
   * Polling configuration constants
   */
  const MAX_CONSECUTIVE_FAILURES = 10;
  const INITIAL_BACKOFF_MS = 1500;
  const MAX_BACKOFF_MS = 12000;
  const BACKOFF_MULTIPLIER = 2;

  // Initialize state from sessionStorage or default
  const getInitialState = (): BulkState => {
    const stored = sessionStorage.getItem('bulkEvalState');
    if (stored) {
      try {
        const parsed = JSON.parse(stored);
        // Reset polling state on page load
        return {
          ...parsed,
          isPolling: false,
          pollInterval: null,
          consecutiveFailures: 0,
          currentBackoffMs: INITIAL_BACKOFF_MS,
        };
      } catch {
        // Ignore parse errors
      }
    }
    return {
      step: 'upload',
      datasetId: null,
      dataset: null,
      runId: null,
      run: null,
      config: null,
      isPolling: false,
      pollInterval: null,
      consecutiveFailures: 0,
      currentBackoffMs: INITIAL_BACKOFF_MS,
    };
  };

  let state: BulkState = getInitialState();

  /**
   * Save state to sessionStorage for persistence
   */
  const saveState = () => {
    const toSave = {
      step: state.step,
      datasetId: state.datasetId,
      dataset: state.dataset,
      runId: state.runId,
      run: state.run,
      config: state.config,
      isPolling: false,
      pollInterval: null,
      consecutiveFailures: 0,
      currentBackoffMs: INITIAL_BACKOFF_MS,
    };
    sessionStorage.setItem('bulkEvalState', JSON.stringify(toSave));
  };

  /**
   * DOM Elements
   */
  const stepsIndicator = document.getElementById('steps-indicator');
  const stepUpload = document.getElementById('step-upload');
  const stepConfig = document.getElementById('step-config');
  const stepResults = document.getElementById('step-results');
  const resultsPlaceholder = document.getElementById('results-placeholder');
  const statusBar = document.getElementById('status-bar');
  const progressBar = document.getElementById('progress-bar');
  const progressText = document.getElementById('progress-text');
  const newEvalBtn = document.getElementById('new-eval-btn');
  const cancelEvalBtn = document.getElementById('cancel-eval-btn');

  /**
   * Update UI based on current step
   */
  const updateStepUI = () => {
    // Update step badges
    const steps = stepsIndicator?.querySelectorAll('[data-step]');
    steps?.forEach((stepEl) => {
      const stepNum = parseInt(stepEl.getAttribute('data-step') || '0');
      const badge = stepEl.querySelector('.step-badge') as HTMLElement;
      const label = stepEl.querySelector('.step-label') as HTMLElement;

      if (badge && label) {
        const currentStepNum = state.step === 'upload' ? 1 : state.step === 'config' ? 2 : 3;
        const isActive = stepNum === currentStepNum;
        const isPast = stepNum < currentStepNum;

        badge.className = `w-8 h-8 rounded-full flex items-center justify-center text-sm font-semibold transition-all duration-300 step-badge ${
          isActive
            ? 'step-badge-active'
            : isPast
              ? 'bg-luxe-emerald text-white'
              : 'step-badge-inactive'
        }`;
        label.className = `text-sm font-medium step-label ${isActive || isPast ? 'step-label-active' : 'text-base-content/50'}`;
      }
    });

    // Show/hide step content
    if (stepUpload) {
      stepUpload.classList.toggle('hidden', state.step !== 'upload');
    }
    if (stepConfig) {
      stepConfig.classList.toggle('hidden', state.step !== 'config');
    }
    if (stepResults) {
      stepResults.classList.toggle('hidden', state.step !== 'results');
    }
    if (newEvalBtn) {
      newEvalBtn.classList.toggle('hidden', state.step === 'upload');
    }

    saveState();
  };

  /**
   * Reset to new evaluation
   */
  const resetEvaluation = () => {
    stopPolling();
    state = {
      step: 'upload',
      datasetId: null,
      dataset: null,
      runId: null,
      run: null,
      config: null,
      isPolling: false,
      pollInterval: null,
      consecutiveFailures: 0,
      currentBackoffMs: INITIAL_BACKOFF_MS,
    };
    sessionStorage.removeItem('bulkEvalState');
    if (resultsPlaceholder) {
      resultsPlaceholder.classList.remove('hidden');
      // Clear any existing ResultsTable
      const existingTable = stepResults?.querySelector('div[class*="card"]');
      if (existingTable && existingTable !== resultsPlaceholder) {
        existingTable.remove();
      }
    }
    updateStepUI();
  };

  /**
   * Handle upload success event from UploadZone
   */
  const handleUploadSuccess = (event: CustomEvent) => {
    const { datasetId } = event.detail;
    state.datasetId = datasetId;
    state.step = 'config';
    updateStepUI();
    addToast('Dataset uploaded successfully. Configure your evaluation.', 'success');
  };

  /**
   * Handle config submit event from ConfigPanel
   */
  const handleConfigSubmit = async (event: CustomEvent) => {
    const { system_prompt, temperature, model_ids } = event.detail;

    if (!state.datasetId) {
      addToast('No dataset selected. Please upload a file first.', 'error');
      return;
    }

    // Store config
    state.config = {
      systemPrompt: system_prompt,
      temperature,
      modelIds: model_ids,
    };

    try {
      // Start evaluation run
      const response = await fetch('/api/bulk/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          dataset_id: state.datasetId,
          system_prompt: system_prompt,
          temperature: temperature,
          model_ids: model_ids,
        }),
      });

      if (!response.ok) {
        const err = await response.json();
        throw new Error(err.error || err.message || 'Failed to start evaluation');
      }

      const data = await response.json();
      state.runId = data.run_id;
      state.step = 'results';

      updateStepUI();
      addToast('Evaluation started successfully!', 'success');

      // Start polling for status
      startPolling();
    } catch (error) {
      addToast(
        `Failed to start evaluation: ${error instanceof Error ? error.message : 'Unknown error'}`,
        'error'
      );
      state.step = 'config';
      updateStepUI();
    }
  };

  /**
   * Poll for evaluation status updates with exponential backoff
   */
  const pollStatus = async () => {
    if (!state.runId || !state.isPolling) return;

    try {
      const response = await fetch(`/api/bulk/status?run_id=${state.runId}`);

      // Handle HTTP errors
      if (!response.ok) {
        const errorMessage = `HTTP ${response.status}: ${response.statusText}`;
        throw new Error(errorMessage);
      }

      const data = await response.json();
      state.run = data;

      // Reset failure counter on successful request
      state.consecutiveFailures = 0;
      state.currentBackoffMs = INITIAL_BACKOFF_MS;

      // Update progress bar
      if (progressBar && progressText) {
        const percentage = data.completion_percentage || 0;
        progressBar.style.width = `${percentage}%`;
        progressText.textContent = `${data.processed_rows} / ${data.total_rows}`;
      }

      // Check if evaluation is complete or failed
      if (data.status === 'completed' || data.status === 'failed' || !data.is_running) {
        stopPolling();
        loadResults();

        if (statusBar) {
          statusBar.classList.add('hidden');
        }

        if (data.status === 'completed') {
          addToast('Evaluation completed successfully!', 'success');
        } else if (data.status === 'failed') {
          addToast(`Evaluation failed: ${data.error_message || 'Unknown error'}`, 'error');
        }
      }
    } catch (error) {
      state.consecutiveFailures++;

      // Log polling metrics for debugging
      console.error(
        `[Polling error] Attempt ${state.consecutiveFailures}/${MAX_CONSECUTIVE_FAILURES}:`,
        {
          error: error instanceof Error ? error.message : 'Unknown error',
          runId: state.runId,
          currentBackoff: state.currentBackoffMs,
        }
      );

      // Check if we've exceeded max retries
      if (state.consecutiveFailures >= MAX_CONSECUTIVE_FAILURES) {
        stopPolling();
        if (statusBar) {
          statusBar.classList.add('hidden');
        }
        addToast(
          `Polling failed after ${MAX_CONSECUTIVE_FAILURES} attempts. Please check your connection and try again.`,
          'error'
        );
        return;
      }

      // Increase backoff time exponentially
      state.currentBackoffMs = Math.min(
        state.currentBackoffMs * BACKOFF_MULTIPLIER,
        MAX_BACKOFF_MS
      );
    }
  };

  /**
   * Start polling for status with exponential backoff on errors
   */
  const startPolling = () => {
    if (state.isPolling || !state.runId) return;

    state.isPolling = true;
    state.consecutiveFailures = 0;
    state.currentBackoffMs = INITIAL_BACKOFF_MS;

    // Show status bar
    if (statusBar) {
      statusBar.classList.remove('hidden');
    }

    // Poll immediately
    pollStatus();

    // Set up recursive polling with variable backoff
    const scheduleNextPoll = () => {
      if (!state.isPolling) return;

      state.pollInterval = window.setTimeout(() => {
        pollStatus().finally(() => {
          // Schedule next poll with current backoff time
          scheduleNextPoll();
        });
      }, state.currentBackoffMs);
    };

    scheduleNextPoll();
  };

  /**
   * Stop polling for status
   */
  const stopPolling = () => {
    if (state.pollInterval) {
      clearTimeout(state.pollInterval);
      state.pollInterval = null;
    }
    state.isPolling = false;
  };

  /**
   * Load and render results table using client-side rendering
   */
  const loadResults = async () => {
    if (!state.runId || !stepResults) return;

    try {
      const response = await fetch(`/api/bulk/results?run_id=${state.runId}`);
      if (!response.ok) {
        throw new Error('Failed to load results');
      }

      const data = await response.json();

      // Store dataset and run for detail drawer
      state.dataset = data.dataset;
      state.run = data.run;
      saveState();

      // Hide placeholder
      if (resultsPlaceholder) {
        resultsPlaceholder.classList.add('hidden');
      }

      // Clear existing results table
      const existingTable = stepResults.querySelector(
        'div[class*="card"]:not([id="results-placeholder"])'
      );
      if (existingTable) {
        existingTable.remove();
      }

      // API returns: { run, dataset, headers, selected_models (array), rows, summary }
      const headers = data.headers || [];
      const selectedModels = data.selected_models || [];
      const rows = data.rows || [];

      // Build table HTML
      const tableHTML = `
        <div class="card bg-base-100/90 backdrop-blur-sm border border-base-300/50 shadow-lg rounded-xl h-full flex flex-col overflow-hidden animate-reveal">
          <div class="card-body p-3 flex flex-col min-h-0">
            <!-- Table Header -->
            <div class="flex items-center justify-between px-1 py-2 border-b border-base-300/80 flex-shrink-0">
              <div class="flex items-center gap-3">
                <span class="text-sm text-base-content/60 font-medium">${rows.length} rows</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="badge badge-ghost">
                  ${selectedModels.length} model${selectedModels.length !== 1 ? 's' : ''}
                </span>
              </div>
            </div>

            <!-- Table with horizontal and vertical scroll -->
            <div class="overflow-x-auto overflow-y-auto rounded-lg border border-base-300/50 flex-1 min-h-0">
              <table class="table-luxe table-sm" id="results-table">
                <thead class="bg-base-200/80 sticky top-0 z-20">
                  <tr>
                    <th class="w-16 sticky left-0 z-30 bg-base-200/90 hover:bg-base-300">#</th>
                    ${headers
                      .map(
                        (header: string, index: number) => `
                      <th class="sticky z-10 bg-base-200/90 hover:bg-base-300" style="left: calc(4rem + ${index * 12}rem)">
                        <div class="flex items-center gap-2">
                          <span>${header}</span>
                        </div>
                      </th>
                    `
                      )
                      .join('')}
                    ${selectedModels
                      .map(
                        (modelId: string) => `
                      <th class="min-w-[200px] max-w-[300px]">
                        <div class="flex items-center gap-2">
                          <span>Output</span>
                          <span class="badge badge-sm badge-neutral">${modelId}</span>
                        </div>
                      </th>
                    `
                      )
                      .join('')}
                  </tr>
                </thead>
                <tbody id="results-body">
                  ${rows
                    .map(
                      (row: {
                        index: number;
                        data: Record<string, unknown>;
                        results: Record<
                          string,
                          {
                            output_text?: string;
                            status: string;
                            error_message?: string;
                            duration_ms?: number;
                          }
                        >;
                      }) => `
                    <tr class="hover" data-row-index="${row.index}">
                      <td class="sticky left-0 z-10 bg-base-100 tabular-nums text-base-content/60">
                        ${row.index + 1}
                      </td>
                      ${headers
                        .map((header: string, cellIndex: number) => {
                          const value = String(row.data[header] ?? '');
                          return `
                          <td class="sticky z-10 bg-base-100 max-w-[12rem]" style="left: calc(4rem + ${cellIndex * 12}rem)">
                            <div class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto" title="${value}">
                              ${value || '<span class="opacity-30">-</span>'}
                            </div>
                          </td>
                        `;
                        })
                        .join('')}
                      ${selectedModels
                        .map((modelId: string) => {
                          const result = row.results[modelId];
                          let cellContent = '';

                          if (result?.status === 'completed') {
                            cellContent = `
                            <div class="text-sm whitespace-pre-wrap break-words max-h-20 overflow-y-auto" title="${result.output_text || ''}">
                              ${result.output_text || '<span class="opacity-30 italic">No output</span>'}
                            </div>
                          `;
                          } else if (result?.status === 'failed') {
                            cellContent = `
                            <div class="flex items-center gap-2 text-error">
                              <span class="text-xs" title="${result.error_message}">Failed</span>
                            </div>
                          `;
                          } else if (result?.status === 'pending') {
                            cellContent = `
                            <div class="flex items-center gap-2 text-warning">
                              <span class="loading loading-spinner loading-xs"></span>
                              <span class="text-xs">Pending</span>
                            </div>
                          `;
                          } else {
                            cellContent = `
                            <div class="flex items-center gap-2 text-base-content/40">
                              <span class="text-xs italic">Not started</span>
                            </div>
                          `;
                          }

                          return `
                          <td class="min-w-[200px] max-w-[300px]" data-model-id="${modelId}">
                            ${cellContent}
                          </td>
                        `;
                        })
                        .join('')}
                    </tr>
                  `
                    )
                    .join('')}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      `;

      // Create container and insert HTML
      const resultsContainer = document.createElement('div');
      resultsContainer.innerHTML = tableHTML;
      stepResults.appendChild(resultsContainer.firstElementChild!);
    } catch (error) {
      addToast(
        `Failed to load results: ${error instanceof Error ? error.message : 'Unknown error'}`,
        'error'
      );
      if (resultsPlaceholder) {
        resultsPlaceholder.classList.remove('hidden');
        resultsPlaceholder.innerHTML = `
          <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-error mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-lg font-semibold mb-2">Error Loading Results</h3>
            <p class="text-sm text-base-content/60">Please try again or start a new evaluation.</p>
          </div>
        `;
      }
    }
  };

  /**
   * Handle row click to show details
   */
  const handleRowClick = (event: Event) => {
    const target = event.target as HTMLElement;
    const row = target.closest('tr[data-row-index]');
    if (!row || !state.run) return;

    const rowIndex = parseInt(row.getAttribute('data-row-index') || '-1');
    if (rowIndex < 0) return;

    // Get the model_id from the clicked cell
    const cell = target.closest('td[data-model-id]');
    const modelId = cell?.getAttribute('data-model-id');

    if (!modelId) {
      addToast('Click on a model output cell to view details', 'info');
      return;
    }

    // Find the result for this row and model
    fetch(`/api/bulk/results?run_id=${state.runId}`)
      .then((res) => res.json())
      .then((data) => {
        // API returns { rows: [{ index, data, results }], run: {...}, ... }
        const row = data.rows?.[rowIndex];
        if (!row) return;

        const result = row.results[modelId];
        if (!result) return;

        // Convert result to RowResult format expected by DetailDrawer
        // Use run data for fields not included in the response
        const rowResult: RowResult = {
          id: `${data.run.id}-${rowIndex}-${modelId}`, // synthetic ID
          run_id: data.run.id,
          original_row_index: rowIndex,
          model_id: modelId,
          prompt_used: data.run.system_prompt || '',
          output_text: result.output_text,
          status: result.status,
          error_message: result.error_message,
          duration_ms: result.duration_ms,
          created_at: data.run.created_at || '',
        };

        // Call the global function exposed by DetailDrawer
        if (window.showBulkRowDetails) {
          window.showBulkRowDetails(rowResult, row.data as Record<string, string>);
        }
      })
      .catch(() => {
        addToast('Failed to load row details', 'error');
      });
  };

  /**
   * Setup event listeners with cleanup support
   */
  const setupEventListeners = () => {
    // Upload zone events
    const uploadHandler = (event: Event): void => {
      handleUploadSuccess(event as CustomEvent);
    };
    document.addEventListener('bulk-upload-success', uploadHandler);

    // Config panel events
    const configHandler = (event: Event): void => {
      handleConfigSubmit(event as CustomEvent);
    };
    document.addEventListener('bulk-config-submit', configHandler);

    // Row click events - store reference for cleanup
    stepResults?.addEventListener('click', handleRowClick);
    const rowClickHandler = handleRowClick;

    // New evaluation button
    newEvalBtn?.addEventListener('click', resetEvaluation);

    // Cancel evaluation button
    cancelEvalBtn?.addEventListener('click', () => {
      stopPolling();
      if (statusBar) {
        statusBar.classList.add('hidden');
      }
      addToast('Evaluation cancelled', 'info');
    });

    // Cleanup on page unload - remove event listeners
    const cleanupHandler = () => {
      stopPolling();
      document.removeEventListener('bulk-upload-success', uploadHandler);
      document.removeEventListener('bulk-config-submit', configHandler);
      stepResults?.removeEventListener('click', rowClickHandler);
    };
    window.addEventListener('beforeunload', cleanupHandler);
  };

  /**
   * Restore previous evaluation state if exists
   */
  const restoreState = async () => {
    if (state.runId && state.step === 'results') {
      // We have a completed or in-progress run
      if (resultsPlaceholder) {
        resultsPlaceholder.classList.remove('hidden');
      }

      try {
        // Check if run is still running
        const statusResponse = await fetch(`/api/bulk/status?run_id=${state.runId}`);
        if (statusResponse.ok) {
          const statusData = await statusResponse.json();

          if (statusData.is_running) {
            // Resume polling
            startPolling();
          } else {
            // Load completed results
            loadResults();
          }
        }
      } catch (error) {
        console.error('Error restoring state:', error);
        // Reset to upload state on error
        resetEvaluation();
      }
    }
  };

  // Initialize
  updateStepUI();
  setupEventListeners();
  restoreState();
</script>
