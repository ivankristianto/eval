---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import PersonaCard from '../components/PersonaCard.astro';
import { listPersonas } from '@lib/db/persona-db';
import type { Persona, PersonaStatus } from '@src-types/training';

// Fetch personas directly from DB
const url = Astro.url;
const statusFilter = url.searchParams.get('status') as PersonaStatus | null;

let personas: Persona[] = [];
let error: string | null = null;

try {
  // Use undefined if statusFilter is null, to match listPersonas signature
  personas = listPersonas(statusFilter || undefined);
} catch (e) {
  console.error('Error fetching personas:', e);
  error = 'Failed to load personas';
}

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Personas' }];

// Icon for empty state
const personaIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
</svg>`;
---

<Layout title="Personas - Eval AI">
  <Breadcrumbs items={breadcrumbItems} />

  <div class="flex items-center justify-between mb-12 animate-reveal">
    <div class="accent-line">
      <h1
        class="text-5xl md:text-6xl font-display font-semibold tracking-tight mb-4 text-gradient-gold"
      >
        Personas
      </h1>
      <p class="mt-3 text-base-content/60 text-lg">
        Manage your LLM-as-Judge personas and training configurations.
      </p>
    </div>

    <button class="btn btn-primary btn-lg" id="create-persona-btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"
        ></path>
      </svg>
      Create New Persona
    </button>
  </div>

  <!-- Filter Bar -->
  <div class="card bg-base-200 shadow-xl mb-8 animate-reveal delay-100">
    <div class="card-body p-6">
      <div class="flex items-center gap-4">
        <label class="label">
          <span class="label-text font-semibold">Filter by status:</span>
        </label>
        <select class="select select-bordered w-full max-w-xs" id="status-filter">
          <option value="">All Statuses</option>
          <option value="draft" selected={statusFilter === 'draft'}>Draft</option>
          <option value="training" selected={statusFilter === 'training'}>Training</option>
          <option value="trained" selected={statusFilter === 'trained'}>Trained</option>
          <option value="incomplete" selected={statusFilter === 'incomplete'}>Incomplete</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Personas Grid -->
  {
    error ? (
      <div class="alert alert-error">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="stroke-current shrink-0 h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>{error}</span>
      </div>
    ) : personas.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 animate-reveal delay-200">
        {personas.map((persona) => (
          <PersonaCard persona={persona} />
        ))}
      </div>
    ) : (
      <div class="card bg-base-200 shadow-xl animate-reveal delay-200">
        <div class="p-16">
          <EmptyState
            title="No personas found"
            description={
              statusFilter
                ? `No personas with status "${statusFilter}". Try changing the filter.`
                : 'Create your first persona to start training LLM judges.'
            }
            icon={personaIcon}
            action={{ label: 'Create New Persona', href: '/personas/create' }}
          />
        </div>
      </div>
    )
  }
</Layout>

<script>
  import { addToast } from '@lib/ui/toastStore';

  /**
   * Handles navigation to the persona creation page.
   */
  document.getElementById('create-persona-btn')?.addEventListener('click', () => {
    window.location.href = '/personas/create';
  });

  /**
   * Handles status filter changes by updating the URL query parameters.
   */
  document.getElementById('status-filter')?.addEventListener('change', (e) => {
    const select = e.target as HTMLSelectElement;
    const status = select.value;

    const url = new URL(window.location.href);
    if (status) {
      url.searchParams.set('status', status);
    } else {
      url.searchParams.delete('status');
    }

    window.location.href = url.toString();
  });

  /**
   * Initializes delete buttons for each persona card.
   * Prompts for confirmation before proceeding with deletion.
   */
  document.querySelectorAll('.delete-persona-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.target as HTMLButtonElement;
      const personaId = target.dataset.personaId;

      if (!personaId) return;

      if (!confirm('Are you sure you want to delete this persona? This action cannot be undone.')) {
        return;
      }

      try {
        const response = await fetch(`/api/personas/${personaId}`, {
          method: 'DELETE',
        });

        if (response.ok) {
          addToast('Persona deleted successfully', 'success');
          window.location.reload();
        } else {
          const data = await response.json();
          addToast(data.message || 'Failed to delete persona', 'error');
        }
      } catch (error) {
        console.error('Delete error:', error);
        addToast('Failed to delete persona', 'error');
      }
    });
  });

  /**
   * Initializes "Start Training" buttons for each persona card.
   * Calls the training start API and redirects to the metrics dashboard on success.
   */
  document.querySelectorAll('.start-training-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const personaId = button.dataset.personaId;

      if (!personaId) return;

      button.disabled = true;
      button.classList.add('loading');

      try {
        const response = await fetch(`/api/personas/${personaId}/training/start`, {
          method: 'POST',
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || 'Failed to start training');
        }

        // Redirect to metrics/training page
        window.location.href = `/personas/${personaId}/metrics`;
      } catch (error) {
        console.error('Failed to start training:', error);
        addToast(
          `Failed to start training: ${error instanceof Error ? error.message : 'Unknown error'}`,
          'error'
        );
        button.disabled = false;
        button.classList.remove('loading');
      }
    });
  });
</script>
